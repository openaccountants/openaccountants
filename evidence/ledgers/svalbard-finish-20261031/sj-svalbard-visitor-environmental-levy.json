{
  "slug": "sj-svalbard-visitor-environmental-levy",
  "guide_sha256": "d30213477809875245d0fc31743bd026396369df510bce840eef1a7746c4c8d7",
  "legal_rows": [
    {
      "id": "R001",
      "section": "Who this applies to",
      "rule": "Territory, visitor levy and Fund",
      "act_article": "Regulation §§1–2",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 93,
      "original_quote": "Forskriften gjelder for reisende til landområder og indre farvann på Svalbard."
    },
    {
      "id": "R002",
      "section": "Who this applies to",
      "rule": "Resident levy prohibition",
      "act_article": "Environmental Protection Act §78",
      "read_date": "2026-10-31",
      "source": "environment-law",
      "url": "https://lovdata.no/dokument/NL/lov/2001-06-15-79/KAPITTEL_7",
      "reader_line": 759,
      "original_quote": "Kongen kan gi forskrift om at den som besøker Svalbard, skal betale en miljøavgift. Miljøavgiften kan ikke pålegges fastboende. Miljøavgiften går inn i Svalbards miljøvernfond."
    },
    {
      "id": "R003",
      "section": "Who this applies to",
      "rule": "Resident exemption/refund",
      "act_article": "Regulation §4",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 104,
      "original_quote": "Fastboende på Svalbard er unntatt fra plikten til å betale avgift etter forskriften her, jf. svalbardmiljøloven § 3 første ledd bokstav i, og kan kreve avgiften refundert av Svalbard miljøvernfond."
    },
    {
      "id": "R004",
      "section": "Who this applies to",
      "rule": "Population register identifies eligible residents",
      "act_article": "Fund procedure, introductory paragraph",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 18,
      "original_quote": "Alle reisende til Svalbard må betale en miljøavgift på 150 kroner som automatisk inngår i prisen ved kjøp av fly- og cruise billetter. Fastboende på Svalbard må også betale avgiften, men de kan få denne refundert. Som fastboende regnes alle som er innført i befolkningsregisteret for Svalbard."
    },
    {
      "id": "R005",
      "section": "Rates, bands and thresholds",
      "rule": "NOK150 ticket levy",
      "act_article": "Regulation §3 first paragraph",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 97,
      "original_quote": "Ved kjøp av billett for reise til Svalbard innkreves det fra reisearrangør et miljøavgift på kr 150,-."
    },
    {
      "id": "R006",
      "section": "Rates, bands and thresholds",
      "rule": "Air collection on departure ticket and incorporated exceptions",
      "act_article": "Regulation §3 second paragraph",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 98,
      "original_quote": "For reisende med fly vil et miljøavgift på kr 150 innkreves ved kjøp av billett for reise fra Svalbard. Unntak fra avgiftsplikt som beskrevet i forskrift om avgifter vedrørende statens luftfartsanlegg- og tjenester gitt i medhold av luftfartsloven § 7-26 (takstregulativet) § 1-4 og § 3-1 til § 3-6 vil gjelde tilsvarende for avgiftplikt for flypassasjerer etter forskriften her."
    },
    {
      "id": "R007",
      "section": "Rates, bands and thresholds",
      "rule": "Private boat NOK150 and notification",
      "act_article": "Regulation §3 third paragraph",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 99,
      "original_quote": "Individuelle reisende med egen båt som har meldeplikt etter turistforskriftens § 7 skal betale miljøavgift på kr 150,- i forbindelse med melding til Sysselmesteren."
    },
    {
      "id": "R008",
      "section": "Rates, bands and thresholds",
      "rule": "Three-year claim clock",
      "act_article": "Fund procedure, Tidsfrist",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 26,
      "original_quote": "Refusjonskrav må være fremmet innen tre år etter faktisk reisedato."
    },
    {
      "id": "R009",
      "section": "Rates, bands and thresholds",
      "rule": "Special-reasons dispensation",
      "act_article": "Regulation §5",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 109,
      "original_quote": "Klima- og miljødepartementet kan dispensere fra forskriften når særlige grunner taler for det."
    },
    {
      "id": "R010",
      "section": "The base",
      "rule": "Air/cruise ticket collection and private boat self-payment",
      "act_article": "Governor travel guidance, Miljøavgift",
      "read_date": "2026-10-31",
      "source": "governor-travel",
      "url": "https://www.sysselmesteren.no/ferdsel-pa-svalbard/",
      "reader_line": 85,
      "original_quote": "Avgiften legges automatisk til billettprisene av fly- og cruiseselskap. Tilreisende i private båter må selv sørge for å betale miljøavgiften."
    },
    {
      "id": "R011",
      "section": "The base",
      "rule": "Private boat payment official account publication",
      "act_article": "Governor Fund page, Betalingsinformasjon",
      "read_date": "2026-10-31",
      "source": "environment-fund",
      "url": "https://www.sysselmesteren.no/svalbards-miljovernfond/",
      "reader_line": 42,
      "original_quote": "Avgiften legges automatisk til billettprisene av fly- og cruiseselskap. Tilreisende i private båter må betale miljøavgiften (150 NOK, - pr. pers) til følgende kontonummer:"
    },
    {
      "id": "R012",
      "section": "The base",
      "rule": "Completed outward-travel evidence",
      "act_article": "Fund procedure, Privatpersoner step1",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 21,
      "original_quote": "1. Ta vare på reisedokumentasjon for nedreisen. Som reisedokumentasjon godtas boardingpass eller annen bekreftelse på gjennomført reise fra Svalbard."
    },
    {
      "id": "R013",
      "section": "The base",
      "rule": "Personal form excludes employer/NAV/Patient Travel paid trips",
      "act_article": "Fund procedure, Privatpersoner step2",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 22,
      "original_quote": "2. Fyll ut elektronisk refusjonsskjema som finnes på skjemasiden til sysselmesteren, www.sysselmesteren.no Refusjon etter dette skjemaet kan ikke kreves for reiser betalt av arbeidsgiver, NAV, Pasientreiser eller lignende."
    },
    {
      "id": "R014",
      "section": "The base",
      "rule": "Employer agreement and separate form",
      "act_article": "Fund procedure, Arbeidsgivere",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 24,
      "original_quote": "Det kan inngås skriftlige avtaler om refusjon med arbeidsgiverne på Svalbard. Arbeidsgiverne skal sende inn et eget skjema om refusjon for arbeidsgivere til skattekontoret. Skjema finnes på skjemasiden til sysselmesteren, www.sysselmesteren.no"
    },
    {
      "id": "R015",
      "section": "Deadlines and filing",
      "rule": "Tax office administers refund",
      "act_article": "Fund procedure, introductory paragraph",
      "read_date": "2026-10-31",
      "source": "fund-refund",
      "url": "https://www.miljovernfondet.no/refusjon-av-avgift/",
      "reader_line": 19,
      "original_quote": "Svalbard skattekontor står for det praktiske arbeidet med refusjon til fastboende. Slik går du frem for å få refundert avgiften:"
    },
    {
      "id": "R016",
      "section": "Penalties and interest",
      "rule": "Coercive fine through Act96",
      "act_article": "Regulation §6",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 114,
      "original_quote": "For å sikre at bestemmelsene i forskriften eller vedtak i medhold av forskriften blir gjennomført, kan Sysselmesteren fastsette tvangsmulkt i medhold av svalbardmiljøloven § 96."
    },
    {
      "id": "R017",
      "section": "Penalties and interest",
      "rule": "Intentional/negligent infringement fines",
      "act_article": "Regulation §7",
      "read_date": "2026-10-31",
      "source": "environment-fee",
      "url": "https://lovdata.no/dokument/SF/forskrift/2006-12-22-1532",
      "reader_line": 119,
      "original_quote": "Den som forsettlig eller uaktsomt overtrer bestemmelser fastsatt i eller i medhold av denne forskrift, straffes med bøter."
    },
    {
      "id": "R018",
      "section": "Deadlines and filing",
      "rule": "Published form title and initial access choices only; no post-access fields verified",
      "act_article": "Official refund form initial screen, browser observation",
      "read_date": "2026-10-31",
      "source": "refund-form-observation.txt",
      "url": "https://skjema.no/sysselmesteren/ref_miljoavgift",
      "reader_line": 4,
      "original_quote": "Refusjon miljøavgift for fastboende på Svalbard; Logg inn med ID-porten; Logg inn med brukernavn og passord; Åpne skjema uten innlogging",
      "quote_kind": "separately displayed exact UI labels, not a contiguous statutory sentence"
    }
  ],
