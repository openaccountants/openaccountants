            <form class="lista formBOE" method="GET" action="/buscar/act.php#a1">
              <input type="hidden" name="id" value="BOE-A-2014-6925">
              <input type="hidden" name="b"  value="12">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab1220231230" value="20231230" checked="checked"/>
                  <label for="lab1220231230" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 30/12/2023, en vigor a partir del 01/01/2024.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab1220151230" value="20151230"/>
                  <label for="lab1220151230" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 30/12/2015, en vigor a partir del 31/12/2015.</label>
                </p>
                <p>
