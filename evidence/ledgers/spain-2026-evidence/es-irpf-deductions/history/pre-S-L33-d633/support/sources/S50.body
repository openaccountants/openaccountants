                  <input type="radio" name="p" onclick="this.form.submit()" id="lab8520231125" value="20231125" checked="checked"/>
                  <label for="lab8520231125" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 25/11/2023, en vigor a partir del 26/11/2023.</strong></label>
