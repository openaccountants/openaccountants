              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab720260810" value="20260810" checked="checked"/>
                  <label for="lab720260810" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 10/08/2026, en vigor a partir del 11/08/2026.</strong></label>
