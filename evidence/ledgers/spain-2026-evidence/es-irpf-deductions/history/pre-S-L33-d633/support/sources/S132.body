        <p class="cabeza_tabla">euros</p>
      </th>
      <th>
        <p class="cabeza_tabla">Resto base liquidable</p>
        <p class="cabeza_tabla">hasta euros</p>
      </th>
      <th>
        <p class="cabeza_tabla">Tipo aplicable</p>
        <p class="cabeza_tabla">porcentaje</p>
      </th>
    </tr>
  </thead>
  <colgroup>
    <col width="23%"/>
    <col width="23%"/>
    <col width="24%"/>
    <col width="23%"/>
