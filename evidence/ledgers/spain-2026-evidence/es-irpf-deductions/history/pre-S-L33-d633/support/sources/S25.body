                  <input type="radio" name="p" onclick="this.form.submit()" id="lab12020221230" value="20221230" checked="checked"/>
                  <label for="lab12020221230" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 30/12/2022, en vigor a partir del 01/01/2023.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab12020211026" value="20211026"/>
                  <label for="lab12020211026" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 26/10/2021, en vigor a partir del 01/01/2022.</label>
                </p>
              </fieldset>
