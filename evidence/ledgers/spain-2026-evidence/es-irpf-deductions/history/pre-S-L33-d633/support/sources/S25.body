                  <input type="radio" name="p" onclick="this.form.submit()" id="lab10720211026" value="20211026"/>
                  <label for="lab10720211026" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 26/10/2021, en vigor a partir del 01/01/2022.</label>
