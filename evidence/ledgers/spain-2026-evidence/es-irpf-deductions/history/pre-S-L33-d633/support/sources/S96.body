			djrae_t  = "M";
		} else if(window.matchMedia("(min-width:670px) and (max-width:1050px)").matches) {
			carga = true;
			djrae_t  = "T";
		}

		if(carga){
			jQuery("#container_dj").djraeWidget({modo: djrae_t});
		}
	}
</script>
