                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab10220221129" value="20221129"/>
                  <label for="lab10220221129" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 29/11/2022, en vigor a partir del 01/12/2022.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab10220180523" value="20180523"/>
                  <label for="lab10220180523" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 23/05/2018, en vigor a partir del 24/05/2018.</label>
                </p>
              </fieldset>
