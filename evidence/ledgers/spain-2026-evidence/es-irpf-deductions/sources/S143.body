              <input type="hidden" name="id" value="BOE-A-1998-8202">
              <input type="hidden" name="b"  value="10">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab1020131227" value="20131227"/>
                  <label for="lab1020131227" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">&Uacute;ltima actualizaci&oacute;n, publicada el 27/12/2013, en vigor a partir del 01/01/2014.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab1020021231" value="20021231" checked="checked"/>
