                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab3120260810" value="20260810"/>
                  <label for="lab3120260810" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">&Uacute;ltima actualizaci&oacute;n, publicada el 10/08/2026, en vigor a partir del 11/08/2026.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab3120250531" value="20250531"/>
