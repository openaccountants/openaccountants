conselleriadefacenda.gal/sprite/html/icons/_sprite.png'); background-position: 50% -112px; background-repeat: no-repeat; height: 16px; width: 16px;" /> <span class="taglib-text hide-accessible">Notas de prensa</span> </span> <span class="portlet-title-text">Notas de prensa</span> </h2> <menu class="portlet-topper-toolbar" id="portlet-topper-toolbar_101_INSTANCE_WMAKK58kdtGt" type="toolbar"> </menu> </header> <div class="portlet-content"> <div class=" portlet-content-container" style=""> <div class="portlet-body"> <div> <div class="taglib-header "> <span class="header-back-to"> <a class="icon-circle-arrow-left previous-level" href="https&#x3a;&#x2f;&#x2f;www&#x2e;conselleriadefacenda&#x2e;gal&#x2f;es_ES&#x2f;sala-prensa&#x2f;notas-de-prensa&#x3f;p_p_id&#x3d;101_INSTANCE_WMAKK58kdtGt&#x26;p_p_lifecycle&#x3d;0&#x26;p_p_state&#x3d;normal&#x26;p_p_mode&#x3d;view&#x26;p_p_col_id&#x3d;column-1&#x26;p_p_col_count&#x3d;1&#x26;_101_INSTANCE_WMAKK58kdtGt_struts_action&#x3d;&#x25;2Fasset_publisher&#x25;2Fview" id="_101_INSTANCE_WMAKK58kdtGt_TabsBack" title="Atrás"> <span class="helper-hidden-accessible"> Atrás </span> </a> </span> <h3 class="header-title"> <span> Hoy entran en vigor los Presupuestos de Galicia para este año 2024 </span> </h3> </div> <div class="asset-full-content default-asset-publisher show-asset-title"> <div class="asset-content" id="_101_INSTANCE_WMAKK58kdtGt_20981919"> <div class="journal-content-article"> <script src="/interiores-theme/js/rs_html5/ReadSpeaker.js?pids=embhl" type="text/javascript"></script> <article> <div id="audioContido"> <h1 class="titulo-oculto">Hoy entran en vigor los Presupuestos de Galicia para este año 2024</h1> <div id='xp1' class="rs_playerGr" style="display: none;"></div> <div class="readspeaker"> <img class="imaxe-altavoz rs_skip" style="width:32px height:32px" src="/interiores-theme/js/rs_html5/img/icon_64px.png" alt="imaxe altavoz"> <div id="readspeaker_button1" class="rs_skip rsbtn rs_preserve"> <a class="rsbtn_play" accesskey="L" title="Escuche esta página usando ReadSpeaker" href="http://app.eu.readspeaker.com/cgi-bin/rsent?customerid=5356&amp;lang=es_ES&amp;readid=audioContido&amp;url=$portalUtil.getPortalURL($themeDisplay)$absoluteUrl"> <span class="rsbtn_left rsimg rspart"> <span class="rsbtn_text"> <span> Escuchar </span> </span> </span> <span class="rsbtn_right rsimg rsplay rspart"></span> </a> </div> </div> <p><ul> <li style='list-style-position: inside;'><em><strong>Las cuentas de este año incluyen 13.257 millones de euros</strong></em></li> </ul> <p style="text-align: justify;"><strong>Santiago de Compostela, 1 de enero 2024.-</strong> Hoy entran en vigor los presupuestos de la Comunidad Autónoma de Galicia para este año 2024 que ascienden a 13.257M€.</p> <p style="text-align: justify;">Los presupuestos incluyen 9.774 millones de euros para gasto social y fomento del empleo y más de 2.800 millones para inversiones. En materia de política fiscal, consolidan las rebajas fiscales existentes e incluyen nuevos incentivos fiscales.</p> <p style="text-align: justify;">En este marco, en la declaración del IRPF del año 2023 que se realiza en el 2024, las familias con dos hijos podrán deducir 250€, deducción que hasta ahora tenían las familias numerosas de categoría general. De forma paralela, las familias numerosas tendrán duplicada esta cantidad, y pasarán a deducir 500€. También se incrementa esta deducción en otros 250 euros por cada hijo a mayores.</p> <p style="text-align: justify;">Además, hoy también entran en vigor las bajadas en el Impuesto de Transmisiones Patrimoniales (ITP): la rebaja del tipo general para la compra de bienes inmuebles usados (que pasa del 9% al 8%); la bajada del ITP para la compra de vehículos usados (del 8 al 3%); la bajada para la adquisición de inmuebles que vayan a ser objeto de inmediata rehabilitación y que tengan al finalizar el uso de vivienda; y la eliminación del impuesto para las compras de vehículos calificados de ‘bajas emisiones' y vehículos de movilidad personal.</p> <p style="text-align: justify;"><br /> &nbsp;</p> </p> </div> <script>jQuery11(document).ready(function(){var a=1;while(jQuery11(document).find("#player"+a).length!=0){jQuery11("#player"+a).flowplayer({ratio:19/29.5,key:"$208401138807205",splash:false,embed:{skin:"/interiores-theme/js/flowplayer6/skin/minimalist.css"}});a++}});</script> </article> </div> <div class="taglib-social-bookmarks" id="ykmt_column1_0_socialBookmarks"> <ul class="unstyled"> <li class="taglib-social-bookmark-twitter"> <a class="twitter-share-button" data-count="horizontal" data-lang="Spanish" data-text="Hoy&#x20;entran&#x20;en&#x20;vigor&#x20;los&#x20;Presupuestos&#x20;de&#x20;Galicia&#x20;para&#x20;este&#x20;año&#x20;2024" data-url="https://www.conselleriadefacenda.gal/sala-prensa/notas-de-prensa/-/asset_publisher/WMAKK58kdtGt/content/hoxe-entran-en-vigor-os-orzamentos-de-galicia-para-este-ano-2024?_101_INSTANCE_WMAKK58kdtGt_viewMode=view" href="http://twitter.com/share">Tweet</a> </li> <li class="taglib-social-bookmark-facebook"> <div id="fb-root"></div> <div class="fb-like" data-font="" data-height="20" data-href="https://www.conselleriadefacenda.gal/sala-prensa/notas-de-prensa/-/asset_publisher/WMAKK58kdtGt/content/hoxe-entran-en-vigor-os-orzamentos-de-galicia-para-este-ano-2024?_101_INSTANCE_WMAKK58kdtGt_viewMode=view" data-layout="button_count" data-send="false" data-show_faces="true" > </div> </li> <li class="taglib-social-bookmark-plusone"> <g:plusone count="true" href="https://www.conselleriadefacenda.gal/sala-prensa/notas-de-prensa/-/asset_publisher/WMAKK58kdtGt/content/hoxe-entran-en-vigor-os-orzamentos-de-galicia-para-este-ano-2024?_101_INSTANCE_WMAKK58kdtGt_viewMode=view" size="medium" > </g:plusone> </li> </ul> </div> <br /> </div> <div class="asset-metadata"> </div> </div> </div> </div> </div> </div> </section> </div> </div> </div> </div> </div> <form action="#" id="hrefFm" method="post" name="hrefFm"> <span></span> </form> </div> </div> <footer clas