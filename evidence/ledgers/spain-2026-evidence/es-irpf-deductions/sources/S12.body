                  <input type="radio" name="p" onclick="this.form.submit()" id="lab3520070331" value="20070331" checked="checked"/>
                  <label for="lab3520070331" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>Texto original, publicado el 31/03/2007, en vigor a partir del 01/04/2007.</strong></label>
                </p>
              </fieldset>
