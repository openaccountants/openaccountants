</div><!-- Modal Searchbox --><!-- js tags --><script src="/++theme++plone-tema-diputacio-2/styles/build/plonetheme.diputacio2.min.js"></script><!-- js tags end --><script src="/++theme++plone-tema-diputacio-2/js/custom.js"></script><script>
      $(function () {
        $('a.swipebox:not([data-type="Folder"])').swipebox();

        /* Funcio per veure si element existeix */
        function waitForElm(selector) {
            return new Promise(resolve => {
                if (document.querySelector(selector)) {
                    return resolve(document.querySelector(selector));
                }

                const observer = new MutationObserver(mutations => {
                    if (document.querySelector(selector)) {
                        resolve(document.querySelector(selector));
                        observer.disconnect();
                    }
                });

                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            });
        }


        $( document ).ready(function() {
          if ($('.affix-fixer').length > 0) {
            $('.affix-fixer').height( $('#main-navigation').height() );
          }

          // Afegir contingut al llistat de resultats de la cerca per a complir estandard HTML
          waitForElm('.livesearch-results').then((elm) => { 
              $(elm).append('<li>Sense resultats de la cerca</li>');
          });
          // waitForElm('#google_translate_element').then((elm) => {
          //     $('#googTransID.sr-only').remove();
          // });
          waitForElm('#goog-gt-votingHiddenPane').then((elm) => {
              $('#goog-gt-votingHiddenPane').remove();
          });
          
          if ($('#location-map').length > 0) {
            waitForElm('#location-map .leaflet-marker-icon').then((elm) => {
              $( ".leaflet-marker-icon" ).each(function( index ) {
                strTitle = $(this).attr('title');
                $(this).attr('alt', 'localitzacio: ' + strTitle);
              });
            });
          }
          
        });
      })
    </script><script>
    let policyTitle = "Pol&#237;tica de cookies"
