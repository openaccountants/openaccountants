                                             <a class="collapsed" data-toggle="collapse"
                                               href="#bloc17">Concessions administratives, actes i negocis equiparables (codis CEB, CEO, CES i ANE)</a>
										</p>
									</div>
									
                                    
									<div id="bloc17" class="panel-collapse collapsible collapse">
										
















	

	
	
	

	
	
	

	
	
	<div class="col-xs-12 columna_esquerra">
		
		
			<div class="cos_bloc basic_text_peq pd-15 link-dotted">
				<p>Tipus impositiu: 4 %</p>
<ul>
<li>Concessions administratives: explotació de béns (codi CEB)</li>
<li>Concessions administratives: execució d’obres (codi CEO)</li>
<li>Concessions administratives: explotació de serveis (codi CES)</li>
<li>Concessions administratives: actes i negocis equiparables (codi ANE)</li>
</ul>
			</div>
		
		
                    
                
	</div>

	
	
	
	
	
	


