                                             <a class="collapsed" data-toggle="collapse"
                                               href="#bloc18">Drets reals de garantia, pensions, fiances, préstecs i obligacions i condicions resolutòries  (codis DRG i PFC)</a>
										</p>
									</div>
									
                                    
									<div id="bloc18" class="panel-collapse collapsible collapse">
										
















	

	
	
	

	
	
	

	
	
	<div class="col-xs-12 columna_esquerra">
		
		
			<div class="cos_bloc basic_text_peq pd-15 link-dotted">
				<p>Tipus impositiu: 1 %</p>
<ul>
<li>Drets reals de garantia, condicions resolutòries i préstecs (codi DRG)</li>
<li>Pensions i fiances (codi PFC)</li>
</ul>
			</div>
		
		
                    
                
	</div>

	
	
	
	
	
	


