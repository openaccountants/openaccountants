                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab420140324" value="20140324"/>
                  <label for="lab420140324" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 24/03/2014, en vigor a partir del 25/03/2014.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab420131126" value="20131126"/>
                  <label for="lab420131126" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 26/11/2013, en vigor a partir del 01/01/2014.</label>
                </p>
              </fieldset>
            </form>
          </div>
