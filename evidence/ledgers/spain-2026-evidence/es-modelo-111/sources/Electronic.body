                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab820141010" value="20141010" checked="checked"/>
                  <label for="lab820141010" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 10/10/2014, en vigor a partir del 11/10/2014.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab820131126" value="20131126"/>
                  <label for="lab820131126" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 26/11/2013, en vigor a partir del 01/01/2014.</label>
                </p>
              </fieldset>
