				var auxUrl = $(location).attr("href");
if (auxUrl.indexOf("web/guest/")>=0){
	auxUrl = auxUrl.replace("web/guest/", "");
	window.location.href=auxUrl;
}

const idioma = document.documentElement.lang;

	/*20250408 - Solución temporal.
	Se solicita cambios en los mensajes de  los popup de suscripción a tramites y búsquedas,
	 al ser época de renta no se puede desplegar por lo que se resuelve 
	añadiendo este javascript a la página. 
	Debe realizarse el despliegue correspondiente cuando se pueda
	*/
if (idioma === 'es-ES') {
	$("#suscribirseModalLabel").text("Recibir avisos informativos");
    $("#_es_navarra_tramites_visor_web_portlet_TramitesVisorWebPortlet_suscribirseModal .modal-body p").replaceWith("<p>Introduce tu correo electrónico para recibir un aviso informativo cuando haya novedades en el trámite. <br/> Los avisos que recibirás son puramente informativos. No sustituyen a las notificaciones ni a las publicaciones oficiales.</p>");
} else if (idioma === 'eu-ES') {
	$("#suscribirseModalLabel").text("Informazio-oharrak jasotzea");
    $("#_es_navarra_tramites_visor_web_portlet_TramitesVisorWebPortlet_suscribirseModal .modal-body p").replaceWith("<p>Idatzi zure helbide elektronikoa informazio-ohar bat jasotzeko, tramitean nobedadeak daudenean. <br/>Sistema honen bidez jasoko dituzun oharrak informatiboak baino ez dira. Ez dituzte ordezkatzen jakinarazpenak, ezta argitalpen ofizialak ere.</p>");

	/*20260415 - Solución temporal.
	Incidencia en ficha de trámite el mes no sale en euskera.
	Debido a época de renta y no ser posible desplegar, se introduce el código en el portlet pero se corrige en web con este script
	*/
	document.addEventListener('load', 
		function () {		
			var meses = {
				'January'   : 'urtarrila',
				'February'  : 'otsaila',
				'March'     : 'martxoa',
				'April'     : 'apirila',
				'May'       : 'maiatza',
				'June'      : 'ekaina',
				'July'      : 'uztaila',
				'August'    : 'abuztua',
				'September' : 'iraila',
				'October'   : 'urria',
				'November'  : 'azaroa',
				'December'  : 'abendua'
			};

			var elemento = document.getElementById(
				'_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3_lastUpdateDateText'
			);
			console.log("ELEM: "+elemento.textContent);
			if (elemento) {
				Object.keys(meses).forEach(function (mesIngles) {
					if (elemento.textContent.includes(mesIngles)) {
						elemento.textContent = elemento.textContent.replace(
							new RegExp(mesIngles, 'g'),
							meses[mesIngles]
						);
					}
				});
			} else {
				console.warn('No se encontró el elemento de fecha de última actualización.');
			}
	},3);	
}
/*20260415 - Solución temporal.
Problema por el cual se esta indexando en la descripción de la ficha de un trámite el texto de protección de datos del pop-up de suscripciones
Reproducirlo buscando en Firefox contacto beca movilidad Navarra.
*/
document.addEventListener('DOMContentLoaded', function () {
    // ── Meta description desde subTitle 
    var subTitle = document.querySelector('div.subTitle');
    if (subTitle) {
        var texto = subTitle.textContent.trim();

        var metaDescription = document.querySelector('meta[name="description"]');

        if (metaDescription) {
            metaDescription.setAttribute('content', texto);
        } else {
            var meta = document.createElement('meta');
            meta.setAttribute('name', 'description');
            meta.setAttribute('content', texto);
            document.head.appendChild(meta);
        }
    }

    // ── Ocultar modal de suscripción a buscadores y agentes IA ───
    var modal = document.getElementById('_es_navarra_tramites_visor_web_portlet_TramitesVisorWebPortlet_suscribirseModal');

    if (modal) {
        modal.setAttribute('aria-hidden', 'true');
       // modal.setAttribute('inert', ''); //Deja de funcionar el pop up de suscripcion
        modal.setAttribute('data-nosnippet', '');
    }

});
			
		// ]]>
	</script>












	

	

		

		
	


