      <div class="franja-pie">
        <p class="nombre-organismo">Agencia Estatal Bolet&iacute;n Oficial del Estado</p>
        <p class="direccion-organismo"><abbr title="Avenida">Avda.</abbr> de Manoteras, 54 - 28050 Madrid</p>
      </div>
    </div> <!-- #pie -->
