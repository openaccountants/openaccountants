              <input type="hidden" name="b"  value="64">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab6420211231" value="20211231"/>
                  <label for="lab6420211231" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">&Uacute;ltima actualizaci&oacute;n, publicada el 31/12/2021, en vigor a partir del 01/01/2022.</label>
                </p>
