	<script type="text/javascript">
		$(function() {
	
		function getParameterByName(name, url) {
			name = name.replace(/[\[\]]/g, '\\$&');
			var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
				results = regex.exec(url);
			if (!results) return null;
			if (!results[2]) return '';
			return decodeURIComponent(results[2].replace(/\+/g, ' '));
		}
	
		var iframeURL = window.location.href;
		var iframeTemCodigo = getParameterByName('tem_codigo', iframeURL.toLowerCase());
		
		//console.log('iframeURL: ', window.location.href);
		//console.log('iframeTemCodigo: ', iframeTemCodigo);
		
		$("body a:not([target='_blank'])").each(function(){
			var linkURL = $(this).attr('href');
			//console.log('linkURL: ', linkURL);
			if (linkURL && !linkURL.startsWith("#")){
				var linkTemCodigo = getParameterByName('tem_codigo',linkURL.toLowerCase())
				//console.log('linTemCodigo: ', linkTemCodigo);		
				if((!iframeTemCodigo) || (iframeTemCodigo != linkTemCodigo)){
				//if(iframeTemCodigo != linkTemCodigo){
					$(this).attr("target","_parent");
				}
			}
		});

		$('a[href^="#"]').click(function( event ) {

			event.preventDefault();
			var idLink=$(this).attr('href');
			//console.log('click');

				setTimeout(function(){
					//console.log('scroll2');
					//console.log(idLink);
					if (typeof parentIFrame != "undefined") {
						if($(idLink).length){
							parentIFrame.scrollTo(0,$(idLink).offset().top + 220)
						} else{
							parentIFrame.scrollTo(0,$('a[name="'+idLink.substring(1)+'"]').offset().top + 220)
						}
					}
				},150);

		});
		
		
		if(window.location.hash) {

			//event.preventDefault();
			var idLink=window.location.hash;
			//console.log('hash');

				setTimeout(function(){
					//console.log('scroll2');
					//console.log(idLink);
					if (typeof parentIFrame != "undefined") {
						if($(idLink).length){
							//console.log("ENTRA");
							parentIFrame.scrollTo(0,$(idLink).offset().top + 220)
						} else{
							parentIFrame.scrollTo(0,$('a[name="'+idLink.substring(1)+'"]').offset().top + 220)
						}
					}
				},450);

		}

		
		$('a[data-toggle=collapse]').click(function( event ) {

			event.preventDefault();

			//console.log('click');

			if (typeof parentIFrame != "undefined") {
				setTimeout(function(){
					//console.log('scroll');
					parentIFrame.scrollToOffset(0,-150);
				},350);
			}

		});
	});	
	</script>

