okAliCent" data-idtoc="TOC1" role="heading" aria-level="1" data-numero="1. " style="padding-left: 0px;" data-outer-width="678" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_PortadaSeccion estiloParrafoCss" data-outer-width="422" data-margin-left="0px" data-margin-right="0px" data-padding-left="10px" data-padding-right="0px" style="width: 62.24188790560472%; padding-left: 1.4749262536873156%; ">1. Norma Foral de Ejecución Presupuestaria para 2026</span></div></div><div class="estiloIberdokAliCent" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">​</div></div></div></div><div class="pageBreakSaltoSeccion" document-break="true" id="400"><div>IBRDKpagebreakIBRDK</div><div class="secciones"><div class="seccionencabezado" data-sectionref="#hsections #hsection3" id="401"></div><div class="seccionpie" data-sectionref="#fsections #fsection3" id="402"></div><div class="seccionizquierda" data-sectionref="#lsections #lsection3" id="403"></div><div class="seccionderecha" data-sectionref="#rsections #rsection3" id="404"></div><div class="seccionvisual" data-sectionref="#vsections #vsection3" id="405"></div></div></div><div data-txt-protegido="false" data-xml-type="detalleSec" data-xml-detalle="detalleSec" class="pagina detalleSec3 lienzoTamano-A4" style="background-color: rgb(255, 255, 255); display: block; float: left; width: 100%; " data-outer-width="793" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><div data-xml-type="cuerpoSec" contenteditable="true" class="cuerpoSec3" style="margin-top: 132px; margin-bottom: 94px; margin-left: 7.061790668348046%; margin-right: 7.061790668348046%; float: left; width: 85.87641866330391%; " data-outer-width="681" data-margin-left="7.061790668348046%" data-margin-right="7.061790668348046%"><div class="divuser27_35434" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="406" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 99.85315712187959%; "><div data-xml-nombre="PTO_NORMA01" data-id="eceddde0-fb5b-4d48-bfbc-1cbd85" data-txt-protegido="false" data-xml-type="marca_pa" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="contenido" class="marca_resuelta" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="presentacion" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser18_PTO_NORMA01" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="407" data-outer-width="643" data-margin-left="18px" data-margin-right="18px" data-padding-left="0px" data-padding-right="0px" style="width: 94.55882352941177%; margin-left: 2.6470588235294117%; margin-right: 2.6470588235294117%; "><span class="spanFuentes estiloIberdokNegrita tipoFuenteId_PTO_NORMA01_1766414191352" data-outer-width="643" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">20/2025 FORU ARAUA, ABENDUAREN 16KOA, ARABAKO LURRALDE HISTORIKOAREN 2026RAKO AURREKONTUA GAUZATZEARI BURUZKOA</span><span class="estiloIberdokNegrita spanFuentes tipoFuenteId_PTO_NORMA01_1762938375783" data-outer-width="643" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">&nbsp;<br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">NORMA FORAL 20/2025, DE 16 DE DICIEMBRE, DE EJECUCION DEL PRESUPUESTO DEL TERRITORIO HISTÓRICO DE ÁLAVA PARA EL AÑO 2026</span></div><div class="divuser70_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="408" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser71_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="409" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="115" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 37.828947368421055%; ">ZIOEN AZALPENA</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA01_1731326921647" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Aurrekontu hauek Arabako Lurralde Historikoko Ekonomia eta Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arauan xedatutakoa betez onesten dira, Ekonomia Itunaren 48. eta 62.b) artikuluetan xedatutakoaren babesean, Arabako Foru Aldundiak 2026rako onetsitako aurrekontu egonkortasuneko eta zor publikoko helburuen arabera, bai eta Emakumeen eta Gizonen Berdintasunerako eta Emakumeen aurkako Indarkeria Matxistarik gabeko Bizitzetarako Legearen testu bategina onartzen duen martxoaren 16ko 1/2023 Legegintzako Dekretuan ezarritako arau agindua betez ere.</span></div></div><div class="divuser72_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="410" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="167" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 54.93421052631579%; ">EXPOSICIÓN DE MOTIVOS</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><span class=" spanFuentes tipoFuenteId_PTO_NORMA01_1731326848309" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Los presentes Presupuestos se aprueban en cumplimiento de lo dispuesto en la Norma Foral 3/2023, de 25 de enero, General Presupuestaria, al amparo de lo dispuesto en los artículos 48 y 62.b) del Concierto Económico, conforme a los objetivos de estabilidad presupuestaria y deuda pública de la Diputación Foral de Álava aprobados para el ejercicio 2026, así como dando cumplimiento al mandato normativo contenido en el Decreto Legislativo 1/2023, de 16 de marzo, por el que se aprueba el texto refundido de la Ley para la Igualdad de Mujeres y Hombres y Vidas Libres de Violencia Machista contra las Mujeres.</span></div></div><div class="divuser73_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="411" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser74_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="412" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Aurrekontuak gauzatzeko foru arau honen I. tituluan jasotzen da haren funtsezko edukia: Arabako Lurralde Historikoaren sektore publikoko diru sarreren eta gastuen egoerak onestea eta haren zergei eragiten dieten eta zerga gastuen zenbatekoa kontsignatzea.</span></div></div><div class="divuser75_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="413" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Se recoge en el Título I de la presente Norma Foral de Ejecución Presupuestaria su contenido esencial, constituido por la aprobación de los estados de ingresos y gastos del sector público foral del Territorio Histórico de Álava y la consignación del importe de los gastos fiscales que afectan a sus tributos.</span></div></div></div><div class="divuser76_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="414" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser77_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="415" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA01_1731489695889" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">II. tituluak Arabako Lurralde Historikoko foru sektore publikoaren zorpetzearen eta bermeak ematearen mugak ezartzen ditu, bai eta finantza eragiketen kudeaketari buruzko arauak ere</span></div></div><div class="divuser78_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="416" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">El Título II establece el límite de endeudamiento y de prestación de garantías del sector público foral del Territorio Histórico de Álava, así como normas relativas a la gestión de otras operaciones financieras.</div></div></div><div class="divuser79_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="417" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser80_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="418" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">III. tituluan, besteak beste, aurrekontu kredituen eta horien aldaketen arauketa orokorraren berezitasunak arautzen dira. </div></div><div class="divuser81_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="419" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">En el Título III se regulan, entre otros aspectos, las especialidades del régimen general de los créditos presupuestarios y de sus modificaciones. </div></div></div><div class="divuser82_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="420" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser83_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="421" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">IV. tituluak aurrekontuen kudeaketaren eta kontrolaren inguruko arauak; diruzaintzako aurrerakinak, gastua erreserbatzeko, baimentzeko, prestatzeko eta xedatzeko eskumena duten organoen kontrol ekonomikoa jasotzen ditu.</div></div><div class="divuser84_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="422" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">El Título IV recoge normas relativas a la gestión y control presupuestario; anticipos de tesorería, el control económico, órganos competentes para la reserva, autorización, disposición y ordenación del gasto.</div></div></div><div class="divuser85_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="423" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser86_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="424" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">V. titulua langileak kudeatzeko araubideari buruzkoa da eta bi kapitulutan banatuta dago. I. kapitulua Foru administrazioko sektore publikoari buruzkoa da eta II. Kapitulua Foru sektore publikoko beste erakunde batzuei buruzkoa. Biek arautzen dute aurrekontu plantillaren eraketa eta funtzionarioen, lan kontratudun langileen, aldi baterako langileen eta goi karguen ordainsariak baita ere, dagokionaren arabera. </div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">Gainera, foru sektore publikoko langile gastuen fiskalizazioa arautzen du eta kanpo langileen lana eskatzen duten kontratu eta hitzarmenetan jarduteko jarraibideak ezartzen ditu.</div></div><div class="divuser87_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="425" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">El Título V, sobre el régimen de la gestión de personal, se divide en dos capítulos. El Capítulo I relativo al Sector Público Foral Administrativo y el Capítulo II, relativo a otras entidades del Sector Público Foral. Ambos regulan la composición de la plantilla presupuestaria, las retribuciones íntegras de su personal funcionario, laboral, eventual y altos cargos, según corresponda. </div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">​</div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">También incide en la fiscalización de los gastos de personal del sector público foral y señala pautas de actuación en materia de contratos o convenios que impliquen trabajo de personal externo.</div></div></div><div class="divuser88_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="426" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser89_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="427" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">VI. tituluak&nbsp; toki erakundeen finantzaketa arautzen ditu.</span></div></div><div class="divuser90_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="428" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">El Título VI regula la financiación de las entidades locales.</span></div></div></div><div class="divuser91_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="429" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser92_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="430" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">Aurrekontua Gauzatzeko Foru Araua zazpi xedapen gehigarriren, xedapen indargabetzaile baten eta azken xedapen baten bidez osatzen da; horietan, askotariko aginduak jasotzen dira: </div></div><div class="divuser93_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="431" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class=" estiloIberdokAliJust estiloIberdokInter115" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">El contenido de la Norma Foral de Ejecución Presupuestaria se completa con siete disposiciones adicionales, una disposición derogatoria y una disposición final, en las que se recogen preceptos de índole muy<span class="spanFuentes tipoFuenteId_PTO_NORMA01_1699643425546" data-outer-width="39" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 12.828947368421053%; "> variad</span><span class="spanFuentes tipoFuenteId_PTO_NORMA01_1699643454588" data-outer-width="7" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 2.3026315789473686%; ">a</span><span class="spanFuentes tipoFuenteId_PTO_NORMA01_1699643454561" data-outer-width="8" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 2.6315789473684212%; ">: </span><span class="spanFuentes tipoFuenteId_PTO_NORMA01_1699602024550" data-outer-width="4" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 1.3157894736842106%; ">&nbsp;</span></div></div></div><div class="divuser109_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="432" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser110_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="433" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="newListIberdok" data-mascara="❏_❏_❏_❏_❏_❏_❏_❏_❏" data-idlista="listaId_PTO_NORMA01_1668165589700_1" style="width: 89.41176470588235%; padding-left: 5.294117647058823%; " data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="0px"><span class="listLevel" data-level="0" data-outer-width="10" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 3.289473684210526%; ">❏</span>Lehenengo xedapen gehigarriak Arabako Lurralde Historikoko Dirulaguntzen urriaren 19ko 11/2016 Foru Arauak 32.6 artikuluan ezarritako muga ekonomikoak ezartzen ditu.</div></div><div class="divuser111_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="434" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="newListIberdok estiloIberdokAliJust estiloIberdokInter115" data-mascara="❏_❏_❏_❏_❏_❏_❏_❏_❏" data-idlista="listaId_PTO_NORMA01_1636566652219_1" style="padding-left: 6.176470588235294%; " data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="21px" data-padding-right="0px"><span class="listLevel" data-level="0" data-outer-width="10" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 3.289473684210526%; ">❏</span>La Disposición Adicional Primera establece los umbrales económicos a los que hacen referencia el artículo 32.6 de la Norma Foral 11/2016, de 19 de octubre, de Subvenciones del Territorio Histórico de Álava.</div></div></div><div class="divuser112_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="435" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser113_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="436" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust newListIberdok" data-mascara="❏_❏_❏_❏_❏_❏_❏_❏_❏" data-idlista="listaId_PTO_NORMA01_1636567158482_1" style="padding-left: 5.882352941176471%; " data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="20px" data-padding-right="0px"><span class="listLevel" data-level="0" data-outer-width="10" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 3.289473684210526%; ">❏</span>Bigarrenak, langile gastuei buruzkoak, ahalmena eta baimena ematen die Arabako Foru Aldundiko Gobernu Kontseiluari eta, hala badagokio, Arabako Lurralde Historikoko foru sektore publikoko gainerako organo eskudunei kasuan kasuko ordainsari igoera ezartzeko eta xedatzeko.</div></div><div class="divuser114_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="437" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="newListIberdok estiloIberdokAliJust estiloIberdokInter115" data-mascara="❏_❏_❏_❏_❏_❏_❏_❏_❏" data-idlista="listaId_PTO_NORMA01_1636566652219_1" style="padding-left: 6.176470588235294%; " data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="21px" data-padding-right="0px"><span class="listLevel" data-level="0" data-outer-width="10" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 3.289473684210526%; ">❏</span>La Segunda, referida a los gastos de personal, habilita y autoriza al Consejo de Gobierno de la Diputación Foral de Álava, y al resto de órganos competentes del sector público foral del Territorio Histórico de Álava, en su caso, a establecer y disponer del incremento de retribuciones correspondiente.</div></div></div><div class="divuser115_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="438" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser116_PTO_NORMA01" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="439" style="width: 50%; padding-left: 2.6470588235294117%;