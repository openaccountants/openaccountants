width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Aurrekontu Orokorren indarraldia Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 42. artikuluan xedatutakoa izango da.</span></div></div><div class="divuser225_PTO_NORMA02" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="618" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="121" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 39.80263157894737%; ">Artículo 3. Vigencia</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">La vigencia de los Presupuestos Generales será la dispuesta en el artículo 42 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria.</div></div></div></div></div></div></div><div class="pageBreakSaltoPagina" style="padding-bottom: 35mm; padding-top: 25mm; width: 99.85315712187959%; " data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><div data-outer-width="87" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">IBRDKpagebreakIBRDK</div></div><div class="divuser27_35434" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="619" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 99.85315712187959%; "><div data-xml-nombre="PTO_NORMA03" data-id="02623543-3d14-47f9-938b-2ecafa" data-txt-protegido="false" data-xml-type="marca_pa" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="contenido" class="marca_resuelta" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="presentacion" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser70_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="620" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser71_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="621" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="233" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 76.64473684210526%; ">II. TITULUA. FINANTZA ERAGIKETAK</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="203" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 66.77631578947368%; "><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">4. artikulua. Zorpetzeko baimena</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">1. Baimena ematen zaio Arabako Foru Aldundiari epe luzeko zorpetzea dakarten eragiketak egiteko, ekitaldi horretako aurrekontu beharrei aurre egiteko, baldin eta 2026ko abenduaren 31n foru zor bizia 520.544.993,25 eurotik gorakoa ez bada.</span></div></div><div class="divuser72_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="622" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss estiloIberdokNegrita IBC_LIN_PTO_General" data-outer-width="255" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 83.88157894736842%; ">TITULO II. OPERACIONES FINANCIERAS</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss estiloIberdokNegrita IBC_LIN_PTO_General" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss estiloIberdokNegrita IBC_LIN_PTO_General" data-outer-width="266" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 87.5%; ">Artículo 4. Autorización de endeudamiento</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss estiloIberdokNegrita IBC_LIN_PTO_General" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">1. Se autoriza a la Diputación Foral de Álava a realizar operaciones que supongan endeudamiento a largo plazo siempre y cuando la Deuda Foral Viva a 31 de diciembre de 2026 no exceda de 520.544.993,25 euros, con la finalidad de cubrir necesidades presupuestarias durante el citado ejercicio.</span></div></div></div><div class="divuser88_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="623" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser89_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="624" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="spanFuentes tipoFuenteId_PTO_NORMA03_1671023383663" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">2. Arabako Foru Aldundiari baimena ematen zaio Arabako Lurralde Historikoan etxebizitza erosteko eta/edo alokatzeko abalen programa baten esparruan bermea emateko, 1.200.000 euroko gehieneko saldo biziarekin.</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327547086" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327578445" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Lurralde Orekaren eta Lurralde Antolamenduaren Sailari egokituko zaio abalak baimendu eta formalizatzea, bai eta horien baldintzak zehaztea ere.</span></div></div><div class="divuser90_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="625" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="spanFuentes tipoFuenteId_PTO_NORMA03_1671023419068" data-outer-width="19" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 6.25%; ">2. </span><span class="spanFuentes tipoFuenteId_PTO_NORMA03_1731327591237" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Se autoriza a la Diputación Foral de Álava a prestar garantía en el marco de un programa de avales a la compra y/o alquiler de vivienda en el Territorio Histórico de Álava, con un saldo máximo vivo de 1.200.000 euros.</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327470268" data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">​</span></div><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327515942" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Corresponderá al Departamento de Equilibrio Territorial y Ordenación del Territorio autorizar y formalizar los avales, así como determinar sus condiciones.</span></div></div></div><div class="divuser91_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="626" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser92_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="627" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="18" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 5.921052631578948%; ">3. </span><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327703271" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Aldundiko merkataritza sozietateentzat eta foru fundazioentzat ez da baimentzen epe luzerako zorpetzea, salbu eta ARABAT, Arabako Bideak - Vías de Álava SA aldundiko merkataritza sozietateari, 30.000.000 euroko zorpetze eragiketak ituntzeko baimena ematen baitzaio; eta Arabako Foru Aldundiari, eragiketa horiek bermatzeko baimena.</span></div></div><div class="divuser93_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="628" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="19" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 6.25%; ">3. </span><span class=" spanFuentes tipoFuenteId_PTO_NORMA03_1731327661607" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Para las sociedades mercantiles forales y las fundaciones forales no se permite el endeudamiento a largo plazo, salvo a la sociedad mercantil foral ARABAT, Arabako Bideak-Vías de Álava, S.A. a quien se autoriza a concertar operaciones de endeudamiento por importe de 30.000.000 euros, y a la Diputación Foral de Álava a garantizar dichas operaciones.</span></div></div></div><div class="divuser103_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="629" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser104_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="630" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">4. Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorrak 105. artikuluan ezartzen duenarekin bat, Arabako foru sektore publikoko gainerako erakundeei dagokionez, ez dago zorpetzerik, ezta bermeak ematerik ere, salbu eta Enargi Araba SAU foru sozietate publikoari. Sozietate horri baimena ematen zaio Ekiola proiektuarekin lotutako inbertsioak finantzatzeko eragiketak bermatzeko, 80.000 euroko gehieneko zenbatekoarekin.</div></div><div class="divuser105_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="631" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">4. De acuerdo con lo previsto el artículo 105 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria, a las entidades del sector público foral del Territorio Histórico de Álava, distintas de la Diputación Foral de Álava, no se&nbsp; les permite la prestación de garantías, salvo a la sociedad mercantil foral Enargi Araba, S.A.U., a quien se autoriza a garantizar operaciones de financiación de inversiones relacionadas con el proyecto Ekiola por un importe total máximo de 80.000 euros</div></div></div><div class="divuser97_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="632" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser98_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="633" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">5. artikulua. Beste finantza eragiketa batzuen araubidea</span></div></div><div class="divuser99_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="634" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Artículo 5. Régimen de otras operaciones financieras</span></div></div></div><div class="divuser100_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="635" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser101_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="636" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Aurrekontua finantzatzera bideratuta ez dauden finantza eragiketak ondare kontabilitatean soilik erregistratuko dira; nolanahi ere, lortzen diren etekin garbiak edo egiten diren gastuak aurrekontuari aplikatu ahal izango zaizkio.</span></div></div><div class="divuser102_PTO_NORMA03" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="637" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokInter115 estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Las operaciones financieras no destinadas a financiar el Presupuesto serán objeto de registro exclusivamente en contabilidad patrimonial, sin perjuicio de la aplicación al Presupuesto de los rendimientos netos que se obtengan o gastos en que se incurran.</span></div></div></div></div></div></div></div><div class="pageBreakSaltoPagina" style="padding-bottom: 35mm; padding-top: 25mm; width: 99.85315712187959%; " data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><div data-outer-width="87" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">IBRDKpagebreakIBRDK</div></div><div class="divuser27_35434" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="638" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 99.85315712187959%; "><div data-xml-nombre="PTO_NORMA04" data-id="2cd0f634-01e7-458c-aa3b-8c468b" data-txt-protegido="false" data-xml-type="marca_pa" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="contenido" class="marca_resuelta" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="presentacion" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><d