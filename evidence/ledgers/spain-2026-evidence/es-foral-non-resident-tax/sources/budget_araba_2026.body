* {
  -moz-box-sizing: border-box !important; 
  -webkit-box-sizing: border-box !important;
  box-sizing: border-box !important;
}

html,body,div,span,h1,h2,h3,h4,
h5,h6,p,blockquote,pre,
a,abbr,acronym,address,big,
cite,code,del,dfn,em,
img,ins,small,strong,sub,
sup,b,u,i,center,
dl,dt,dd,ol,ul,
li,fieldset,form,label,legend,
table,caption,tbody,tfoot,thead,
tr,th,td,article,aside,
canvas,figure,figcaption,footer,
header,hgroup,menu,nav,output,
section,summary,time,mark,audio,
video {
	margin: 0;
	padding: 0;
	border: 0;
	font-size: 100%;
	font-weight: inherit;
	font-style: inherit;
	font-family: inherit;
	-webkit-nbsp-mode: normal;
}

ol,ul {
	list-style: none;
}
ol,ul{
	list-style-position: inside;
	list-style-type: none;
}
blockquote,q {
	quotes: none;
}
blockquote:before,blockquote:after,q:before,q:after {
	content: '';
	content: none;
}
table {
	border-collapse: collapse;
	border-spacing: 0;
}
.divmarcoTablaSelecc   { 
    vertical-align: top; 
}/*Espacio en blanco debajo de las tablas iberdok*/
table.marcoTablaSelecc{
	table-layout: fixed;
	width: 0;    
	/*El table-layout:fixed requiere un width para la tabla, pero dejandolo a 0 la tabla toma el ancho de la suma de anchos definidos en las celdas*/
}
table.marcoTablaSelecc td {
	position: relative;
}
table.marcoTablaSelecc > thead.tablaSeleccTheadGrips, 
table.marcoTablaSelecc > thead.tablaSeleccTheadGrips > tr > th{
    height: 0 !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
}
table.marcoTablaSelecc > thead.tablaSeleccTheadGrips > tr > th:before,
table.marcoTablaSelecc > thead.tablaSeleccTheadGrips > tr > th:after {
  display: none !important;
}
table.marcoTablaSeleccBasico td, table.marcoTablaSeleccBasico th {
	border: 1px solid black;
	text-align: left;
}
table.marcoTablaSeleccBasico > thead > tr > th {
    background-color:#d9d9d9;
}
.IBC_LIN_Normal{
    display: inline;
    font-size: 100%;
    font-weight: inherit;
    font-style: inherit;
    font-family: inherit;
}
.sangriaDcha{
    padding-left: 30px;
}

a img{border:none;}


.pagina {
    position: relative;
    /*float: left;*/
    display: -webkit-box;
    display: -moz-box;
    display: -ms-flexbox;
    display: -webkit-flex;
    display: flex;
}

/*Salto de pagina */
/*div [data-nombre="presentacion"] {float:left;width:100%;}*/
div [data-nombre="presentacion"] {/*width:100%;*/width:auto;display:block;}

div.marca{/*NMS*/vertical-align: top;}

div[data-xml-type="marca_pa"]{
      float: left;
      /*width: 100%;*/
      width: auto;
}
@media print{
    div[data-multiresponsive="1"] div[data-xml-type="marca_pa"] {
        width: 100% !important;
    }
    div.marca[data-xml-type="marca_tx"] div[data-xml-type="valorsql"] div[data-id="repreDatos"] .newListIberdok,
    div.marca[data-xml-type="marca_tx"] div[data-xml-type="valorsql"] div[data-id="repreDatos"] div[class*="estiloIberdokAli"],
    div.marca[data-xml-type="marca_tx"] div[data-xml-type="valorsql"] div[data-id="repreDatos"] div[class*="sangria"]{
        display: block !important;
    }
}
div[data-xml-type="marca_pa"][data-tipobloque="enLinea"],
div[data-xml-type="marca_pa"][data-tipobloque="enLinea"] [data-nombre="contenido"],
div[data-xml-type="marca_pa"][data-tipobloque="enLinea"] [data-nombre="contenido"] [data-nombre="presentacion"]{
      float: none;
      width: auto;
      display: inline;
}

/**************************************/
/** Estilos marcas en linea y bloque **/
/**************************************/
div.marca[data-xml-type="marca_tx"]{
    display: inline;
}
div.marca[data-xml-type="marca_tx"] div{
      display: inline;
      float: none;
      width: auto;
}

div[data-xml-type="detalle"] div.marca[data-xml-type="marca_tx"] div[data-nombre="contenido"] img{
    max-width: 100%;
    max-height: 100%;
}

div.marca[data-representacion="linea"]{
      display: inline;
      float: none;
      width: auto;
}

div.marca[data-representacion="bloqueEnLinea"]{
      display: inline-block;
      float: none;
      width: auto;
}
div.marca[data-representacion="linea"] div{
      display: inline;
      float: none;
      width: auto;
}

div.marca[data-representacion="bloque"] > span[data-id], 
div.marca[data-representacion="bloque"] > span[data-lang]{
      display: block;
}
div.marca[data-representacion="linea"] span[data-campo]{
      float: none;
}
div.marca[data-representacion="linea"][data-tieneValor="false"] span[data-campo]{
      padding: 0px 5px;
      height: 1em;
}

div.marca[data-representacion="linea"] div.marca_sin_resolver.estiloInicialMarca{
      display: inline;
}

div.marca[data-representacion="bloque"] div[data-xml-type="representacion"]{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-xml-type="representacion"] div{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-visibilidad="0"]{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-visibilidad="0"] div{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-xml-type="datos"]{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-xml-type="datos"] div{
      display: inline;
}
div.marca[data-representacion="bloque"] div[data-xml-type="items"]{
      display: inline;
} 
div.marca[data-representacion="bloque"] div[data-xml-type="items"] div, 
div.marca[data-representacion="bloque"] div[data-xml-type="items"] span{
      display: none;
}

/******************************************/
/** Fin Estilos marcas en linea y bloque **/
/******************************************/



/******************************************/
/*     estilos marcas en TABLA            */
/******************************************/

div.marca table{
	page-break-inside:auto; 
	page-break-after:auto;
}
div.marca table tr,div.marca table td { 
	page-break-inside:avoid; 
	page-break-after:auto; 
}

div.marca table thead,
div.marca table tfoot { 
	display:table-row-group 
}

div.marca table[data-isRepCabecera="true"] thead{
	display:table-header-group 
}
div.marca table[data-isRepPie="true"]  tfoot{
	display:table-footer-group 
}

/******************************************/
/*    FIN estilos marcas en TABLA         */
/******************************************/



.cuerpo{
/*    float:left;*/
    font-family:Arimo_fontsIberdok;
    font-size:10px;
    color: black;
    padding-left:0px;
} 
.valorp{float:left;} 


div[data-nombre="div-user"],
div[data-nombre="div-user"] > .protecPagMarco:not([data-rotado="1"]),
div[data-nombre="div-user"] > .contenidocentrado,
div[data-xml-type="marca_pa"],
div[data-xml-type="marca_gp"]{
    max-width: 100%;
}

/***********************************/
/** Marcos con contenido centrado **/
/***********************************/

div[data-contenidocentrado][data-protecpagmarco="no"]{
    display: -webkit-box;
    display: flex;
    -webkit-box-orient: vertical;
}

div[data-contenidocentrado][data-protecpagmarco="no"] > .contenidocentrado {
	display: -webkit-box;
	-webkit-box-pack: center;
	-webkit-box-align: center;
	-webkit-box-orient: vertical;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	text-align: center;
	min-height: inherit !important;
}
div[data-contenidocentrado][data-protecpagmarco="si"] > .contenidocentrado {
	display: -webkit-inline-box;
	-webkit-box-pack: center;
	-webkit-box-align: center;
	-webkit-box-orient: vertical;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	text-align: center;
	min-height: inherit !important;
}
div[data-contenidocentrado] > .contenidocentrado > *:not([data-nombre="div-user"]):not([data-nombre="tabla-user"]):not([data-xml-type="marca_pa"]):not([class^="marca_"]):not([data-xml-type="marca_BD"]):not(.iberdokHref) {
    max-width: 100%;
    width: 100%;
}

@media print {
    div[data-contenidocentrado] > .contenidocentrado > div[data-nombre="div-user"] {
        float: initial;
        margin-left: auto;
        margin-right: auto;
    }
}

/*****************************/
/** Texto Enriquecido **/
/*****************************/
div.marca[data-xml-type="marca_tx"] div[data-formato="TE"] ~ div[data-xml-type="valorsql"] div[data-id="repreDatos"] div{
    display: block !important;
}
/*****************************/
/** Pregunta asistente alineaciones **/
/*****************************/
@media print {
    .ALI_P_ARRIBA .preguntaAsistente {
        display: block !important;
    }
    .ALI_P_IZQ .infoAsistente {
        display: inline-block !important;
    }
}
/*****************************/
/** Estilos botonera editor **/
/*****************************/
div[data-estilopropio='iberdok'],.estiloParrafoCss {
    display: inline;
}
.estiloIberdokNegrita{
	display: inline;
	font-weight: bold;
}
.estiloIberdokSinNegrita{
	display: inline;
	font-weight: normal;
}
.estiloIberdokCursiva{
	display: inline;
	font-style: italic;
}
.estiloIberdokSinCursiva{
	display: inline;
	font-style: normal;
}
.estiloIberdokSubrayado{
	display: inline;
	text-decoration: underline;
}
.estiloIberdokTachado{
	text-decoration: line-through;
}
.estiloIberdokSubTach{
	text-decoration: underline line-through;
}
.estiloIberdokSinSubrayado{
	/*NMS*/
	text-decoration: initial;
}
.estiloIberdokAliDcha{
	display: block;
	text-align: right;
}
.estiloIberdokAliCent{
	display: block;
	text-align: center;
}
.estiloIberdokAliIzq{
	display: block;
	text-align: left;
}
.estiloIberdokAliJust{
	display: block;
	text-align: justify;
}
.estiloIberdokSubIndice{
    vertical-align:sub;
}
.estiloIberdokSuperIndice{
	vertical-align:super;
}
/*****************************/


