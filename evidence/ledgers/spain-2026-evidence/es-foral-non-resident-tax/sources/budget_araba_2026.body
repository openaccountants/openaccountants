/*------------------------------------------------------------*/
.IBC_LIN_PTO_FichaGenero{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #0c6b27;
	color: #000000;
/*  padding: 0px 5px 0px 5px; */
}
/*------------------------------------------------------------*/
/*--               Tomos Presupuestos (Notas)               --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_Notas{
	font-size:13pt;
    font-family: Arimo_fontsIberdok;
	text-align: center;
	font-weight: bold;
	color: #ffffff;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--           Tomos Presupuestos (Notas Tablas)            --*/
