/*------------------------------------------------------------*/
/*--            Tabla Evolucion del Presupuesto             --*/
/*------------------------------------------------------------*/
.IBC_TAB_PTO_EvolPresupuesto {
    border-collapse: collapse;
    font-family: Arimo_fontsIberdok;
    font-size: 8.2pt;
}
.IBC_TAB_PTO_EvolPresupuesto thead th {
    border-top: 1.5pt solid black;
    font-weight: bold;
    text-align: right !important;
    padding: 4px 0 4px 10px;
    border-bottom: 16px solid transparent; 
    position: relative;
}
.IBC_TAB_PTO_EvolPresupuesto thead th:first-child {
    width: 60%;
    text-align: center !important;
    padding: 4px 0 4px;
}
.IBC_TAB_PTO_EvolPresupuesto thead th:nth-child(2),
.IBC_TAB_PTO_EvolPresupuesto thead th:nth-child(3) {
    width: 14%;
}
.IBC_TAB_PTO_EvolPresupuesto thead th:last-child {
    width: 12%;
}
.IBC_TAB_PTO_EvolPresupuesto thead th:before {
    content: '';
    width: 100%;
    height: 1.5pt;
    background-color: black;
    display: block;
    position: absolute;
    bottom: -2px;
    left: 0;
}
.IBC_TAB_PTO_EvolPresupuesto tbody tr {
    vertical-align: top;
}
.IBC_TAB_PTO_EvolPresupuesto td:not(:first-child) {
    text-align: right;
}
.IBC_TAB_PTO_EvolPresupuesto tbody td:not(:first-child) {
    white-space: nowrap;
}
.IBC_TAB_PTO_EvolPresupuesto tbody tr:last-child td {
    border-bottom: 10px solid transparent;
}
.IBC_TAB_PTO_EvolPresupuesto tbody tr:last-child td:before {
    content: '';
    width: 100%;
    height: 1.5pt;
    background-color: black;
    display: block;
    position: absolute;
    bottom: -2px;
    left: 0;
}
.IBC_TAB_PTO_EvolPresupuesto_LIN1,
.IBC_TAB_PTO_EvolPresupuesto_LIN3,
.IBC_TAB_PTO_EvolPresupuesto_LIN4,
.IBC_TAB_PTO_EvolPresupuesto_LIN6,
.IBC_TAB_PTO_EvolPresupuesto_LIN7 {
    line-height: 1.5;
}
.IBC_TAB_PTO_EvolPresupuesto_LIN2 {
