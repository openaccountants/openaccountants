/*------------------------------------------------------------*/
/*--              Tomos Presupuestos (Acuerdo)              --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_Acuerdo{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #fc0000;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--              Tomos Presupuestos (General)              --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_General{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #7d0a29;
	color: #0067c7;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--            Tomos Presupuestos (Indicadores)            --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_Indicadores{
	font-size:9pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #0067c7;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--              Tomos Presupuestos (Memoria)              --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_Memorias{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #0c6b27;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--            Tomos Presupuestos (Norma Foral)            --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_NormaForal{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #7d0a29;
	color: #2f302f;
	color: #000000;
}
/*------------------------------------------------------------*/
/*--                 Texto Viñeta Check Activo              --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_TxtChecked {
    display: inline-block !important;
    margin-left: 0px;
    font-size: 10pt;
    text-indent: -19px;
    padding-left: 19px;
    color: #000000;
}
.IBC_LIN_PTO_TxtChecked:before {
    font-family: 'Iconosib_fontsIberdok';
    font-size: 10pt;
    color: #000000;
    content: "w";
    display: inline-block;
    width: 19px;
    text-indent: 0;
}
/*------------------------------------------------------------*/
/*--                Texto Viñeta Check Inactivo             --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_TxtUnChecked {
    display: inline-block !important;
    margin-left: 0px;
    font-size: 10pt;
    text-indent: -19px;
    padding-left: 19px;
    color: #000000;
}
.IBC_LIN_PTO_TxtUnChecked:before {
    font-family: 'Iconosib_fontsIberdok';
    font-size: 10pt;
    color: #000000;
    content: "q";
    display: inline-block;
    width: 19px;
    text-indent: 0;
}
/***--------------------------------------------------------***/
/***                    ESTILOS DE DISEÑO                   ***/
/***--------------------------------------------------------***/
/***
/***--------------------------------------------------------***/
/***                    ESTILOS LINEALES                    ***/
/***--------------------------------------------------------***/
/*------------------------------------------------------------*/
/*--         Tomos Presupuestos (Cabecera Epígrafes)        --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_CabEpigrafe {
	font-size:11pt;
    font-family: Arimo_fontsIberdok;
	font-weight: bold;
	text-align: left;
	color: #258527;
	color: #2f302f;
	color: #000000;	
/*	text-decoration: underline overline; */
}
/*------------------------------------------------------------*/
/*--       Tomos Presupuestos (Departamento-Programa)       --*/
/*------------------------------------------------------------*/
.IBC_LIN_PTO_DptoProg{
	font-size:10pt;
    font-family: Arimo_fontsIberdok;
	text-align: justify;
	color: #00281e;
	color: #5f005f;
	color: #000000;
    padding: 2px 0px 2px 0px;
}
