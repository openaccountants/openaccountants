uter-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="contenido" class="marca_resuelta" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div data-nombre="presentacion" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser23_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="913" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser24_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="914" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">LEHENENGO XEDAPEN GEHIGARRIA. Dirulaguntzen aurrerakinak.</span></div></div><div class="divuser25_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="915" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">DISPOSICIÓN ADICIONAL PRIMERA. Anticipos de subvenciones.</span><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "></div></div></div><div class="divuser182_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="916" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser183_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="917" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">Arabako Lurralde Historikoko Dirulaguntzei buruzko urriaren 19ko 11/2016 Foru Arauaren 32.6 artikuluan jasorikoaren ondorioetarako, 2026ko ekitaldian, 20.000 eurotik gorakoak ez diren dirulaguntzen eta transferentzien ordainketak, edo onuradunak sektore publikokoak badira, ez dira egongo haren araudi erregulatzailean aurreikusitako aurrerakinen ordainketari buruzko mugen mende.</div></div><div class="divuser184_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="918" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731328148939" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">A los efectos de lo previsto en el artículo 32.6 de la Norma Foral 11/2016, de 19 de octubre de Subvenciones del Territorio Histórico de Álava, durante el ejercicio 2026 el pago de las subvenciones y transferencias cuya cuantía no supere el importe de 20.000 euros, o cuyos beneficiarios sean Administraciones Públicas, no estarán sujetos a las limitaciones sobre el pago de anticipos o abonos a cuenta previstas en su normativa reguladora.</span></div></div></div><div class="divuser29_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="919" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser30_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="920" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">BIGARREN XEDAPEN GEHIGARRIA. Langileen gastuak.</span><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "></div><div class="divuser31_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="921" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloParrafoCss IBC_LIN_PTO_General estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">DISPOSICIÓN ADICIONAL SEGUNDA. Gastos de personal.</span></div></div></div><div class="divuser185_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="922" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser186_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="923" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731489834865" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Ordainsari igoera ezartzen da 2026ko ekitaldian. Igoera Arabako Foru Aldundiko Foru Gobernu Kontseiluak eta baimena ematen zaien foru sektore publikoko gainerako organo eskudunek zehaztuko dute; nolanahi ere, gehienez ere, Estatuko oinarrizko legerian ezartzen den muga orokorraren bestekoa izango da.</span></div></div><div class="divuser187_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="924" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">Se establece un incremento de las retribuciones para el ejercicio 2026 que se determinará por el Consejo de Gobierno de la Diputación Foral de Álava y por los órganos competentes del resto de entidades del sector público foral a los que se autoriza para ello, que será, como máximo, el establecido como límite general en la legislación básica estatal.</div></div></div><div class="divuser32_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="925" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser33_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="926" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">HIRUGARREN XEDAPEN OSAGARRIA. Arabako Foru Ogasunaren tasen aldaketa orokorra.</span></div><div class="divuser34_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="927" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">DISPOSICIÓN ADICIONAL TERCERA.&nbsp; Modificación general de tasas de la Hacienda Foral de Álava.</span><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "></div></div></div><div class="divuser218_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="928" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser219_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="929" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita  spanFuentes tipoFuenteId_PTO_NORMA08_1731328549650" data-outer-width="80" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 23.529411764705884%; ">Lehenengoa.</span><span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731328549662" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; "> 2026ko urtarrilaren 1etik aurrerako ondorioekin, handitu egingo dira Arabako Foru Ogasunaren tasa-tasak, zenbateko finkokoak badira -oinarriko ehuneko batek zehazten ez dituelako-, 2025ean eska daitekeen zenbatekoari 1,02 koefizientea aplikatzetik ateratzen den zenbatekoraino.</span></div><div class="divuser220_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="930" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="spanFuentes tipoFuenteId_PTO_NORMA08_1731328661015 estiloIberdokNegrita" data-outer-width="53" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 15.588235294117647%; ">Primero.</span><span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731328502192" data-outer-width="305" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.70588235294117%; "> Con efectos desde 1 de enero de 2026, los tipos de tasas de la Hacienda Foral de Álava que sean de cuantía fija, por no estar determinado por un porcentaje en la base, se incrementarán hasta la cantidad que resulte de aplicación del coeficiente 1,02 a la cuantía exigible en 2025.</span></div></div><div class="divuser578_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="931" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser579_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="932" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="84" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 24.705882352941178%; ">Bigarrena. </span>Aurreko apartatuan xedatutakoa gorabehera, takografo digitalaren txartela emateagatiko tasaren tasak ez du aldaketarik izango 2026ko ekitaldian, 2025ean eska daitekeenaren aldean.</div><div class="divuser580_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="933" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="spanFuentes tipoFuenteId_PTO_NORMA08_1762944708086 estiloIberdokNegrita" data-outer-width="59" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 19.407894736842106%; ">Segundo.</span><span class="spanFuentes tipoFuenteId_PTO_NORMA08_1762944708065" data-outer-width="5" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 1.644736842105263%; ">&nbsp;</span>No obstante lo dispuesto en el apartado anterior, el tipo de la tasa por la expedición de la tarjeta de tacógrafo digital no variará en el ejercicio 2026 respecto del exigible en 2025.</div></div></div><div class="divuser191_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="934" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser192_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="935" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="77" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 22.647058823529413%; ">Hirugarrena.</span> Lehenengo<span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731328651586" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; "> apartatuan ezarritako koefizientea aplikatuta ateratzen diren tasak unitatetan biribildu ahal izango dira, goitik edo behetik.</span></div><div class="divuser193_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="936" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="spanFuentes tipoFuenteId_PTO_NORMA08_1731328661056 estiloIberdokNegrita" data-outer-width="51" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 16.776315789473685%; ">Tercero.</span><span class=" spanFuentes tipoFuenteId_PTO_NORMA08_1731328588840" data-outer-width="6" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 1.9736842105263157%; ">&nbsp;</span>Los tipos resultantes de la aplicación del coeficiente establecido en el apartado primero podrán redondearse a la unidad, por exceso o por defecto.</div></div></div><div class="divuser41_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="937" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser42_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="938" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">LAUGARREN XEDAPEN GEHIGARRIA. Arabako toki erakundeek hitzartu beharreko epe luzeko kreditu eragiketak.</span></div><div class="divuser43_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="939" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">DISPOSICIÓN ADICIONAL CUARTA. Operaciones de crédito a largo plazo a concertar por las entidades locales de Álava.</span></div></div><div class="divuser215_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="940" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser216_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="941" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="80" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 23.529411764705884%; ">Lehenengoa.</span> Ezertan eragotzi gabe Toki Ogasunak Arautzen dituen Foru Arauaren testu bategina onesten duen Foru Gobernu Kontseiluaren irailaren 29ko 1/2021 Araugintzako Foru Dekretuaren 57.3 artikuluan ezarritakoa, 2026. urtean Kontuen Europako Sistemaren definizioaren eta mugaketaren arabera Administrazio Publikoen sektorean sailkatuta dauden toki entitateek eta haien mendeko entitateek, 2025eko ekitaldiaren likidazioa aurrezki garbi positiboa edo likidatutako edo sortutako diru sarrera arrunten 100eko 2tik beherako aurrezki garbi negatiboa badute, Toki Ogasunak Arautzen dituen Foru Arauaren testu bategina onesten duen irailaren 29ko Foru Gobernu Kontseiluaren 1/2021 Araugintzako Foru Dekretuaren 53. artikuluan ezarritako moduan kalkulatuta, epe luzeko kreditu eragiketa berriak hitzartu ahalko dituzte, baldin eta kapital biziaren bolumen osoak likidatutako edo sortutako diru sarrera arrunten ehuneko 60 gainditzen ez badu, kontabilitate egoera bateratuetatik ondorioztatutako zifren arabera, eta, hala badagokio, Toki Ogasunak arautzen dituen Foru Arauaren testu bategina onesten duen irailaren 29ko Foru Gobernu Kontseiluaren 1/2021 Araugintzako Foru Dekretuari eta Aurrekontu Egonkortasunari buruzko Araudiari jarraikiz.</div><div class="divuser217_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="942" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="53" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 15.588235294117647%; ">Primero.</span> Sin perjuicio de lo establecido en el artículo 57.3 del Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales, durante el ejercicio 2026, las entidades locales y sus entidades dependientes clasificadas en el sector Administraciones Públicas, de acuerdo con la definición y delimitación del Sistema Europeo de Cuentas, que liquiden el ejercicio 2025 con ahorro neto positivo o con ahorro neto negativo inferior al 2 por 100 de los ingresos corrientes liquidados o devengados, calculado en la forma que establece el artículo 53 del Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales, podrán concertar nuevas operaciones de crédito a largo plazo cuando el volumen total del capital vivo no exceda del 60 por ciento de los ingresos corrientes liquidados o devengados según las cifras deducidas de los estados contables consolidados, con sujeción, en su caso, al Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales y a la Normativa de Estabilidad Presupuestaria.</div></div><div class="divuser326_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="943" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser327_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="944" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="64" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 18.823529411764707%; ">Bigarrena.</span> 2026ko ekitaldian, Kontuen Europako Sistemaren definizioaren eta mugaketaren arabera Administrazio Publikoen sektorean sailkatuta dauden toki-entitateek eta haien mendeko entitateek epe luzeko zorpetze eragiketak hitzartu ahal izango dituzte, Arabako Foru Aldundiak baimena eman ondoren, eta, hala badagokio, Toki Ogasunak arautzen dituen Foru Arauaren testu bategina onartzen duen Foru Gobernu Kontseiluaren irailaren 29ko 1/2021 Foru Dekretu Arauemaileari jarraikiz; betiere, 2025ko ekitaldia aurrezki garbi positiboarekin edo nuluarekin likidatzen badute eta likidatutako edo sortutako diru sarrera arrunten ehuneko 60 baino gehiagoko zorpetze bolumena badute, baina ehuneko 110 edo txikiagoa.</div><div class="divuser328_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="945" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="59" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 17.352941176470587%; ">Segundo.</span> En el ejercicio 2026, las entidades locales y sus entidades dependientes clasificadas en el sector Administraciones Públicas, de acuerdo con la definición y delimitación del Sistema Europeo de Cuentas, que liquiden el ejercicio 2025 con ahorro neto positivo o nulo y que tengan un volumen de endeudamiento superior al 60 por ciento pero inferior o igual al 110 por ciento de los ingresos corrientes liquidados o devengados según las cifras deducidas de los estados contables consolidados, podrán concertar operaciones de endeudamiento a largo plazo previa autorización de la Diputación Foral de Álava con sujeción, en su caso, al Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales.</div></div><div class="divuser323_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="946" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser324_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="947" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="77" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 22.647058823529413%; ">Hirugarrena.</span> 2026ko ekitaldian, toki erakundeek eta Europako Kontu Sistemako definizioaren eta mugen arabera administrazio publikoen sektorean sailkatuta dauden haien mendeko erakundeek, ez badituzte betetzen lehenengo eta bigarren idatz zatietan azaldutako baldintzak, ezingo dute epe luzerako kreditu eragiketarik hitzartu.</div><div class="divuser325_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="948" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="51" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 15%; ">Tercero.</span> En el ejercicio 2026, las entidades locales y sus entidades dependientes clasificadas en el sector Administraciones Públicas, de acuerdo con la definición y delimitación del Sistema Europeo de Cuentas que no cumplan las condiciones recogidas en los apartados primero y segundo, no podrán concertar operaciones de crédito a largo plazo.</div></div><div class="divuser329_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="949" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser330_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="950" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="74" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 21.764705882352942%; ">Laugarrena.</span> Aurreko apartatuetan azaldutakoaren salbuespen gisa, hitzartutako epe luzerako kreditu eragiketak birfinantzatzeko eragiketak formalizatu ahal izango dira, betiere helburutzat badute eragiketa haien finantza karga arintzea, amortizazio epea luzatzea edota arriskua gutxitzea, mugaeguneratzeko dauden eragiketen ondoriozko obligazioei dagokienez, aldez aurretik Arabako Foru Aldundiaren baimena jasota.</div><div class="divuser331_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="951" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="45" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 13.235294117647058%; ">Cuarto.</span> Como excepción a lo dispuesto en los apartados anteriores se podrán formalizar operaciones de refinanciación de operaciones de crédito a largo plazo concertadas, siempre que tengan por finalidad la disminución de la carga financiera, la ampliación del período de amortización o el riesgo de aquellas operaciones, respecto a las obligaciones derivadas de las pendientes de vencimiento, previa autorización de la Diputación Foral de Álava.</div></div><div class="divuser332_PTO_NORMA08" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="952" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser339_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="953" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser340_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" id="954" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Baimenari kalterik egin gabe, kasu horietan honako baldintza hauek ezartzen dira:</div><div class="divuser341_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="955" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Sin perjuicio de la autorización, en estos casos se establecen las siguientes condiciones:</div></div><div class="divuser336_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="956" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser337_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="957" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">a) Erakundeek likidazioan aurrezki garbi positiboa badute eta haien zorra ehuneko 60tik gorakoa bada baina ez badu gainditzen likidatutako edo sorrarazitako diru sarrera arrunten ehuneko 110, kontabilitate orri bateratuetatik ateratako zifren arabera. Osoko Bilkuraren erabaki baten bidez, kapital bizia murrizteko plana onartu beharko da, bost urte igaro baino lehen kapital biziaren zenbatekoa ehuneko 60 edo gutxiago izan dadin.</div><div class="divuser338_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="958" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">a) Cuando las entidades liquiden con ahorro neto positivo y tengan un volumen de endeudamiento superior al 60 por ciento pero inferior o igual al 110 por ciento de los ingresos corrientes liquidados o devengados según las cifras deducidas de los estados contables consolidados. Mediante acuerdo de Pleno, se deberá aprobar un plan de reducción del capital vivo para que, en un plazo máximo de cinco años, el volumen del mismo sea igual o inferior al 60 por ciento.</div></div><div class="divuser333_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="959" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser334_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="960" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">b) Erakundeek likidazioan aurrezki garbi negatiboa badute edo haien zor biziaren zenbatekoak likidatutako edo sorrarazitako diru sarrera arrunten ehuneko 110 gainditzen badu, kontabilitate orri bateratuetatik ateratako zifren arabera. Osoko bilkuraren erabaki bidez, finantza saneamenduko edo kapital bizia murrizteko plan bat onetsi beharko da, gehienez ere bost urteko epean aurrezki garbiaren zeinua edo zor biziaren bolumena zuzentzeko, zor bizia % 110ekoa edo txikiagoa izan dadin, hurrenez hurren.<br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">Ezingo dira birfinantzatze horretan sartu otsailaren 9ko 3/2004 Foru Arauak, Arabako Lurralde Historikoko toki erakundeen aurrekontuenak, 34. eta 49. artikuluetan ezarritakoa aplikatuz egindako eragiketak.</div><div class="divuser335_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="961" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">b) Cuando las entidades liquiden con ahorro neto negativo o tengan un volumen de endeudamiento vivo superior al 110 por ciento de los ingresos corrientes liquidados o devengados según las cifras deducidas de los estados contables consolidados. Mediante acuerdo de Pleno, se deberá aprobar un plan de saneamiento financiero o de reducción del capital vivo para corregir, en un plazo máximo de cinco años, el signo del ahorro neto o el volumen de la deuda viva para que esta sea igual o inferior al 110%, respectivamente.<br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "><br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">No se podrán incluir en la citada refinanciación las operaciones formalizadas en aplicación de los artículos 34 y 49 la Norma Foral 3/2004, de 9 de febrero, Presupuestaria de las Entidades Locales del Territorio Histórico de Álava.</div></div></div><div class="divuser317_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="962" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser318_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="963" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Goiko a) eta b) apartatuetan aipatutako planak Arabako Foru Aldundiari jakinarazi beharko zaizkio. Toki erakundeko kontuhartzaile lanak egiten dituen organoak plan horien betetzeari buruzko txostena egin beharko du urtero. Toki korporazioaren Osoko Bilkurari txosten horren berri emango zaio, jakitun egon dadin. Gainera, Arabako Foru Aldundiari igorriko zaio.</div><div class="divuser319_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="964" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Los planes mencionados en los apartados a) y b) anteriores, deberán comunicarse a la Diputación Foral de Álava. El órgano que haga las funciones de intervención en la entidad local deberá emitir un informe anual del cumplimiento de estos planes. Del informe se dará cuenta al Pleno de la corporación local para su conocimiento, además, deberá ser remitido a la Diputación Foral de Álava.</div></div><div class="divuser602_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="965" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser603_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="966" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Aipatutako planak bete ezean, toki erakundeak ezingo du epe luzerako zorpetze eragiketarik hitzartu edozein motatako inbertsioak finantzatzeko.</div><div class="divuser604_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="967" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">En el caso de que se produzca un incumplimiento de los citados planes, la entidad local no podrá concertar operaciones de endeudamiento a largo plazo para financiar cualquier modalidad de inversión.</div></div><div class="divuser314_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="968" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser315_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="969" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"> Edonola ere, ezingo da areagotu Arabako Biltzar Nagusietan onartutako Aurrekontu eta Finantza Bideragarritasuneko Planaren arabera baimendutako eragiketen amortizazio epea, berau arautzen duen Foru Araua aurretik aldatu ez bada.</div><div class="divuser316_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="970" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">En todo caso no se podrá aumentar el periodo de amortización de las operaciones autorizadas en virtud de un Plan de Viabilidad Presupuestaria y Financiera aprobado por las Juntas Generales de Álava sin la previa modificación de la Norma Foral reguladora.</div></div><div class="divuser345_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="971" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser346_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="972" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="76" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 22.352941176470587%; ">Bosgarrena.</span> Aurrezki garbiaren eta zorpetze mailaren kalkuluan zenbatu behar diren diru sarrera arruntak zehazteko, Toki Ogasunak Arautzen dituen Foru Arauaren testu bategina onesten duen irailaren 29ko Foru Gobernu Kontseiluaren 1/2021 Araugintzako Foru Dekretuaren 53. artikuluan 57. artikuluan xedatutakoari jarraituko zaio.</div><div class="divuser347_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="973" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="45" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 13.235294117647058%; ">Quinto.</span> Para la determinación de los ingresos corrientes a computar en el cálculo del ahorro neto y del nivel de endeudamiento, se estará a lo dispuesto en el artículo 57 del Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales.</div></div><div class="divuser348_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="974" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser349_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="975" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="71" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 20.88235294117647%; ">Seigarrena.</span> Kapital bizia kalkulatzeko kontuan hartuko dira 2025eko abenduaren 31n indarrean dauden eragiketa guztiak, abalen ondoriozko arriskua barne, eta azken horri gehituko zaizkio formalizatutako eragiketetako saldo ez erabiliak eta proiektatutako eragiketen zenbatekoa, halakorik egonez gero. Arabako Toki Erakundeak Finantzatzeko Foru Funtseko behin betiko likidazioen ondorioz toki erakundeek itzuli behar dituzten saldoak ez dira kontuan hartuko.</div><div class="divuser350_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="976" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="39" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 11.470588235294118%; ">Sexto.</span> A efectos del cálculo del capital vivo, se considerarán todas las operaciones vigentes a 31 de diciembre del año 2025, incluido el riesgo deducido de avales, incrementado, en su caso, en los saldos de operaciones formalizadas no dispuestos y en el importe de las operaciones proyectadas. No se incluirán los saldos que deban reintegrar las entidades locales derivados de las liquidaciones definitivas del Fondo Foral de Financiación de las Entidades Locales de Álava.</div></div><div class="divuser354_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="977" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser355_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="978" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="84" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 24.705882352941178%; ">Zazpigarrena.</span> Toki erakundeek egindako zorpetze eragiketak Arabako Foru Aldundiari jakinarazi beharko zaizkio formalizatzen direnetik hilabete igaro aurretik. </div><div class="divuser356_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="979" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="55" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 16.176470588235293%; ">Séptimo.</span> Las operaciones de endeudamiento formalizadas por las Entidades Locales deberán ser notificadas a la Diputación Foral de Álava, dentro del mes siguiente a su formalización. </div></div><div class="divuser351_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="980" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser352_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="981" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="87" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 25.58823529411765%; ">Zortzigarrena.</span> Toki erakundeek kreditu eragiketak ituntzeko beren prozeduretan parte hartzen duten finantza entitateen esku jarriko dute tokiko kontu hartzailetzaren txostena, Toki Ogasunak arautzen dituen Foru Arauaren testu bategina onesten duen irailaren 29ko 1/2021 Araugintzako Foru Dekretuaren 55. artikuluaren 2. apartatuan arautua. Txosten horretan, aurreko paragrafoetan aipatutako mugak betetzen direla egiaztatzen duten kalkuluak jasoko dira, bai eta ordaintzeko gaitasunaren neurketari eragiten dion beste edozein doikuntza ere, eta, aplikatzekoa den kasuetan, aipatutako arau horren 53.5 artikuluan araututako nahitaezko baimena betetzen dela adieraziko da. Finantza erakundeek, hala badagokio, beren eskaintzak aldatu edo kendu ahal izango dituzte, txostenaren edukia ezagutu ondoren.</div><div class="divuser353_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="982" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="48" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 14.117647058823529%; ">Octavo.</span> Las Entidades Locales pondrán a disposición de las entidades financieras que participen en sus procedimientos para la concertación de operaciones de crédito, el informe de la Intervención local regulado en el apartado 2 del artículo 55 del Decreto Foral Normativo 1/2021, del Consejo de Gobierno Foral de 29 de septiembre, por el que se aprueba el texto refundido de la Norma Foral reguladora de las Haciendas Locales, en el que se incluirán los cálculos que acrediten el cumplimiento de los límites citados en los párrafos anteriores y cualesquiera otros ajustes que afecten a la medición de la capacidad de pago, así como el cumplimiento, en los casos que resulte de aplicación, de la autorización preceptiva regulada en el artículo 53.5 de la citada norma, pudiendo las entidades financieras, en su caso, modificar o retirar sus ofertas, una vez conocido el contenido del informe.</div></div><div class="divuser212_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="983" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser213_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="984" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="110" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 32.35294117647059%; ">Bederatzigarrena.</span> Toki erakundeen elkarteetan oinarritutako entitateak, partzuergoak eta sozietate publikoak desegiten direnean, haien kide edo partaide izandako toki erakundeek, haien eskubide eta betebehar guztietan subrogatuta, epe luzeko kreditu eragiketak hitzartu ahal izango dituzte betebeharrak betetzeko, alegia, toki erakunde bakoitzak berari dagokion zatia betetzeko, bere partaidetza portzentajearen arabera. </div><div class="divuser214_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="985" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="51" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 15%; ">Noveno.</span> La concertación de operaciones de crédito a largo plazo en los supuestos de disolución de entidades de base asociativa local, consorcios y sociedades públicas, por parte de las entidades locales que las hubieren integrado o participado, en tanto se subroguen en todos sus derechos y obligaciones, tendrá como finalidad dar cumplimiento las obligaciones que se deriven en la parte que les corresponda de acuerdo con su porcentaje de participación. </div></div><div class="divuser363_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="986" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser364_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="987" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Zorpetze eragiketa berriak formalizatu ahal izateko, Arabako Foru Aldundiaren aurretiazko baimenaz gainera, organo likidatzailearen ziurtagiria ere beharko da, non jasorik utziko baita toki erakundeak bere partaidetza portzentajeari dagokion zorra hartu duela bere gain, behin mankomunitatearen, partzuergoaren edo sozietate publikoaren eskubide ekonomikoak gauzatu eta beraren betebeharrak betetzeko erabili eta gero.</div><div class="divuser365_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="988" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Para la formalización de las nuevas operaciones de endeudamiento, además de autorización previa de la Diputación Foral de Álava, se requerirá la certificación del órgano liquidador relativa a la correspondencia de la deuda asumida con el porcentaje de participación mencionado, una vez se han ejecutado los derechos económicos de la mancomunidad, consorcio o sociedad pública y aplicado al cumplimiento de las obligaciones a cargo de la misma.</div></div><div class="divuser360_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="989" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser361_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="990" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="92" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 27.058823529411764%; ">Hamargarrena.</span> 2026ko ekitaldian Arabako kontzejuek epe luzerako zorpetze eragiketak hitzartu ahal izango dituzte, betiere Arabako Foru Aldundiaren baimena jasoz gero. </div><div class="divuser362_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="991" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="51" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 15%; ">Décimo.</span> En el ejercicio 2026 los Concejos Alaveses podrán concertar operaciones de endeudamiento a largo plazo, en todo caso previa autorización de la Diputación Foral de Álava. </div></div><div class="divuser357_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="992" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser358_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="993" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Toki erakunde horiek baldintza bakarra bete beharko dute: aurreko ekitaldiaren likidazioan aurrezki korrontea positiboa izatea. Horien diru sarrera arrunten eraginetarako, ordenantza bidez onartutako auzotarren ekarpenak kontuan hartuko dira. &nbsp;</div><div class="divuser359_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="994" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Estas entidades locales sólo deberán cumplir el requisito de liquidar el ejercicio anterior con ahorro corriente positivo. A los efectos de sus ingresos corrientes se tomarán en cuenta las aportaciones vecinales debidamente aprobadas mediante ordenanza. &nbsp;</div></div><div class="divuser342_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="995" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser343_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="996" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Aurreko lerroaldean azaldutako baldintza betetzen ez duten kontzejuek ezingo dute epe luzerako kreditu eragiketarik hitzartu.</div><div class="divuser344_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="997" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Aquellos Concejos que no cumplan la condición recogida en el párrafo anterior, no podrán concertar operaciones de crédito a largo plazo.</div></div><div class="divuser390_PTO_NORMA08" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="998" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser412_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="999" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser413_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1000" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita  spanFuentes tipoFuenteId_PTO_NORMA08_1731333670870" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">BOSGARREN XEDAPEN GEHIGARRIA.<br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "> Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorra aldatzea.</span></div><div class="divuser414_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="1001" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="spanFuentes tipoFuenteId_PTO_NORMA08_1731333391536 estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">DISPOSICIÓN ADICIONAL QUINTA.<br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; "> Modificación de la Norma Foral 3/2023, de 25 de&nbsp; enero, General Presupuestaria.</span></div></div><div class="divuser488_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1002" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser489_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1003" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita  spanFuentes tipoFuenteId_PTO_NORMA08_1731333801585" data-outer-width="86" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 25.294117647058822%; ">Lehenengoa. </span><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 19. artikuluaren 1. apartatua, eta honela geratzen da:</span></div><div class="divuser490_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="1004" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita  spanFuentes tipoFuenteId_PTO_NORMA08_1731333766825" data-outer-width="62" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 18.235294117647058%; ">Primero. </span><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Se modifica el primer apartado del artículo 19 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser485_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1005" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser486_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1006" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“1. Foru Ogasunari izaera publikoko eskubideen indarrez zor zaizkion zenbatekoek berandutze korrituak sortuko dituzte mugaegunaren biharamunetik aurrera."</span></div><div class="divuser487_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="1007" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“1. Las cantidades adeudadas a la Hacienda Foral en virtud de derechos de naturaleza pública devengarán intereses de demora desde el día siguiente al de su vencimiento.”</span></div></div></div><div class="divuser518_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1008" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser519_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1009" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Bigarrena. Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 37. artikuluaren e) letra, eta honela geratzen da:</span></div><div class="divuser520_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1010" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Segundo. Se modifica la letra e) del artículo 37 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser521_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1011" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser522_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1012" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">"e) Ez lotzearen printzipioa. Foru sektore publikoa osatzen duten erakundeen baliabideak bakoitzaren betebehar guztiak betetzeko erabiliko dira, salbu eta helburu jakin batzuetarako diren diru sarrera espezifikoak."</span></div><div class="divuser523_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1013" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“e) Principio de no afectación. Los recursos de las entidades que componen el sector público foral se destinarán a satisfacer el conjunto de sus respectivas obligaciones, salvo en el caso de ingresos específicos afectados a fines determinados."</span></div></div><div class="divuser509_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1014" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser510_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1015" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Hirugarrena. Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 47. artikuluaren 4. apartatua, eta honela geratzen da:</span></div><div class="divuser511_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1016" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Tercero. Se modifica el apartado 4 del artículo 47 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser527_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1017" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser528_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1018" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“4. Gastu proiektu bat aurrekontu gastuko unitate bat da, erabat identifikagarria, termino orokorretan edo espezifikoetan, zeinaren burutzapena, aurrekontu kreditu baten edo batzuen kargura egin eta ekitaldi batera edo gehiagora hedatu, jarraipen eta kontrol indibidualizatua eskatzen duen."</span></div><div class="divuser529_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1019" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“4. Un proyecto de gasto es una unidad de gasto presupuestario perfectamente identificable, en términos genéricos o específicos, cuya ejecución, se efectué con cargo a uno o varios créditos presupuestarios y se extienda a uno o más ejercicios, requiere un seguimiento y control individualizado.”</span></div></div><div class="divuser530_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1020" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser531_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1021" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Laugarrena. Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 62. artikuluaren 1. apartatuko d) letra, eta honela geratzen da:</span></div><div class="divuser532_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1022" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Cuarto. Se modifica la letra d) del apartado 1 del artículo 62 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser533_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1023" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser534_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1024" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">"d) Kapital eta finantza eragiketetarako kredituetatik eragiketa arruntetarako kredituetara, betiere inbertsio berriak martxan jartzeko erabiltzen badira eta, bestela, ekitaldiko aurrekontua gauzatzeko foru arauak ezartzen duen mugarekin."</span></div><div class="divuser535_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1025" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“d) De créditos para operaciones de capital y financieras a créditos para operaciones corrientes, siempre que sean utilizados para la entrada en funcionamiento de las nuevas inversiones y, en otro caso, con el límite que establezca la norma foral de ejecución presupuestaria del&nbsp; ejercicio.”</span></div></div><div class="divuser524_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1026" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser525_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1027" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Bosgarrena.&nbsp; Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 62. artikuluaren 1. apartatuko e) letra, eta honela geratzen da:</span></div><div class="divuser526_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1028" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Quinto. Se modifica la letra e) del apartado 1 del artículo 62 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser512_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1029" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser513_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1030" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">"e) Sailetako programetan erabiltzen ez diren zuzkiduretatik kreditu orokorreko programara, horiek berresleitzeko."</span></div><div class="divuser514_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1031" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“e) De las dotaciones no utilizadas en los programas de los distintos Departamentos al programa de crédito global, para su reasignación.”</span></div></div><div class="divuser384_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1032" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser385_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1033" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Seigarrena. Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 62. artikuluaren 2. apartatuko 2.5 zenbakia, eta honela geratzen da:</span></div><div class="divuser386_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1034" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Sexto. Se modifica el número 2.5. del apartado 2 del artículo 62 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser421_PTO_NORMA08" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="1035" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser425_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1036" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser426_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1037" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“2.5. Ez dituzte gutxituko transferentzia araubidearen arabera gehitutako ordainketa kredituak, ez eta Foru Arau honen 59. artikuluaren 7. apartatuan xedatutakoaren arabera dagokion konpromiso kreditua handitu zaien ordainketa kredituak ere, artikulu bereko 6. apartatuan aurreikusitako birbanaketa kasuetan izan ezik".</span></div><div class="divuser427_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="1038" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“2.5. No minorarán los créditos de pago incrementados en función del régimen de transferencias, ni aquellos de los que el correspondiente crédito de compromiso haya sido incrementado de acuerdo con lo dispuesto en el apartado 7 del artículo 59 de la presente norma foral, salvo en los supuestos de redistribución previstos en el apartado 6 del mismo artículo.”</span></div></div></div><div class="divuser387_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1039" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser388_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1040" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Zazpigarrena. Aldatzen da Aurrekontuei buruzko urtarrilaren 25eko 3/2023 Foru Arau Orokorraren 73. artikuluaren 3. apartatua, eta honela geratzen da:</span></div><div class="divuser389_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1041" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Séptimo. Se modifica el apartado 3 del artículo 73 de la Norma Foral 3/2023, de 25 de enero, General Presupuestaria que queda redactado en los siguientes términos:</span></div></div><div class="divuser428_PTO_NORMA08" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="1042" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser432_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1043" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser433_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1044" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“3. Kreditua eskuragarri ez izatea aurrekontu partida bateko kredituaren saldo osoa edo zati bat ibilgetzeko egintzatik eratortzen da, eta aurrekontuaren betearaztean eta aldaketen araubidean ez erabilgarri adieraziko da.</span></div><div class="divuser434_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-protecpagmarco="no" data-estructura="" id="1045" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">“3. La no disponibilidad del crédito se deriva del acto mediante el cual se inmoviliza la totalidad o parte del saldo del crédito de una partida presupuestaria, declarándolo como no susceptible de utilización&nbsp; en la ejecución presupuestaria ni en el régimen de modificaciones.</span></div></div><div class="divuser429_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1046" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser430_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-protecpagmarco="no" data-estructura="" id="1047" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Hala, ez erabilgarri adierazteak ez du kredituaren deuseztatzea ekarriko, baina erabilgarri ez dagoela adierazitako saldoaren kargura ezingo dira gastuak gauzatu ez aurrekontu aldaketarik egin, eta zenbatekoa ezingo zaio hurrengo ekitaldiko aurrekontuari aplikatu."</span></div><div class="divuser431_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1048" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokCursiva" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">Así, la declaración de no disponibilidad no supondrá la anulación del crédito, pero con cargo al saldo declarado no disponible no podrán ejecutarse gastos ni realizarse modificaciones presupuestarias y su importe no podrá ser incorporado al presupuesto del ejercicio siguiente.”</span></div></div></div><div class="divuser581_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1049" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser582_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1050" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="235" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 77.30263157894737%; ">SEIGARREN XEDAPEN GEHIGARRIA.</span></div><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="240" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 78.94736842105263%; ">Zerbitzu aktiboan jarraitzeko luzapena.</span></div></div><div class="divuser583_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1051" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="211" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 69.40789473684211%; ">DISPOSICIÓN ADICIONAL SEXTA. </span></div><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><span class="IBC_LIN_PTO_General estiloParrafoCss estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; ">Prolongación de la permanencia en el servicio activo.</span></div></div></div><div class="divuser584_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1052" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser585_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1053" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">1. Euskal Enplegu Publikoari buruzko abenduaren 1eko 11/2022 Legearen 67.3 artikuluan ezarritakoaren arabera, erretiro arrunta ofizioz deklaratuko da, funtzionarioa legez ezarritako adinera iristen denean.</div></div><div class="divuser586_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1054" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">1. De conformidad con lo establecido en el artículo 67.3 de la Ley 11/2022, de 1 de diciembre, de Empleo Público Vasco, la jubilación ordinaria se declarará de oficio al cumplir la persona funcionaria la edad que se determine legalmente.</div></div></div><div class="divuser587_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1055" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser588_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1056" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">2. 2026ko ekitaldian, nahitaezko erretirorako adinera iristen denean (erretiro arrunta hartzeko legezko adina, Gizarte Segurantzaren edo kasu bakoitzean dagokion mutualitatearen araubidearen arabera), Arabako Foru Aldundiak zerbitzu aktiboaren luzapena onartu ahal izango du, baldin eta interesdunak egiaztatzen badu ez dituela kasu bakoitzari dagokion pentsioaren ehuneko ehuna sortzeko behar diren zerbitzu- edo kotizazio-urteak, ehuneko horretara iritsi arte.</div></div><div class="divuser589_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1057" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">2. Durante el ejercicio 2026 cuando se alcance la edad de jubilación forzosa (edad legal de acceso a la jubilación ordinaria de acuerdo con el régimen de Seguridad Social o de mutualidad que corresponda en cada caso) la Diputación Foral de Álava podrá conceder la prórroga en el servicio activo cuando la persona interesada acredite no contar con los años de servicio o de cotización necesarios para generar el cien por cien de la pensión que corresponda en cada supuesto, hasta alcanzar dicho porcentaje.</div></div></div><div class="divuser590_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1058" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser591_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1059" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">3. Zerbitzu aktiboaren luzapena ezin izango da onartu interesdunak pentsio publikoak jasotzeko urtero aurrekontu-legerian ezartzen den gehieneko mugaren berdina edo handiagoa den erretiro-pentsio bat sortzeko baldintzak betetzen dituenean, nahiz eta zerbitzu aktiboan jarraitzeak gehieneko muga horretatik gorako pentsio bat jasotzeko eskubidea sortu, portzentaje gehigarriak aplikatuta.</div></div><div class="divuser592_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1060" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">3. No procederá la concesión de la prórroga en el servicio activo cuando la persona interesada reúna las condiciones para causar una pensión por jubilación igual o superior al límite máximo de percepción de las pensiones públicas que se establezca anualmente en la legislación presupuestaria, aun en el caso de que la permanencia en el servicio activo pudiera generar el derecho a percibir una pensión superior a dicho límite máximo mediante la aplicación de porcentajes adicionales.</div></div></div><div class="divuser593_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1061" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser594_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1062" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">4. Ezin izango da, inolaz ere, hirurogeita hamar urtetik gorako luzapenik eman.</div></div><div class="divuser595_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1063" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">4. En ningún caso podrá concederse una prórroga más allá de los setenta años.</div></div></div><div class="divuser596_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1064" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser597_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1065" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">5. Zerbitzu aktiboan jarraitzeko salbuespenezko baimena erretiro arrunta hartzeko adina bete baino hiru hilabete lehenago eskatu beharko du interesdunak, eta, nolanahi ere, Funtzio Publikoaren Zuzendaritzaren nahitaezko txosten loteslea beharko da.</div></div><div class="divuser598_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1066" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">5. La autorización excepcional de la prolongación de la permanencia en el servicio activo deberá solicitarse por la persona interesada con tres meses de antelación al cumplimiento de la edad de jubilación ordinaria y precisará en todo caso de un informe previo preceptivo y vinculante de la Dirección de Función Pública.</div></div></div><div class="divuser599_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1067" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser600_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1068" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">6. Bai luzapena onartzeko bai onartutako epean jarraitu ahal izateko, interesduna zerbitzurako egokitzat jo beharko da, dagokion osasun-azterketaren bidez, eta, hala badagokio, Funtzio Publikoaren Zuzendaritzak egindako jardunaren ebaluazioaren emaitzen bidez.</div></div><div class="divuser601_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1069" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><div class="estiloIberdokAliJust" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px">6. Tanto la concesión de la prórroga como su mantenimiento en el plazo concedido está condicionada a que la persona interesada fuera considerada apta para el servicio mediante la realización del correspondiente examen de salud y, en caso de que se determine, a los resultados de la evaluación del desempeño realizada por la Dirección de Función Pública.</div></div></div><div class="divuser227_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1070" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser228_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1071" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">ZAZPIGARREN XEDAPEN GEHIGARRIA. <br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">AP-1 autobideko bidesariaren zenbatekoa eguneratzea.</span></div><div class="divuser229_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1072" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"><span class="estiloIberdokNegrita" data-outer-width="304" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 89.41176470588235%; ">DISPOSICIÓN ADICIONAL SEPTIMA. <br data-outer-width="0" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 0%; ">Actualización del importe de peaje por utilización de la Autopista AP-1.</span></div></div><div class="divuser466_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1073" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser467_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1074" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Hona hemen AP-1 autobidearen erabiltzaileek 2026ko ekitaldian VIASAri ordaindu behar dizkioten bidesarien zenbatekoak (BEZa barne), ibilgailu motaren eta Arabako Lurralde Historikoko zatien arabera:</div><div class="divuser468_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1075" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px">Las cuantías del peaje a abonar por los usuarios de la Autopista AP-1 a VIASA en el ejercicio 2026 en función del tipo de vehículos y por tramos en el Territorio Histórico de Álava, IVA incluido, serán las siguientes:</div></div><div class="divuser475_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multi" data-idioma="M" data-estructura="columna" data-protecpagmarco="no" id="1076" data-outer-width="680" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 100%; "><div class="divuser476_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="eu" data-estructura="" data-protecpagmarco="no" id="1077" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"></div><div class="divuser477_PTO_NORMA08" data-nombre="div-user" data-tipomarco="multiHijo" data-idioma="es" data-estructura="" data-protecpagmarco="no" id="1078" style="width: 50%; padding-left: 2.6470588235294117%; padding-right: 2.6470588235294117%; " data-outer-width="340" data-margin-left="0px" data-margin-right="0px" data-padding-left="18px" data-padding-right="18px"></div></div><div class="divuser478_PTO_NORMA08" data-nombre="div-user" data-idioma="B" data-estructura="" data-protecpagmarco="no" id="1079" data-outer-width="523" data-margin-left="68px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px" style="width: 76.91176470588235%; margin-left: 10%; "><div class="divmarcoTablaSelecc" data-nombre="tabla-user" id="marcotablauser1_PTO_NORMA08" style="display: inline-block; position: relative; left: 0px; top: 0px; width: 95.60229445506693%; " data-outer-width="500" data-margin-left="0px" data-margin-right="0px" data-padding-left="0px" data-padding-right="0px"><table class="marcoTablaSelecc IBC_TAB_PTO_Estandar_01" id="tablauser1_