/*------------------------------------------------------------*/
/*--      Tomos Presupuestos (Tabla Tipologia Pijama)       --*/
/*------------------------------------------------------------*/
.IBC_TAB_PTO_Pijama {
    width: 100%;
    border-spacing: 0px;
    border-collapse: separate;
    border: 1px solid #bbb9b9; 
    font-family: Arimo_fontsIberdok;
	font-size: 11px;
    text-align: left;
    table-layout: auto; 
	margin-right: 3mm;
    padding: 0px 5px 0px 5px;
}
.IBC_TAB_PTO_Pijama tbody tr:nth-child(odd)  {
    background-color: #EDEEF0;
}
.IBC_TAB_PTO_Pijama th {
	background-color: #1c1c1c;
	color: #53afed;
	font-weight: bold;
	font-size: 11px;
	word-break: normal;
	border: 7px solid transparent;
	text-align: center;
	margin-left: 4px;
	padding: 10px 0px 10px 0px;
}
.IBC_TAB_PTO_Pijama td {
  word-break: normal;
  border: 7px solid transparent;
  text-align: left;
  margin-left: 4px;
}
.IBC_TAB_PTO_Pijama td:nth-child(1){
  border-left: 0px;
  text-align: left !important;
  color: #258527;
	color: #000000;
}
.IBC_TAB_PTO_Pijama td:nth-child(2){
  border-left: 0px;
  text-align: left !important;
  color: #0541e8;
	color: #000000;
}
.IBC_TAB_PTO_Pijama td:nth-last-child(n){
  border-right:0px;
}
.IBC_TAB_PTO_Pijama tr{
 /* display: table-row-group; */
    border-bottom: 1px solid #bbb9b9; 
    width: 100% !important;
}
.IBC_TAB_PTO_Pijama thead tr {
    border-bottom: 2px solid #1c1c1c; 
    background-color: #7C7C80;
    color: #fff;
    font-weight: bold;
 /* display:table-header-group; */
}
.IBC_TAB_PTO_Pijama  thead tr th{
  padding: 5px 0px;
}
.IBC_TAB_PTO_Pijama tr:last-child{
    border-bottom: 0px; 
}
