/*********** para formatos HTML de entrada **************/



div.htmlB64 {
    position: relative;
}
div.htmlB64 p {
    display: block;
    margin: 1em 0;
}
div.htmlB64 div {
    display: block;
}
div.htmlB64 article, 
div.htmlB64 aside,
div.htmlB64 footer,
div.htmlB64 header,
div.htmlB64 hgroup,
div.htmlB64 main,
div.htmlB64 nav,
div.htmlB64 section {
    display: block;
}
div.htmlB64 marquee {
    display: inline-block;
}
div.htmlB64 address {
    display: block;
}
div.htmlB64 blockquote {
    display: block;
    margin: 1em 40px;
}
div.htmlB64 figcaption {
    display: block;
}
div.htmlB64 figure {
    display: block;
    margin: 1em 40px;
}
div.htmlB64 q {
    display: inline;
}
div.htmlB64 center {
    display: block;
    text-align: center;
}
div.htmlB64 hr {
    display: block;
    margin: 0.5em auto;
    border-style: inset;
    border-width: 1px;
}
div.htmlB64 map {
    display: inline;
}
div.htmlB64 h1 {
    display: block;
    font-size: 2em;
    margin: 0.67em 0;
    font-weight: bold;
}
div.htmlB64 h2 {
    display: block;
    font-size: 1.5em;
    margin: 0.83em 0;
    font-weight: bold;
}
div.htmlB64 h3 {
    display: block;
    font-size: 1.17em;
    margin: 1em 0;
    font-weight: bold;
}
div.htmlB64 h4 {
    display: block;
    margin: 1.33em 0;
    font-weight: bold;
}
div.htmlB64 h5 {
    display: block;
    font-size: .83em;
    margin: 1.67em 0;
    font-weight: bold;
}
div.htmlB64 h6 {
    display: block;
    font-size: .67em;
    margin: 2.33em 0;
    font-weight: bold;
}
div.htmlB64 table {
    display: table;
    border-collapse: separate;
    border-spacing: 2px;
    border-color: gray;
}
div.htmlB64 thead {
    display: table-header-group;
    vertical-align: middle;
    border-color: inherit;
}
div.htmlB64 tbody {
    display: table-row-group;
    vertical-align: middle;
    border-color: inherit;
}
div.htmlB64 tfoot {
    display: table-footer-group;
    vertical-align: middle;
    border-color: inherit;
}
div.htmlB64 table > tr {
    vertical-align: middle;
}
div.htmlB64 col {
    display: table-column;
}
div.htmlB64 colgroup {
    display: table-column-group;
}
div.htmlB64 tr {
    display: table-row;
    vertical-align: inherit;
    border-color: inherit;
}
div.htmlB64 td,
div.htmlB64 th {
    display: table-cell;
    vertical-align: inherit;
}
div.htmlB64 th {
    font-weight: bold;
}
div.htmlB64 caption {
    display: table-caption;
    text-align: center;
}
div.htmlB64 ul,
div.htmlB64 menu {
    display: block;
    list-style-type: disc;
    margin: 1em 0;
    padding-left: 40px;
}
div.htmlB64 ol {
    display: block;
    list-style-type: decimal;
    margin: 1em 0;
    padding-left: 40px;
}
div.htmlB64 li {
    display: list-item;
    text-align: left;
}
div.htmlB64 ul,
div.htmlB64 ol {
    list-style-position: outside;
}
div.htmlB64 ul ul,
div.htmlB64 ol ul {
    list-style-type: circle
}
div.htmlB64 ol ol ul,
div.htmlB64 ol ul ul,
div.htmlB64 ul ol ul,
div.htmlB64 ul ul ul {
    list-style-type: square
}
div.htmlB64 dd {
    display: block;
    margin-left: 40px;
}
div.htmlB64 dl {
    display: block;
    margin: 1em 0;
}
div.htmlB64 dt {
    display: block
}
div.htmlB64 ol ul,
div.htmlB64 ul ol,
div.htmlB64 ul ul,
div.htmlB64 ol ol {
    margin-top: 0;
    margin-bottom: 0;
}
div.htmlB64 form {
    display: block;
    margin-top: 0;
}
div.htmlB64 label {
    cursor: default;
}
div.htmlB64 legend {
    display: block;
    padding-left: 2px;
    padding-right: 2px;
    border: none
}
div.htmlB64 fieldset {
    display: block;
    border: 2px groove grey;
    margin-left: 2px;
    margin-right: 2px; 
    padding: 0.35em 0.75em 0.625em;
}
div.htmlB64 input,
div.htmlB64 textarea,
div.htmlB64 keygen,
div.htmlB64 select,
div.htmlB64 button {
    margin: 0;
    text-rendering: auto; 
    color: black;
    letter-spacing: normal;
    word-spacing: normal;
    line-height: normal;
    text-transform: none;
    text-indent: 0;
    text-shadow: none;
    display: inline-block;
    text-align: left;
}
div.htmlB64 input[type="hidden"] {
    display: none;
}
div.htmlB64 input {
    padding: 1px;
    background-color: white;
    border: 2px inset;
    cursor: auto;
}
div.htmlB64 keygen,
div.htmlB64 select {
    border-radius: 5px;
}
div.htmlB64 textarea {
    background-color: white;
    border: 1px solid;
    cursor: auto;
    padding: 2px;
    white-space: pre-wrap;
    word-wrap: break-word;
}
div.htmlB64 select {
    box-sizing: border-box;
    align-items: center;
    border: 1px solid;
    white-space: pre;
    color: black;
    background-color: white;
    cursor: default;
}
div.htmlB64 optgroup {
    font-weight: bolder;
    display: block;
}
div.htmlB64 option {
    font-weight: normal;
    display: block;
    padding: 0 2px 1px 2px;
    white-space: pre;
    min-height: 1.2em;
}
div.htmlB64 meter {
    box-sizing: border-box;
    display: inline-block;
    height: 1em;
    width: 5em;
    vertical-align: -0.2em;
}
div.htmlB64 progress {
    box-sizing: border-box;
    display: inline-block;
    height: 1em;
    width: 10em;
    vertical-align: -0.2em;
}
div.htmlB64 u,
div.htmlB64 ins {
    text-decoration: underline
}
div.htmlB64 strong,
div.htmlB64 b {
    font-weight: bold
}
div.htmlB64 i,
div.htmlB64 cite,
div.htmlB64 em,
div.htmlB64 var,
div.htmlB64 address,
div.htmlB64 dfn {
    font-style: italic
}
div.htmlB64 tt,
div.htmlB64 code,
div.htmlB64 kbd,
div.htmlB64 samp {
    font-family: monospace
}
div.htmlB64 pre {
    display: block;
    font-family: monospace;
    white-space: pre;
    margin: 1em 0;
}
div.htmlB64 mark {
    background-color: yellow;
    color: black
}
div.htmlB64 big {
    font-size: larger
}
div.htmlB64 small {
    font-size: smaller
}
div.htmlB64 s,
div.htmlB64 strike,
div.htmlB64 del {
    text-decoration: line-through
}
div.htmlB64 sub {
    vertical-align: sub;
    font-size: smaller
}
div.htmlB64 sup {
    vertical-align: super;
    font-size: smaller
}
div.htmlB64 nobr {
    white-space: nowrap
}

/*********** Fin para formatos HTML de entrada **************/


/*********** para evitar colapso de margenes **************/

.evitarColapsoMargen {
    float: none;
    margin: 0px;
    height: 0px;
    vertical-align: top;
    clear: both;
}

div.evitarColapsoMargen:before{
    content: '\200b';
    font-family: 'Arimo_fontsIberdok';
}


/*********** Fin para evitar colapso de margenes **************/


/*************************/

@media screen{
    div[data-tipomarco="multi"][data-estructura="columna"] {
        /* display: -webkit-box; */
        display: -moz-box;
        display: -ms-flexbox;
        display: -webkit-flex;
        display: flex;
        flex-direction: row;
    	align-items: stretch;    
    }
    .pageBreakSaltoPagina, .pageBreakSaltoSeccion{
    	float: left;
        width: 100%;
        height: 20px;
        cursor: default;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -khtml-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        clear: both;
    }
    div[data-mostrar="false"] .pageBreakSaltoPagina{
        display: none;
    }
    .pageBreakSaltoPagina > div:not(.insertarSecciones):not(.secciones){
        width: calc(100% + 12px);
    }
    .pageBreakSaltoSeccion > div:not(.insertarSecciones):not(.secciones){
        width: 100%;
    }
    .pageBreakSaltoPagina > div:not(.insertarSecciones):not(.secciones), 
    .pageBreakSaltoSeccion > div:not(.insertarSecciones):not(.secciones){
        position: absolute;
    	left: -6px;
        text-align: center;
        font-size: 8px;
        line-height: 20px;
        height: 20px;
        color: #CCCCCC;
        background-color: #CCCCCC;
    }
        
    

}



@media print{
    div[data-tipomarco="multi"][data-estructura="columna"] {
        flex-wrap: wrap
    }
	.pageBreakSaltoPagina, .pageBreakSaltoSeccion{
		width: 100%;
		visibility: hidden;
		background-color: #FFFFFF;
		page-break-after: always;
		padding: 0 !important;
		margin: 0 !important;
		height: 0px !important;
        clear: both;
	}
    div[data-mostrar="false"] .pageBreakSaltoPagina{
        page-break-after: unset;
    }
	.pageBreakSaltoPagina > .insertarSecciones,
	.pageBreakSaltoPagina > .secciones,
    .pageBreakSaltoSeccion > .insertarSecciones,
    .pageBreakSaltoSeccion > .secciones{
        display: none;
    }
    .pageBreakSaltoPagina > div:not(.insertarSecciones):not(.secciones), 
    .pageBreakSaltoSeccion > div:not(.insertarSecciones):not(.secciones){
        width: 100%;
        text-align: center;
        font-size: 1px !important;
        color: #FFFFFF;
    }
    table div{
        position: static !important;
    }
    .contenedorSalto{
        float: none !important;
        display: block;
        vertical-align: top;
        overflow: hidden;
    }
    .marca-de-agua:after{
        background-image: url('data:image/png;base64,');
        background-repeat: repeat-y;
        background-size: 100% 100%;
        position: absolute;
        content: ' ';
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    
    }
}


#seccionPaginas > #seccionPaginasScroll .contenidoPaginas [data-tipoMarco="tablasinf"] table{
	margin: 0 !important;
}
@media print {
    #seccionPaginas > #seccionPaginasScroll .contenidoPaginas [data-tipoMarco="tablasinf"] table{
    	margin: 0 !important;
    }
}


/*****************/
/* RESPONSIVE */
/*****************/
@media screen {
    .editor--slider div[data-multiresponsive="1"] .cuerpoSec0 {
        width: 100%;
    }
}
/* Tamanio max 991px 61.9375em */
@media screen and (max-width: 991px) {
    div[data-multiresponsive="1"] .cuerpoSec0 {
        width: calc(100% - 40px) !important;
        margin-left: 20px !important;
        margin-right: 20px !important;
    }
}
/* TODOS LOS CONTENEDORES RESPONSIVE AL 100% DE ANCHURA */
div[class*="IBC_RESP"] {
    width: 100%;
}

/*********** Layout 1 **************/


/* DESKTOP (default) */
.IBC_RESP1_layout1 > div[data-tipomarco="responsiveHijo"] {
    width: 100%; 
}
.IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
    width: 40%; 
}
.IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
    width: 60%; 
}
.IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) > div {
    text-align: right !important;
    padding-right: 2mm !important;
}

.IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
.IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3) {
    width: 33.33%; 
}
.IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
    width: 33.34%; 
}

.IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
.IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2),
.IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3),
.IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(4) {
    width: 25%; 
}
/* End DESKTOP (default) */

/* TABLET Tamanio max 991px */
@media screen and (max-width: 991px) {
    .IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
        width: 50%; 
    }
    .IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
        width: 50%; 
    }
    .IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) > div {
        text-align: right !important;
        padding-right: 2mm !important;
    }
    
    .IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
    .IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
        width: 50%; 
    }
    .IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3) {
        width: 100%; 
    }
    
    .IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
    .IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2),
    .IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3),
    .IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(4) {
        width: 50%; 
    }
}
/* END TABLET */

/* MOBILE Tamanio max 767px 47.9375em */
@media screen and (max-width: 767px) {
    .IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) > div {
        text-align: left !important;
    }
    .IBC_RESP2_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+2),
    .IBC_RESP3_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+3),
    .IBC_RESP4_layout1 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+4) {
        width: 100%; 
    }
}
/* END MOBILE */

/*********** Fin Layout 1 **************/

/*********** Layout 2 **************/


/* DESKTOP (default) */
.IBC_RESP1_layout2 > div[data-tipomarco="responsiveHijo"] {
    width: 100%; 
}
.IBC_RESP2_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
    width: 40%; 
}
.IBC_RESP2_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
    width: 60%; 
}

.IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
.IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3) {
    width: 33.33%; 
}
.IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
    width: 33.34%; 
}

.IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
.IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2),
.IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3),
.IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(4) {
    width: 25%; 
}
/* End DESKTOP (default) */

/* TABLET Tamanio max 991px */
@media screen and (max-width: 991px) {
    .IBC_RESP2_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
        width: 50%; 
    }
    .IBC_RESP2_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
        width: 50%; 
    }
    
    .IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2),
    .IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3) {
        width: 50%; 
    }
    .IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
        width: 100%; 
    }
    
    .IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1),
    .IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(4) {
        width: 100%; 
    }
    .IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2),
    .IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(3) {
        width: 50%; 
    }
}
/* End TABLET */

/* MOBILE Tamanio max 767px 47.9375em */
@media screen and (max-width: 767px) {
    .IBC_RESP2_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+2),
    .IBC_RESP3_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+3),
    .IBC_RESP4_layout2 > div[data-tipomarco="responsiveHijo"]:nth-of-type(-n+4) {
        width: 100%; 
    }
}
/* END MOBILE */

/*********** Fin Layout 2 **************/

/*********** Layout 3 **************/


/* DESKTOP (default) */
.IBC_RESP1_layout3 > div[data-tipomarco="responsiveHijo"] {
    width: 100%; 
}
.IBC_RESP2_layout3 > div[data-tipomarco="responsiveHijo"]:nth-of-type(1) {
    width: 20%; 
}
.IBC_RESP2_layout3 > div[data-tipomarco="responsiveHijo"]:nth-of-type(2) {
    width: 80%; 
}
/* End DESKTOP (default) */

/*********** Fin Layout 3 **************/

/* NUMERADORES **********************/

.pagina {
    counter-reset: ibk_num1 ibk_num2 ibk_num3 ibk_num4 ibk_num5 ibk_let1 ibk_let2 ibk_let3 ibk_let4 ibk_let5;
}

div[data-xml-type="marca_pa"] {
    counter-reset: ibk_bl_num1 ibk_bl_num2 ibk_bl_num3 ibk_bl_num4 ibk_bl_num5 ibk_bl_let1 ibk_bl_let2 ibk_bl_let3 ibk_bl_let4 ibk_bl_let5;
}

div[data-xml-type="marca_pa"] div[data-xml-type="marca_pa"] {
    counter-reset: ibk_blbl_num1 ibk_blbl_num2 ibk_blbl_num3 ibk_blbl_num4 ibk_blbl_num5 ibk_blbl_let1 ibk_blbl_let2 ibk_blbl_let3 ibk_blbl_let4 ibk_blbl_let5;
}

/* FIN NUMERADORES **********************/



@media print {
    a[href]:after {
        content: '';
    }
}
@media print {
    a {
        outline-style : solid;
        outline-color : transparent;
    }
}
/* REPRESENTACION MARCAS EN PREVISUALIZACION **********************/
@media print {
    body {
        -webkit-print-color-adjust:exact !important;
        print-color-adjust:exact !important;
    }
    [data-preview="S"] .marca_BD,
    [data-preview="S"] .marca_texto,
    [data-preview="S"] .numeracion[data-xml-detalle='reglas'],
    [data-preview="S"] .numeracion[data-xml-detalle='fechaDocUser'],
    [data-preview="S"] .numeracion[data-xml-detalle='nombreDocUser'],
    [data-preview="S"] .numeracion[data-xml-detalle='PDFExterno'],
    [data-preview="S"] .numeracion[data-xml-detalle='marcadorBloque']{
        width: auto;
    	border-radius: 3px;
    	font-family: 'OpenSans_iberdok', Verdana, 'Source_Sans_Pro_Regular', Arial, Helvetica, sans-serif;
    	font-size: calc(100% - 1px);
    	font-weight: normal;
    	font-style: normal;
    	line-height: 120%;
    	margin: 0px;
    	white-space: nowrap;
    	padding: 4px 0 0;
    	padding-right:10px;
    	-webkit-transition:background-color 0.5s ease,color 0.5s ease,border 0.5s ease,-webkit-box-shadow 0.5s ease;
    	-moz-transition:background-color 0.5s ease,color 0.5s ease,border 0.5s ease,-moz-box-shadow 0.5s ease;
    	-ms-transition:background-color 0.5s ease,color 0.5s ease,border 0.5s ease,-ms-box-shadow 0.5s ease;
    	transition:background-color 0.5s ease,color 0.5s ease,border 0.5s ease,box-shadow 0.5s ease;
    	text-decoration: initial;
    }
    [data-preview="S"] .marca_BD,
    [data-preview="S"] .marca_texto{
    	background-color: #DEF7F4;
    	border: 1px solid #076169;
    	color: #434E57;
    }
    [data-preview="S"] .numeracion[data-xml-detalle='reglas'],
    [data-preview="S"] .numeracion[data-xml-detalle='fechaDocUser'],
    [data-preview="S"] .numeracion[data-xml-detalle='nombreDocUser'],
    [data-preview="S"] .numeracion[data-xml-detalle='marcadorBloque']{
    	background-color: #F2CA91;
    	border: 1px solid #D37F08;
    	color: #434E57;
    }
    [data-preview="S"] .numeracion[data-xml-detalle='PDFExterno']{
        float: left;
        width: 100%;
    	text-align: center;
    	margin: 6px 0px;
    	padding: 10px;
    	background-color: #a74040;
    	border: 1px solid #602424;
        color: #ffffff;
    }

    [data-preview="S"] .marca_BD:before,
    [data-preview="S"] .marca_texto:before,
    [data-preview="S"] .numeracion[data-xml-detalle='reglas']:before,
    [data-preview="S"] .reglaInformativa:before,
    [data-preview="S"] .numeracion[data-xml-detalle='fechaDocUser']:before,
    [data-preview="S"] .numeracion[data-xml-detalle='nombreDocUser']:before,
    [data-preview="S"] .numeracion[data-xml-detalle='marcadorBloque']:before{
        position: relative;
        background-size: contain;
        background-repeat: no-repeat;
        top: 2px;
    	width: 12px;
    	height: 12px;
    	content: '';
    	margin-left: 2px;
        margin-right: 2px;
        display: inline-block;
    }
    [data-preview="S"] .marca_BD:before{
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .marca_texto:before{
        background-image: url("data:image/svg+xml;base64,");
    
    }
    [data-preview="S"] .numeracion[data-xml-detalle='reglas']:before,
    [data-preview="S"] .reglaInformativa:before{
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .numeracion[data-xml-detalle='fechaDocUser']:before{
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .numeracion[data-xml-detalle='nombreDocUser']:before{
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .numeracion[data-xml-detalle='marcadorBloque']:before{
        background-size: cover;
        width: 19px;
    	height: 16px;
        vertical-align: baseline;
        background-image: url("data:image/svg+xml;base64,")
    }
    [data-preview="S"] .numeracion[data-xml-detalle='PDFExterno']:before{
        display: inline-block;
        background-size: contain;
        background-repeat: no-repeat;
        width: 36px;
    	height: 32px;
    	content: '';
    	vertical-align: middle;
        background-image: url("data:image/svg+xml;base64,");
    }
    
}
/* FIN REPRESENTACION MARCAS EN PREVISUALIZACION **********************/

/* COMENTARIOS EN PREVISUALIZACION **********************/
 @media print { 
    [data-preview="S"] .pagina {
        flex-direction: column;
    }
    /* Comentario modelo */
    [data-preview="S"] .comentarioModelo {
        position: relative;
        margin-bottom: 32px;
        border: 1px solid #332687;
        border-top: 3px solid;
        background-size: 12px 12px;
        background-color: #d4cff2;
        background-image: repeating-linear-gradient(-45deg, #cdc7ef 0, #cdc7ef 1px, #d4cff2 0, #d4cff2 50%);
        padding: 16px 16px 16px 40px;
        color: #332687;
        font-family: 'OpenSans_iberdok', Verdana, 'Source_Sans_Pro_Regular', Arial, Helvetica, sans-serif;
        font-size: 11px;
    }
    [data-preview="S"] .comentarioModelo:before {
        content: '';
        position: absolute;
        top: 16px;
        left: 16px;
        width: 16px;
        height: 16px;
        background-size: 16px;
    }
    
    /* Comentario marco */
    [data-preview="N"] div[data-nombre="div-user"][data-id-comentario]:before {
        content: ' ';
        position: absolute;
        left: -1px;
        bottom: -27px;
        display: block;
        width: 100%;
        height: 18px;
        border-right: 1px solid #332687;
        border-bottom: 1px solid #332687;
        border-bottom: 1px solid #332687;
        background-color: white;
        
        content: attr(data-id-comentario);
    }
    [data-preview="N"] div[data-nombre="div-user"][data-id-comentario]:after {
        content: attr(data-id-comentario);
        position: absolute;
        bottom: -26px;
        right: 1px;
        display: inline-block;
        height: 14px;
        border-bottom-right-radius: 3px;
        border-top-left-radius: 5px;
        background-color: #332687;
        padding: 2px 8px;
        color: #ffffff;
        font-family: 'OpenSans_iberdok', Verdana, 'Source_Sans_Pro_Regular', Arial, Helvetica, sans-serif;
        font-size: 8pt;
        line-height: 1.5;
    }
    [data-preview="S"] .comentarioMarco {
        display: inline-block;
        position: relative;
        margin: 0;
        width: calc(100% + 2px);
        width: 100%;
        border: 1px solid #332687;
        border-top-right-radius: 5px;
        border-top-left-radius: 5px;
        background-size: 12px 12px;
        background-color: #f1effb;
        background-image: repeating-linear-gradient(-45deg, #e9e7f8 0, #e9e7f8 1px, #f1effb 0, #f1effb 50%);
        color: #332687;
        font-family: 'OpenSans_iberdok', Verdana, 'Source_Sans_Pro_Regular', Arial, Helvetica, sans-serif;
        
        font-size: 11px;
        text-align: left;
        overflow: hidden;
        padding: 20px 15px 6px 15px;
    }
    [data-preview="S"] .comentarioMarco:before {
        position: absolute;
        top: -1px;
        left: -1px;
        border: 1px solid #332687;
        background-color: #332687;
        color: #ffffff;
        font-family: 'OpenSans_fontsIberdok', Verdana, 'Source_Sans_Pro_Regular', Arial, Helvetica, sans-serif;
        font-size: 8pt;
        content: attr(data-id-comentario);
        border-top-left-radius: 5px;
        border-bottom-right-radius: 5px;
        padding: 0px 8px;
    }
    [data-preview="S"] .comentarioMarcoEnd {
        position: relative;
        display: block;
        width: calc(100% + 2px);
        width: 100%;
        height: 20px;
        margin: 4px 0 10px;
        clear: both;
    }
    [data-preview="S"] [data-tipomarco="img"] .comentarioMarcoEnd {
        position: static;
    }
    [data-preview="S"] .comentarioMarcoEnd:before {
        content: ' ';
        position: absolute;
        left: 0;
        bottom: 0;
        display: block;
        width: 100%;
        height: 18px;
        border-left: 1px solid #332687;
        border-right: 1px solid #332687;
        border-bottom: 1px solid #332687;
        border-bottom-left-radius: 5px;
        border-bottom-right-radius: 5px;
        box-sizing: border-box;
    }
    [data-preview="S"] .comentarioMarcoEnd:after {
        content: attr(data-id-comentario);
        position: absolute;
        bottom: 1px;
        right: 0;
        display: inline-block;
        height: 14px;
        border-bottom-right-radius: 3px;
        border-top-left-radius: 5px;
        background-color: #332687;
        padding: 2px 8px;
        color: #ffffff; 
        font-family: arial;
        font-size: 8pt;
        line-height: 1.5;
    }
    [data-preview="S"] .comentarioMarcoDependencia {
        border-radius: 3px;
        background-color: rgba(51, 38, 135, 0.2);
        padding: 10px 20px;
        font-size: 11px;
        
        width: 100%;
        min-width: 220px;
    }
    [data-preview="S"] .comentarioMarcoDependencia ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    [data-preview="S"] .comentarioMarcoDependencia .marcaInformativa, 
    [data-preview="S"] .comentarioMarcoDependencia .reglaInformativa {
        background-color: white !important;
        border: 1px solid #333 !important;
        border-radius: 3px;
        color: #333 !important;
        cursor: default !important;
    }
    [data-preview="S"] .comentarioMarcoDependencia .marcaInformativa:before,
    [data-preview="S"] .comentarioMarcoDependencia .reglaInformativa:before {
        width: 12px;
        height: 12px;
    }
    
    /* Comentario elemento */
    [data-preview="S"] .comentarioElemento {
        margin-left: -1px;
        border: 1px solid #332687;
        border-radius: 3px;
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        background-size: 12px 12px;
        background-color: #f1effb;
        background-image: repeating-linear-gradient(-45deg, #e9e7f8 0, #e9e7f8 1px, #f1effb 0, #f1effb 50%);
        padding: 0 4px;
        color: #332687;
        white-space: pre-wrap;
        text-align: left;
    }
    [data-preview="S"] .comentarioElemento:before {
        content: '';
        display: inline-block;
        position: relative;
        top: 2px; 
        width: 12px;
        height: 12px;
        margin-right: 4px;
        background-size: 14px;
    }
    [data-preview="S"] .comentarioModelo:before,
    /* [data-preview="S"] .comentarioMarco:before, */
    [data-preview="S"] .comentarioElemento:before {
        background-image: url("data:image/svg+xml;base64,")
    }
 
    [data-preview="S"] .marca_texto, 
    [data-preview="S"] .marca_BD, 
    [data-preview="S"] .numeracion {
        padding-top: 0 !important;
    }
    [data-preview="S"] .marca_texto[data-comentario-pdf="si"]:before, 
    [data-preview="S"] .marca_BD[data-comentario-pdf="si"]:before, 
    [data-preview="S"] .numeracion[data-xml-detalle='reglas'][data-comentario-pdf="si"]:before {
        display: none !important;
        background-image: none !important;
    }
    [data-preview="S"] .marca_texto[data-comentario-pdf="si"] .elementoNombre:before,
    [data-preview="S"] .marca_BD[data-comentario-pdf="si"] .elementoNombre:before, 
    [data-preview="S"] .numeracion[data-xml-detalle='reglas'][data-comentario-pdf="si"] .elementoNombre:before {
        content: '';
        display: inline-block;
        position: relative;
        top: 2px; 
        width: 12px;
        height: 12px;
        margin-left: 2px;
        margin-right: 2px;
        background-size: contain;
        background-repeat: no-repeat;
        padding-left: 2px;
        padding-right: 2px;
    }
    [data-preview="S"] .marca_texto .elementoNombre:before{
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .marca_BD .elementoNombre:before {
        background-image: url("data:image/svg+xml;base64,");
    }
    [data-preview="S"] .numeracion[data-xml-detalle='reglas'] .elementoNombre:before {
        background-image: url("data:image/svg+xml;base64,");
    }
 } 
/* FIN COMENTARIOS EN PREVISUALIZACION **********************/


/*****************/
/* ACCESIBILIDAD */
/*****************/
input[data-a11y] {
    display: none;
}

body.editor input[data-a11y] {
    width: 1px; 
    height: 1px; 
    border: 0px; 
    padding: 0px; 
    font-size: 0px; 
    position: absolute;
    background-color: rgba(255, 255, 255, 0);
    outline: none! important;
    display: inline-block;
}

/*****************/
/* WORKTRAY      */
/*****************/
@media screen {
    div[data-wt-ocultar="1"] {
     display: none !important;
   }
}
@media print {
    div[data-wt-ocultar="1"] {
     display: none !important;
   }
}

/*****************/
/* WATERMARKS    */
/*****************/
div[data-nombre='watermark'] {
	height: 100%; 
	position: absolute;
	background-repeat: no-repeat;
}

@media print {
	div[data-nombre='watermark'] { 
		background-repeat: repeat-y;
	}
