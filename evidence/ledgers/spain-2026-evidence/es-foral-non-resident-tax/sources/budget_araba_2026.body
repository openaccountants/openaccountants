/***************************/
/** Numeracion de titulos **/
/***************************/

.tituloRoca.titulo_nivel_1.titulo_numerado:before,
.tituloRoca.titulo_nivel_2.titulo_numerado:before,
.tituloRoca.titulo_nivel_3.titulo_numerado:before{
    position: absolute;
    left: 0;
}

/***************************/



/*************************/
/** Tabla de contenidos **/
/*************************/

.tabla_contenidos{
    float: left;
    counter-reset: contador_toc_nivel_1;
}

.tabla_contenidos .tc_titulo_nivel_1:before,
.tabla_contenidos .tc_titulo_nivel_2:before,
.tabla_contenidos .tc_titulo_nivel_3:before{
	content: '............................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................................';
	overflow: hidden;
	position: absolute;
	bottom: 1px;
	left: 0;
	float: left;
	width: 100%;
	height: 1em;
	z-index: 0;
}
.tabla_contenidos .tc_titulo_nivel_1 .texto_titulo,
.tabla_contenidos .tc_titulo_nivel_2 .texto_titulo,
.tabla_contenidos .tc_titulo_nivel_3 .texto_titulo{
    /*float: left;*/
	z-index: 5;
	position: relative;
	background-color: #FFFFFF;
	display: inline;
	width: auto;
	/*white-space: nowrap;*/
}
.tabla_contenidos .tc_titulo_nivel_1 .pagina_titulo,
.tabla_contenidos .tc_titulo_nivel_2 .pagina_titulo,
.tabla_contenidos .tc_titulo_nivel_3 .pagina_titulo{
    float: right;
	z-index: 5;
	position: relative;
	background-color: #FFFFFF;
	display: inline;
	width: auto;
	/*white-space: nowrap;*/
}
.tabla_contenidos .tc_titulo_nivel_1.titulo_reset_niveles{
	counter-reset: contador_toc_nivel_1 1 contador_toc_nivel_2 0 contador_toc_nivel_3 0;
}
.tabla_contenidos .tc_titulo_nivel_2.titulo_reset_niveles{
	counter-reset: contador_toc_nivel_2 1 contador_toc_nivel_1 0 contador_toc_nivel_3 0;
}
.tabla_contenidos .tc_titulo_nivel_3.titulo_reset_niveles{
	counter-reset:  contador_toc_nivel_3 1 contador_toc_nivel_1 0 contador_toc_nivel_2 0;
}
.tabla_contenidos .tc_titulo_nivel_1{
    float: left;
    width: 100%;
    position: relative;
    counter-reset: contador_toc_nivel_2;
    padding: 0 !important;
}
.tabla_contenidos .tc_titulo_nivel_1:not(.titulo_reset_niveles){
    counter-increment: contador_toc_nivel_1;
}
.tabla_contenidos .tc_titulo_nivel_2{
    float: left;
    width: 100%;
    position: relative;
    counter-reset: contador_toc_nivel_3;
    padding: 0 !important;
}
.tabla_contenidos .tc_titulo_nivel_2:not(.titulo_reset_niveles){
    counter-increment: contador_toc_nivel_2;
}
.tabla_contenidos .tc_titulo_nivel_3{
    float: left;
    width: 100%;
    position: relative;
    padding: 0 !important;
}
.tabla_contenidos .tc_titulo_nivel_3:not(.titulo_reset_niveles){
    counter-increment: contador_toc_nivel_3;
}

/*********/
/* MAPAS */
/*********/
.mapasContainer {
  position: relative;
  clear: both;
  float: left;
  width: 100%;
}
.mapasContainer svg.mapa {
  float: left;
  margin: 10px;
  padding: 0;
  border: 1px solid;
}
.mapasContainer div.tooltip {
  position: absolute;
  background-color: #ccb9bb;
  font-family: sans-serif;
  border: 1px solid #310a0e;
  border-radius: 5px;
  color: #310a0e;
  font-weight: bold;
  padding: 4px 8px;
  text-align: center;
  display: none;
}
.mapasContainer .mapaSelect {
  float: left;
  margin: 2% 0;
}
.mapasContainer .mapaSelect select {
  margin-left: 1%;
  width: 90%;
  padding: 2px;
}
.mapasContainer.legend svg{
  position: relative;
  top: 0;
  left: 0;
  font-size: 1em;
}
/*********/
/* FIN MAPAS */
/*********/

/*********/
/* MAPAS GOOGLE */
/*********/
.mapaGoogle {
	height: 100%;
	width: 100%;
	float: left;
}
.indicacionesMapa {
	
    width: 30%;
    height: 100%;
    overflow: auto;
    background-color: white;
}
.addTuPosicion{
    position: relative;
    top: -32px;
    margin: 0 auto;
    z-index: 999999999;
    float: right;
    background-image: url('data:image/png;base64,');
    height: 28px;
    width: 28px;
    background-color: white;
    background-position: 50% 50%;   
    border-radius: 2px;
}
/*********/
/* FIN MAPAS GOOGLE */
/*********/

/*****NUEVAS LISTAS******/
.newListIberdok{  
  position: relative;
  padding-left: 10mm;
} 
.listLevel{
  position: absolute;
  left:0;
  pointer-events: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}
div[data-estilopropio="iberdokAlineacion"], .estiloIberdokAliIzq, .estiloIberdokAliDcha, .estiloIberdokAliCent, .estiloIberdokAliJust, div[class*='sangria'], div[class*='estiloIberdokInter'], .newListIberdok{
   clear:both; 
}
.newListIberdok:not([data-mascara*="1"]):not([data-mascara*="a"]):not([data-mascara*="i"]) > .listLevel,
.newListIberdok:not([data-mascara*="1"]):not([data-mascara*="a"]):not([data-mascara*="i"]) > .listLevel span{
    font-family: 'Iconosib_fontsIberdok' !important;
}
/*****FIN NUEVAS LISTAS******/

