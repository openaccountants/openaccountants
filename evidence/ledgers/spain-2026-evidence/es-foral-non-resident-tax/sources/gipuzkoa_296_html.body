			<div class="sidebar-progress" id="progress">
<div class="wrapper"> </div>
</div>
<script language="javascript">

var menuDone=false;

Liferay.on(
  'allPortletsReady',doAutoMenu);

function doAutoMenu() {
  if(menuDone) return;
  menuDone=true;
  noIdAttrCont=0;
  var progressObj = $("#progress");
  progressObj.find('.wrapper').append('<div id="izfe-menu-lateral-heading"><p class="d-flex text-blue-dark izfe-semibold justify-content-between izfe-h4"></p></div>');
  if ($('#layout-column_column-3').find('h2').length > 0) {
	progressObj.find('.wrapper').append('<ul class="selectdropdown numbered-list blocked-numbered-list"></ul>');
  }
  $.each($('#layout-column_column-3').find('h2') , function (index, item){
    if(!$(item).attr('id')){
      var generatedId = 'generated-id-'+ noIdAttrCont;
      $(item).attr('id', generatedId);
      noIdAttrCont++;
    }
    progressObj.find('.selectdropdown').append('<li class="content"><a href="#' + $(item).attr('id')  + '">' + $(item).text() + '</a><div class="bar"><span>&nbsp;</span></div></li>')
  });

  var wrapper_top = $(".sidebar-progress .wrapper").offset().top;
  $(window).scroll(function (){
    var wrapper_height = $(".sidebar-progress .wrapper").height();

    var top = $(this).scrollTop();
    if (top > wrapper_top - 10) {
      $(".sidebar-progress .wrapper").addClass("affix");
    }
    else {
      $(".sidebar-progress .wrapper").removeClass("affix");
    }


    $("h2").parent().each(function(i){
      var this_top = $(this).offset().top;
      var height = $(this).height();
      var this_bottom = this_top + height;
      var percent = 0;

      if (top >= this_top && top <= this_bottom) {
        percent = ((top - this_top) / (height - wrapper_height)) * 100;
        if (percent >= 100) {
          percent = 100;
          $(".sidebar-progress .wrapper .bar:eq("+i+") i").css("color", "#fff");
        }
        else {
          $(".sidebar-progress .wrapper .bar:eq("+i+") i").css("color", "#36a7f3");	  				  				
        }
      }
      else if (top > this_bottom) {
        percent = 100;
        $(".sidebar-progress .wrapper .bar:eq("+i+") i").css("color", "#fff");
      }
      $(".sidebar-progress .wrapper .bar:eq("+i+") span").css("width", percent + "%");
    });
  });

  $(".wrapper .bar a").click(function (e){
    e.preventDefault();

    var hash = this.hash.substr(1);
    $('html, body').animate({
      scrollTop: $("#"+ hash).offset().top - 10
  }, 500);

  });

}

window.setTimeout(doAutoMenu, 500);


</script>
		</div>

		

	




							
