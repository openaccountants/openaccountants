  border-width:0;
  outline-width:0;
  padding:3px 0 2px
}
.textboxlist-input-container input {
  margin-bottom:4px;
  margin-top:3px
}
.textboxlistentry-holder {
  list-style:none;
  margin:0
}
.textboxlistentry-holder li {
  float:left;
  line-height:1;
  margin:0 5px 4px 0
}
.textboxlistentry {
  background-color:#dee7f8;
  border:1px solid #cad8f3;
  padding:7px 11px;
  position:relative
}
.textboxlistentry-focused {
  background-color:#598bec;
  border-color:#224fa8;
  color:#FFF;
  outline-width:0
}
.textboxlistentry-focused .textboxlistentry-remove {
  background-color:#FFF
}
.textboxlistentry-remove,
.textboxlistentry-text {
  vertical-align:middle
}
.textboxlistentry-remove {
  border-radius:50%;
  color:#d21212;
  cursor:pointer;
  margin-left:5px;
  padding:1px;
  text-align:center
}
.textboxlistentry-remove .icon-remove {
  margin-top:0
}
.textboxlistentry-remove-hover {
  background-color:#cad8f3
}

.textboxlistentry,
.textboxlistentry-close {
  -moz-border-radius:14px;
  -webkit-border-radius:14px;
  border-radius:14px
}
.aui .table-striped tbody > tr:nth-child(2n+1) > td, 
.aui .table-striped tbody > tr:nth-child(2n+1) > th {
  background-color: #f2f2f2 !important;
  border-radius: 0 !important;
  border: 0 !important;
}
