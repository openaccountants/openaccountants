                               $('#contenedor * a').attr("tabindex", "-1");

                               $('#contenedor * input').attr("tabindex", "-1");

                               $('#contenedor * button').attr("tabindex", "-1");

                                $('#contenedor * select').attr("tabindex", "-1");

                }

                $("#barraaceptacion .enlaceboton").on("click", function() {

