                               $('#contenedor * a').removeAttr("tabindex");

                               $('#contenedor * input').removeAttr("tabindex");

                               $('#contenedor * button').removeAttr("tabindex");

                               $('#contenedor * select').removeAttr("tabindex");

                });

}

});;


