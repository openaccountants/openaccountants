<script type="text/javascript" language="javascript">
	function mostrarRespuesta(val)
	{
		var itemS = "Resp" + val ; 
		var itemLI = "LiResp" + val ; 
		if(document.getElementById(itemS).style.display == 'none'){
			document.getElementById(itemS).style.display = '';
			document.getElementById(itemLI).className = document.getElementById(itemLI).className.replace(/(?:^|\s)ogamas(?!\S)/g, " ogamenos");
		}else{
			document.getElementById(itemS).style.display = 'none';
			document.getElementById(itemLI).className = document.getElementById(itemLI).className.replace(/(?:^|\s)ogamenos(?!\S)/g, " ogamas");
		}		
	}
</script>

