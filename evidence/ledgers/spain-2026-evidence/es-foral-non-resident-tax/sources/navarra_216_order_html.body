gn=top >   &nbsp;</p><p class=XA1></td>  </tr> </table></p><p class=XA1></p><p class=XA1><table border=1 cellspacing=0 cellpadding=0  >  <tr>   <td colspan=3 valign=top >   LIQUIDACIÓN</p><p class=XA1></td>  </tr>  <tr>   <td colspan=3 valign=top >   Rentas sometidas a retención/ingreso   a cuenta</p><p class=XA1></td>  </tr>  <tr>   <td colspan=3 valign=top >   Número de rentas</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Dividendos y otras rentas de   participación en fondos propios de entidades</p><p class=XA1></td>   <td valign=top >   21</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Resto de rentas</p><p class=XA1></td>   <td valign=top >   22</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Totales</p><p class=XA1></td>   <td valign=top >   23</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr> </table></p><p class=XA1></p><p class=XA1><table border=1 cellspacing=0 cellpadding=0  >  <tr>   <td valign=top >   Base de retenciones e ingresos   a cuenta</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Dividendos y otras rentas de participación   en fondos propios de entidades</p><p class=XA1></td>   <td valign=top >   24</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Resto de rentas</p><p class=XA1></td>   <td valign=top >   25</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr>  <tr>   <td valign=top >   Totales</p><p class=XA1></td>   <td valign=top >   26</p><p class=XA1></td>   <td valign=top >   &nbsp;</p><p class=XA1></td>  </tr> </table></p><p class=XA1></p><p class=XA1><table border=1 cellspacing=0 cellpadding=0  >  <tr>   <td valign=top >   Retenciones e ingresos a   cuenta</p><p class=XA1></td>   <td valign=top >