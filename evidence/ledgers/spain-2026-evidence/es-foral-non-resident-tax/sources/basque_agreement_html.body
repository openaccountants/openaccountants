              <input type="hidden" name="id" value="BOE-A-2002-9969">
              <input type="hidden" name="b"  value="56">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab5620250430" value="20250430" checked="checked"/>
                  <label for="lab5620250430" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 30/04/2025, en vigor a partir del 01/05/2025.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab5620220209" value="20220209"/>
                  <label for="lab5620220209" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 09/02/2022, en vigor a partir del 10/02/2022.</label>
                </p>
