                  <input type="radio" name="p" onclick="this.form.submit()" id="lab5620020524" value="20020524"/>
                  <label for="lab5620020524" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 24/05/2002, en vigor a partir del 25/05/2002.</label>
