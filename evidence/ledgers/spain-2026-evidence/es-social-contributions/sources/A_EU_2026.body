                              <tr>
                                <td>
                                  <p class="cuerpo_tabla_centro">b)</p>
                                </td>
                                <td>
                                  <p class="cuerpo_tabla_izq">artículo 50, apartado 2;</p>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                          <p class="cuerpo_tabla_centro"> </p>
                          <p class="cuerpo_tabla_centro"> </p>
