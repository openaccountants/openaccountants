                              <tr>
                                <td>
                                  <p class="cuerpo_tabla_centro">e)</p>
                                </td>
                                <td>
                                  <p class="cuerpo_tabla_izq">artículo 87 <span>bis</span>, apartado 2;</p>
                                </td>
                              </tr>
                            </tbody>
