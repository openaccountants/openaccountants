                              <tr>
                                <td>
                                  <p class="cuerpo_tabla_centro">f)</p>
                                </td>
                                <td>
                                  <p class="cuerpo_tabla_izq">artículos 87 <span>ter</span>, 88, 88 <span>bis</span>, 88 <span>ter</span> y 88 <span>quater</span>;</p>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                          <p class="cuerpo_tabla_centro"> </p>
                          <p class="cuerpo_tabla_centro"> </p>
