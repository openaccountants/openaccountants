                                <td>
                                  <p class="cuerpo_tabla_centro">g)</p>
                                </td>
                                <td>
                                  <p class="cuerpo_tabla_izq">anexos I, II, III, IV, VI, VIII, IX, X y XI.</p>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <table class="sinbordes">
                    <colgroup>
