<script>
addClassToBody('ss-s-guia-colectivo');

function busquedaGuiaAction() {
    var palabraBusqueda = $('#form_busqueda_guia input[name=palabraBusqueda]').val();
    console.log("palabraBusqueda: " + palabraBusqueda);	
     setCookie("palabraBusqueda",palabraBusqueda,1);     
     $('#form_busqueda_guia input[name=search_query]').val(palabraBusqueda+ ' +contentpath::"/Importass_Contenidos/Colectivos/Trabajo Autonomo/Guia" +authoringtemplate::"PC_FAQ" ');  
console.log("search_query: " + $('#form_busqueda_guia input[name=search_query]').val());	
       return true;
}
</script>


