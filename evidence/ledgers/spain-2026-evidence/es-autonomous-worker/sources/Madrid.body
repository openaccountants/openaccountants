                  <input type="radio" name="p" onclick="this.form.submit()" id="lab5020101025" value="20101025"/>
                  <label for="lab5020101025" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Texto original, publicado el 25/10/2010, en vigor a partir del 26/10/2010.</label>
                </p>
              </fieldset>
