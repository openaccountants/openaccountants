                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2020131129" value="20131129" checked="checked"/>
                  <label for="lab2020131129" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 29/11/2013, en vigor a partir del 30/11/2013.</strong></label>
