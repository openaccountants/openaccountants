          <div class="bloque" id="tv">
            <p class="bloque">[Bloque 47: #tv]</p>

<h4 class="titulo_num">TÍTULO V</h4>
<h4 class="titulo_tit">La Zona Especial Canaria</h4>

          </div>
          <p class="linkSubir"><a href="#top">Subir</a></p>
          <hr class="bloque"/>
          <div class="bloque" id="ci-3">
            <p class="bloque">[Bloque 48: #ci-3]</p>

<h4 class="capitulo_num">CAPÍTULO I</h4>
<h4 class="capitulo_tit">Creación, vigencia y ámbito de la Zona Especial Canaria</h4>
<blockquote>
  <p class="nota_pie">Se modifica por el art. 1.1 del Real Decreto-Ley 2/2000, de 23 de junio. <a href="/buscar/doc.php?id=BOE-A-2000-11832" target="_blank" title="Abre nueva ventana">Ref. BOE-A-2000-11832</a>.</p>
</blockquote>

            <form class="lista formBOE" method="GET" action="/buscar/act.php#ci-3">
              <input type="hidden" name="id" value="BOE-A-1994-15794">
              <input type="hidden" name="b"  value="48">
              <input type="hidden" name="tn" value="1">
              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab4820000624" value="20000624" checked="checked"/>
