        <a title="Libro electrónico de BOE-A-2017-10042" href="/diario_boe/epub.php?id=BOE-A-2017-10042">EPUB</a>
      </li>
      <li class="puntoXML">
        <a target="_blank" title="Texto y metadatos en formato XML" href="/diario_boe/xml.php?id=BOE-A-2017-10042">XML</a>
      </li>
