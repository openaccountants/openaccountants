	                	Auswahl akzeptieren
	                </button>
	                <button id="cb-acceptall" type="button" aria-label="Alle Cookies akzeptieren" class="btn min-h-[44px] py-xxs px-sm flex justify-center items-center focus:underline hover:underline bg-blue text-white hover:bg-blue-darker">
