    <div class="l-module__content">
      <div class="row small-up-1 medium-up-2 large-up-3"><div class="column">
<div class="c-teaser c-teaser--TextFragment c-teaser--grid3">
  <a class="c-teaser__link c-teaser__link--TextFragment c-teaser__link--spaced" href="https://www.bzst.de/DE/Unternehmen/Kapitalertraege/Kapitalertragsteuerentlastung/Vorschriften/vorschriften_node.html" >
