frame-layout-0
frame-space-before-medium






 position-relative"
     id="c79"><div class="container header-underline"><ul class="row row-cols-1 row-cols-md-2 row-cols-lg-2 row-cols-xl-2 list-unstyled"><li class="col"><!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c288" class="frame frame-default frame-type-image frame-layout-0 "><div class="textpic topleft"><div class="ce-gallery" data-images="1"><div data-count="0" class="image-wrapper "><figure class="figure"><picture class="" data-aspectratio-lg="NaN" data-aspectratio-md="NaN" data-aspectratio-sm="NaN" data-aspectratio-xl="NaN" data-aspectratio-xs="NaN"><img class="figure-img img-fluid" src="/fileadmin/icons/blue/xrechnung.svg" width="80" height="80" alt="Icon eines XML-Dokuments für die XRechnung" title="XRechnung" loading="lazy" /></picture></figure></div></div></div></div></li><li class="col"><!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c289" class="frame frame-default frame-type-image frame-layout-0 "><div class="textpic topleft"><div class="ce-gallery" data-images="1"><div data-count="0" class="image-wrapper "><figure class="figure"><picture class="" data-aspectratio-lg="NaN" data-aspectratio-md="NaN" data-aspectratio-sm="NaN" data-aspectratio-xl="NaN" data-aspectratio-xs="NaN"><img class="figure-img img-fluid" src="/fileadmin/icons/blue/kanaele.svg" width="80" height="80" alt="Icon eines Briefkastens für Kommunikationskanäle" title="Kanäle" loading="lazy" /></picture></figure></div></div></div></div></li><li class="col"><!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c80" class="frame frame-default frame-type-text frame-layout-0 "><div class="header-content"><h3 class=" "><span id="element-80-header">Vorteile für Rechnungssteller</span></h3></div><div class="text"><div class="ce-bodytext"><ul><li data-list-item-id="ed5c8c7175fea9f1ba51904c4b93eb2e0">Vereinfachte Rechnungsstellung</li><li data-list-item-id="e7d93419918e99b3a9927993ac286f03b">Verkürzte Durchlaufzeiten</li><li data-list-item-id="e6623db1eeae6ddb48a1fe7f655f93cd1">Schnellere Bearbeitung und pünktlichere Zahlung</li><li data-list-item-id="ea207757b00ba594c7eef4cda4b2fcd34">Einsparpotenziale im Rechnungsversand durch Einsparen von Papier und Porto</li><li data-list-item-id="e580d40fc8f11e255980a76df11c734e2">Steigerung der Prozessqualität durch automatische Erstellung und Validierung von Rechnungen</li><li data-list-item-id="ec6eeb3053f36970ec7004273fabf70b2">Flexibles Arbeiten durch ortsunabhängige Rechnungsstellung</li></ul></div></div></div></li><li class="col"><!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c81" class="frame frame-default frame-type-text frame-layout-0 "><div class="header-content"><h3 class=" "><span id="element-81-header">Vorteile für Rechnungsempfänger</span></h3></div><div class="text"><div class="ce-bodytext"><ul><li data-list-item-id="eb3b913045afce781ef1ef72d85412ed4">Optimierung der Rechnungsverarbeitung durch automatisiertes Einlesen der Rechnungsdaten</li><li data-list-item-id="ec84e0495fee261ece6cbb82941c6fe28">Steigerung der Datenqualität durch verringerte Fehleranfälligkeit</li><li data-list-item-id="ef89ab0935415946a1c5e7e0cf5c3c302">Einsparpotenziale in der Rechnungsverarbeitung</li><li data-list-item-id="ed8f611669b88805bb4d5b353d502f7ba">Ermöglichen einer dezentralen Rechnungsbearbeitung</li><li data-list-item-id="e64be3d3d0d2a2f7cca15cb6aa98998c8">Flexibles Arbeiten durch ortsunabhängige Rechnungsstellung</li></ul></div></div></div></li></ul></div></div></div></div></div>




