</div>
										



				<div class="global-help__block"><h3 class="global-help__blockTitle" id="HelpKSt2025HinweisezurAnlageGR">Hinweise zur Anlage GR</h3> <div class="toggleBox toggleBox--closed" data-selector="toggleBox" id="kstgrue1"  ><h4 class="toggleBox__head"><span class="toggleBox__headButton" data-selector="_toggleBoxHeadButton" title="aufklappen" role="button" aria-expanded="false"><span class="icon"><span class="icon__svg svg-arrow_small--invert"></span></span><span class="toggleBox__title">Allgemeine Angaben</span></span></h4><div class="toggleBox__content" data-selector="_toggleBoxContent">
