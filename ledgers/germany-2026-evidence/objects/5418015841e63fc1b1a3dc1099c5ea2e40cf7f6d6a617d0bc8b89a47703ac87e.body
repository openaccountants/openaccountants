<script>$(function() {
    $('#disclaimerDiv').each(function() {
        if (getCookieValue('disclaimer') != 'approved') {
            $(this).show();
        }
    });
})

function getCookieValue(a) {
    var b = document.cookie.match('(^|;)\\s*' + a + '\\s*=\\s*([^;]+)');
    return b ? b.pop() : '';
}

function setDisclaimerCookie(){
    document.cookie = "disclaimer=approved";
    $('#disclaimerDiv').hide();
}
function setDisclaimerRead(){
    $('#disclaimerDiv').hide();
}</script>
