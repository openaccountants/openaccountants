 position-relative"
     id="c984">

    

    
        <div class="grid-bg bg-color_3"></div>
    

    

    <div class="container header-underline">

    
        


        
    

    




    

    
    
        
            

<!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c985" class="frame frame-default frame-type-textpic frame-layout-0 grid-light teaser-headline-contrast "><div class="textpic nexttotext-right d-lg-flex"><div class="ce-gallery ms-md-5 order-1" data-images="1"><div data-count="0" class="image-wrapper "><figure class="figure"><picture class="" data-aspectratio-lg="NaN" data-aspectratio-md="NaN" data-aspectratio-sm="NaN" data-aspectratio-xl="NaN" data-aspectratio-xs="NaN"><img class="figure-img img-fluid" src="/fileadmin/illustrations/Illustration-kanaele-email.svg" width="434" height="284" alt="" loading="lazy" /></picture></figure></div></div><div class="ce-bodytext"><div class="header-content"><h1 class=" " id="headerMain"><span id="element-985-header">Der Über­tragungs­­kanal: E‑Mail</span></h1></div><p>Hier erfahren Sie, was es bei der Nutzung des Übertragungskanals E-Mail an der Rechnungseingangsplattform OZG-RE des Bundes zu beachten gilt.</p></div></div></div>


        
    


    </div>
</div>



            </div>
        

        

        <div data-glossary="list">
            <div class="main-container container">
                <div class="row">
                    <div class="col-12">
                        <!--TYPO3SEARCH_begin-->
                        

<!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c986" class="frame frame-default frame-type-text frame-layout-0 frame-space-before-medium frame-space-after-medium "><div class="header-content"><h2 class=" "><span id="element-986-header">Allgemeine Hinweise zum Übertragungskanal “E-Mail”</span></h2></div><div class="text"><div class="ce-bodytext"><p>An der Rechnungseingangsplattform OZG‑RE werden Rechnungssendern verschiedene Übertragungskanäle zur Übermittlung von E‑Rechnungen an die Rechnungsempfänger zur Verfügung gestellt.</p></div></div></div>




<div class="frame
frame-default
frame-type-ce_container
frame-layout-0
frame-space-before-small
frame-space-after-small





 position-relative"
     id="c987">

    

    
        <div class="grid-bg bg-color_6"></div>
    

    

    <div class="container header-underline">

    
        


        
    

    




    

    
    
        
            

<!-- Do not output frame wrapper for Solr result elements inside container (ul > li must not contain a div) --><div id="c988" class="frame frame-default frame-type-text frame-layout-0 "><div class="header-content"><h3 class=" "><span id="element-988-header">Wichtige Punkte bei der Übertragung per E‑Mail</span></h3></div><div class="text"><div class="ce-bodytext"><ul><li data-list-item-id="e4ba0a5240dfc477911e215dbc9f5a188">Es darf immer nur eine E‑Rechnung pro E‑Mail versendet werden.</li><li data-list-item-id="eb239f13bec58bbd2b1fa0014c0f00aed">Sollte mehr als eine Rechnung in einer E‑Mail enthalten sein, wird die E-Mail inklusive der Anhänge verworfen. Die Rechnung kann dann nicht zugestellt werden.</li><li data-list-item-id="e2b72e4c08096621f53cdf28618e2f9e4">Sobald Anhänge versendet werden, die keine E-Rechnung im Sinne eines strukturierten Datensatzes (s. auch FAQ-Bereiche zu <a href="/faq#c711"><span class="icon"></span>E-Rechnung</a> und <a href="/faq#c754"><span class="icon"></span>XRechnung</a>) darstellen, wird die E-Mail inklusive der Anhänge verworfen. Die</li><li data-list-item-id="e128bd99b86f9e7cd5c05defc8ee8c34c">Rechnung kann dann nicht zugestellt werden.</li><li data-list-item-id="ed45926db5733d9a7e407306f873aeb0e">Es sollten keine „No Reply“-E‑Mail-Adressen verwendet werden.</li><li data-list-item-id="ea575c538e74c42b842e0ca66fad21ca1">Betreff und Text sind für die Einsendung irrelevant und werden automatisch aus der E‑Mail gelöscht und nicht an den Rechnungsempfänger weitergeleitet; sie können auch leer bleiben.</li></ul></div></div></div>


        
    


    </div>
</div>




