    <div class="column ">
      
<div class="c-teaser c-teaser--TextFragment c-teaser--no-image c-teaser--grid3">
  <a class="c-teaser__link c-teaser__link--TextFragment c-teaser__link--no-image c-teaser__link--spaced" href="https://www.bzst.de/DE/Unternehmen/Umsatzsteuer/Aufzeichnungen_47i_VO_EU/aufzeichnungen_47i_vo_node.html"  title="Aufzeichnungen nach Art. 47i VO (EU) 904/2010">
    <div class="c-teaser__head c-teaser__head--no-image">
      <h3 class="c-teaser__headline c-teaser__headline--no-image c-teaser__headline--spaced">OSS/IOSS - Aufzeichnungen nach Art. 47i VO (EU) 904/2010</h3>
    </div>
