:4869},"ld_1087","page","content-page",1087,"2025-08-29T07:52:14.000Z","2026-07-29T07:42:58.319Z",{"groupId":4843,"lang":7,"slug":4844,"teaserImage":4845,"teaserText":4847,"teaserTitle":4848,"jsonLDEntities":4849,"translationPages":4850,"publishDate":4840,"authors":4857,"federalTopic":4858,"contactData":219,"canonical":219,"description":4847,"metakeywords":4859,"robots":4860,"title":4848,"og":4861,"twitter":4863,"tagCategory":4865,"indexGlossary":4866,"typeMetadata":4867,"contactDataInformation":4868},"HhWyncMYmIA3","verrechnungssteuer",{"crops":4846,"mediaId":219,"url":219},[],"Die schweizerische Verrechnungssteuer ist eine Sicherungssteuer und beträgt in der Schweiz auf Kapitalerträgen 35% und auf Leibrenten 15%.","Verrechnungssteuer (VST)",[],[4851,4853,4855],{"lang":12,"slug":4852},"impot-anticipe",{"lang":18,"slug":4854},"anticipatory-tax",{"lang":15,"slug":4856},"imposta-preventiva",[],[2429],"Verrechnungssteuer, VST","all",{"description":219,"image":219,"title":219,"type":4862,"url":219},"article",{"card":4864,"description":219,"image":219,"site":219,"title":4848},"summary",{},{},{"publicationType":219},{},[4870,4894,4995,5074,5090,5435],{"properties":4871,"identifier":4875,"id":4876,"nestedContent":4877},{"type":4872,"metaInfoType":4873,"dateInfo":4874},"detail",{"name":219},{"publicationDate":219},"lead-contentpage-with-checkbox","doc-1j4a33eml0",[4878,4885,4890],{"properties":4879,"identifier":4883,"id":4884},{"heading":4880,"label":4848,"class":4881,"anchorNav":4882},"h1","hero__title","Verrechnungssteuer-(VST)","title","doc-1j4a33eml1",{"properties":4886,"identifier":4888,"id":4889},{"text":4887},"Melden Sie sich für die Verrechnungssteuer (VST) an oder fordern Sie diese hier zurück. Hier finden Sie alles zur Verrechnungssteuer: Formulare, Zinssätze, Informationen zur Deklarationspflicht, alle Kreisschreiben, Rundschreiben und Wegleitungen zur Verrechnungssteuer oder Informationen zu ausländischen Quellensteuern nach Ländern geordnet. ","p","doc-1j4a33eml4",{"properties":4891,"identifier":4888,"id":4893},{"text":4892},"Die Verrechnungssteuer besteuert in der Schweiz Kapitalerträge, Lottogewinne, Leibrenten, Pensionen und Versicherungsleistungen.\u003Cbr />","doc-1j4a33eml5",{"properties":4895,"identifier":4899,"id":4900,"nestedContent":4901},{"sectionStyles":4896},{"section-variation":4897,"section-color":4898},"center--md","first-color","section","doc-1j8bc5d5q0",[4902],{"properties":4903,"identifier":4905,"id":4906,"nestedContent":4907},{"variation":4897,"anchorNavItems":4904},[],"container-grid","doc-container-grid-1793260879228-76",[4908],{"properties":4909,"identifier":4913,"id":4914,"nestedContent":4915},{"idComponent":4910,"title":219,"variant":4911,"link":4912},"teaser-grid-doc-1j8bc5u6d0","teaser-grid",null,"teaser-container","doc-1j8bc5u6d0",[4916,4930,4941,4951,4962,4974,4984],{"properties":4917,"identifier":4928,"id":4929},{"title":4918,"slug":2398,"description":4919,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4921,"metaInfo":4922,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4924,"contentIcons":4925,"contentSpecs":4926,"federalTopic":4927,"contentType":4838},"Verrechnungssteuern abrechnen","Sie möchten Ihre Verrechnungssteuern abrechnen? Am einfachsten können Sie das direkt über unser ESTV-Portal online machen. Sie brauchen hierfür ein ESTV-Portal-Login. Wählen Sie AGOV als neue Login-Methode. Hilfe finden sie unter help.eiam.swiss.","default","28. Aug.",{"type":219,"date":4923},"2025-08-28T15:25:45.000Z",[],[],{},[2429],"teaser-item","doc-1j8bc5u6d1",{"properties":4931,"identifier":4928,"id":4940},{"title":2424,"slug":2425,"description":4932,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4933,"metaInfo":4934,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4936,"contentIcons":4937,"contentSpecs":4938,"federalTopic":4939,"contentType":4838},"Hier finden Sie das Konto für das Bezahlen der Verrechnungssteuer und alles zu Fristen verlängern oder in Raten zahlen.","28. März",{"type":219,"date":4935},"2025-03-28T11:58:04.000Z",[],[],{},[2429],"doc-1j8bc64qf0",{"properties":4942,"identifier":4928,"id":4950},{"title":2430,"slug":2431,"description":4943,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4921,"metaInfo":4944,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4946,"contentIcons":4947,"contentSpecs":4948,"federalTopic":4949,"contentType":4838},"Sie möchten Ihre Verrechnungssteuer rückerstatten lassen? Als in der Schweiz oder in Deutschland ansässige Personen erledigen Sie das über unser ESTV-Portal.",{"type":219,"date":4945},"2025-08-28T15:23:46.000Z",[],[],{},[2429],"doc-1j8bc67850",{"properties":4952,"identifier":4928,"id":4961},{"title":4953,"slug":2407,"description":4954,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4921,"metaInfo":4955,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4957,"contentIcons":4958,"contentSpecs":4959,"federalTopic":4960,"contentType":4838},"Deklarationspflicht bei der Verrechnungssteuer","Auf dieser Seite finden Sie Informationen zu folgenden Themen zur Deklarationspflicht bei der Verrechnungssteuer (VST).",{"type":219,"date":4956},"2025-08-28T08:58:42.000Z",[],[],{},[2429],"doc-1j8bc85t20",{"properties":4963,"identifier":4928,"id":4973},{"title":4964,"slug":2467,"description":4965,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4966,"metaInfo":4967,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4969,"contentIcons":4970,"contentSpecs":4971,"federalTopic":4972,"contentType":4838},"Zinssätze der Verrechnungssteuer","Auf dieser Seite finden Sie die steuerlich anerkannte Zinssätze für Vorschüsse oder Darlehen in Schweizer Franken oder in Fremdwährungen nach Jahr aufgeteilt.","28. Jan.",{"type":219,"date":4968},"2025-01-28T11:22:24.000Z",[],[],{},[2429],"doc-1j8bc90750",{"properties":4975,"identifier":4928,"id":4983},{"title":4976,"slug":2473,"description":4977,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4921,"metaInfo":4978,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4979,"contentIcons":4980,"contentSpecs":4981,"federalTopic":4982,"contentType":4838},"Fachinformationen zur Verrechnungssteuer","Kreisschreiben, Rundschreiben, Merkblätter; Informationen zu Geldspiel, Kryptowährung, Meldeverfahren im Konzernverhältnis",{"type":219,"date":4956},[],[],{},[2429],"doc-1j8bc8q020",{"properties":4985,"identifier":4928,"id":4994},{"title":2553,"slug":2554,"description":4986,"imageURL":219,"imageAlt":219,"teaserType":4920,"language":7,"date":4987,"metaInfo":4988,"isPublicationDateHidden":19,"eventInfos":4912,"authors":4990,"contentIcons":4991,"contentSpecs":4992,"federalTopic":4993,"contentType":4838},"Hier finden Sie aktuelle Mitteilungen und Informationen der ESTV.","31. Okt.",{"type":219,"date":4989},"2025-10-31T08:22:22.091Z",[],[],{},[2429],"doc-1jb2u91tq0",{"properties":4996,"identifier":4899,"id":5000,"nestedContent":5001},{"sectionStyles":4997},{"section-variation":4998,"section-color":4999},"center--sm","second-color","doc-1j8bcilul0",[5002],{"properties":5003,"identifier":4905,"id":5005,"nestedContent":5006},{"variation":4998,"anchorNavItems":5004},[],"doc-container-grid-1793260879228-125",[5007],{"properties":5008,"identifier":5010,"id":5011,"nestedContent":5012},{"title":50,"link":4912,"variant":5009},"teaser-carousel","teaser-nnsb-container","doc-1j4a33eml100",[5013,5021,5027,5034,5041,5048,5055,5061,5067],{"properties":5014,"identifier":5020},{"title":5015,"slug":5016,"description":5017,"teaserType":4920,"metaInfo":5018},"MWST: Publikation der Entwürfe der Praxisfestlegungen der Hauptabteilung MWST","/de/newnsb/uiET71RqOvvE","Heute wurden zwei Entwürfe zur Mehrwertsteuer-Praxis auf der Internetseite aufgeschaltet. Die Frist zur Stellungnahme läuft bis zum 27. November 2026. Die Entwürfe bleiben jedoch auch nach der Praxis-Konsultation aufgeschaltet.",{"date":5019},"2026-10-27T10:37:13.414Z","teaser-item-nsb",{"properties":5022,"identifier":5020},{"title":4609,"slug":5023,"description":5024,"teaserType":4920,"metaInfo":5025},"/de/newnsb/u-oZ3C8iFkFY","Die Eidgenössische Steuerverwaltung hat die steuerpolitischen Vorstösse und Initiativen aktualisiert.",{"date":5026},"2026-10-26T09:51:56.381Z",{"properties":5028,"identifier":5020},{"title":5029,"slug":5030,"description":5031,"teaserType":4920,"metaInfo":5032},"Rundschreiben Nr. 221 «Quellensteuertarife 2027 (Stand 1.1.2027)»","/de/newnsb/34NvR89BFWLK","Das Rundschreiben Nr. 221 (Stand 1.1.2027) erläutert die aufgrund der kalten Progression angepassten Quellensteuertarife und Abzüge. Der Abzug des Steuerbetrags pro Kind beträgt neu CHF 264.00, der Medianwert der effektiven Lohneinkünfte liegt neu bei CHF 5'925 pro Monat.",{"date":5033},"2026-10-20T13:51:41.363Z",{"properties":5035,"identifier":5020},{"title":5036,"slug":5037,"description":5038,"teaserType":4920,"metaInfo":5039},"Amtshilfe nach FATCA: FATCA-Gruppenersuchen gemäss Artikel 12 Absatz 1 FATCA-Gesetz und Schlussverfügungen gemäss Artikel 5 Ziffer 3 litera b FATCA-Abkommen","/de/newnsb/w54IMBoHxoKn","Die Eidgenössische Steuerverwaltung hat FATCA-Gruppenersuchen gemäss Artikel 12 Absatz 1 FATCA-Gesetz und Schlussverfügungen gemäss Artikel 5 Ziffer 3 litera b FATCA-Abkommen publiziert.",{"date":5040},"2026-10-16T15:24:48.139Z",{"properties":5042,"identifier":5020},{"title":5043,"slug":5044,"description":5045,"teaserType":4920,"metaInfo":5046},"Aktualisierung der Dossiers Steuerinformationen «Subjektive Steuerpflicht»","/de/newnsb/ZPwRbDCB8cyL","Der Artikel «Subjektive Steuerpflicht» aus dem Dossier Steuerinformationen ist aktualisiert worden. Der Text erläutert die Unterschiede zwischen der beschränkten und unbeschränkten Steuerpflicht der natürlichen sowie juristischen Personen auf Bundes- und Kantonsebene. Zudem geht er auf die Ausnahmen von der subjektiven Steuerpflicht ein.",{"date":5047},"2026-10-15T06:08:40.811Z",{"properties":5049,"identifier":5020},{"title":5050,"slug":5051,"description":5052,"teaserType":4920,"metaInfo":5053},"Höchstabzüge Säule 3a im Steuerjahr 2027","/de/newnsb/6ck3kzVxBNQ4","Der maximal erlaubte Steuerabzug im Rahmen der gebundenen Selbstvorsorge (Säule 3a) beträgt neu 7373 Franken (heute 7258 Franken) für Personen, die bereits eine 2. Säule haben, beziehungsweise 36 864 Franken (heute 36 288 Franken) für Personen ohne 2. Säule. Die Anpassungen treten auf den 1. Januar 2027 in Kraft.",{"date":5054},"2026-10-05T13:51:03.908Z",{"properties":5056,"identifier":5020},{"title":2699,"slug":5057,"description":5058,"teaserType":4920,"metaInfo":5059},"/de/newnsb/GBCCzChLY5IE","Die Eidgenössische Steuerverwaltung hat die Kurslisten sowie die Listen Gratisaktien 2024, 2025 und 2026 aktualisiert.",{"date":5060},"2026-10-05T05:55:52.891Z",{"properties":5062,"identifier":5020},{"title":5015,"slug":5063,"description":5064,"teaserType":4920,"metaInfo":5065},"/de/newnsb/68G7ow8wMGgI","Heute wurden zwei Entwürfe zur Mehrwertsteuer-Praxis auf der Internetseite aufgeschaltet. Die Frist zur Stellungnahme läuft bis zum 2. November 2026. Die Entwürfe bleiben jedoch auch nach der Praxis-Konsultation aufgeschaltet.",{"date":5066},"2026-10-01T07:19:35.855Z",{"properties":5068,"identifier":5020},{"title":5069,"slug":5070,"description":5071,"teaserType":4920,"metaInfo":5072},"Aktualisierung der Dossiers Steuerinformationen «Vermögenssteuer natürlicher Personen»","/de/newnsb/wrvR47MvkDuQ","Der Artikel «Vermögenssteuer natürlicher Personen» aus dem Dossier Steuerinformationen ist aktualisiert worden. Der Text gibt einen Überblick über die Veranlagung und Erhebung der Vermögenssteuer in den Kantonen.",{"date":5073},"2026-09-24T13:47:30.618Z",{"properties":5075,"identifier":4899,"id":5077,"nestedContent":5078},{"sectionStyles":5076},{"section-variation":4998},"doc-1j8bcnt0e0",[5079],{"properties":5080,"identifier":4905,"id":5082,"nestedContent":5083},{"variation":4998,"anchorNavItems":5081},[],"doc-container-grid-1793260879228-723",[5084],{"properties":5085,"identifier":5089,"id":5088},{"heading":5086,"label":5087,"class":219,"anchorNav":5088},"h2","Fragen und Antworten zur Verrechnungssteuer","Fragen-und-Antworten-zur-Verrechnungssteuer","heading-h2",{"properties":5091,"identifier":4899,"id":5093,"nestedContent":5094},{"sectionStyles":5092},{},"doc-section-1793260879228-160",[5095],{"properties":5096,"identifier":4905,"id":5099,"nestedContent":5100},{"variation":5097,"anchorNavItems":5098},"center--xs",[],"doc-container-grid-1793260879228-621",[5101,5207,5214,5258,5263,5413,5417],{"properties":5102,"identifier":5104,"id":5105,"nestedContent":5106},{"accordionSettings":5103},"closed","accordion-container","doc-1j4a33eml19",[5107],{"properties":5108,"identifier":5111,"id":5112,"nestedContent":5113},{"accordionItems":5109},{"title":5110},"Was ist die Verrechnungssteuer?","accordion-item","doc-1j4a33eml20",[5114,5118,5122,5126,5139,5143,5147,5159,5163,5167,5171,5175,5181,5187,5191,5195,5199,5203],{"properties":5115,"identifier":4888,"id":5117},{"text":5116},"Die Verrechnungssteuer ist eine vom Bund an der \u003Cstrong>Quelle erhobene Steuer\u003C/strong> auf dem Ertrag des beweglichen Kapitalvermögens (insbesondere auf Zinsen und Dividenden), auf Gewinnen aus Geldspielen im Sinne des Geldspielgesetzes, auf Gewinnen aus Lotterien und Geschicklichkeitsspielen zur Verkaufsförderung und auf bestimmten Versicherungsleistungen. Die Steuer bezweckt als \u003Cstrong>Sicherungssteuer \u003C/strong>in erster Linie die Eindämmung der Steuerhinterziehung; die Steuerpflichtigen sollen veranlasst werden, den für die direkten Steuern zuständigen Behörden die mit der Verrechnungssteuer belasteten Einkünfte und Vermögenserträge sowie das Vermögen, auf dem die steuerbaren Gewinne erzielt wurden, anzugeben.\u003Cbr />","doc-1j4a33eml21",{"properties":5119,"identifier":4888,"id":5121},{"text":5120},"Die Verrechnungssteuer wird \u003Cstrong>unter bestimmten Voraussetzungen\u003C/strong> durch Verrechnung mit den Kantons- und Gemeindesteuern oder in bar \u003Cstrong>zurückerstattet\u003C/strong>. Der in der Schweiz wohnhafte Steuerpflichtige, seine verrechnungssteuerbelasteten Einkünfte und die entsprechenden Vermögen deklariert oder in der Buchhaltung ausweist, wird durch die Steuer somit nicht endgültig belastet.\u003Cbr />","doc-1j4a33eml24",{"properties":5123,"identifier":4888,"id":5125},{"text":5124},"Grafisch lässt sich dieser Verrechnungssteuermechanismus so darstellen:","doc-1j4a33eml25",{"properties":5127,"identifier":5137,"id":5138},{"imagePath":5128,"legend":219,"textPosition":4912,"textProportion":4912,"imageAlt":5129,"text":219,"pictureSources":5130},"https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?w=515&auto=format","Der Verrechnungssteuermechanismus",[5131,5134],{"src":5132,"media":5133},"https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=4096 4096w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=2048 2048w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=1240 1240w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=640 640w","(min-resolution: 2dppx)",{"src":5135,"media":5136},"https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=2048 2048w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=1024 1024w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=620 620w, https://prod-estvadminch-hcms-sdweb.imgix.net/dam/de/sd-web/UtYi5kPl4n4k/verrechnungssteuer-de.png?auto=format&w=320 320w","(min-resolution: 1dppx)","image","doc-1j4a33eml26",{"properties":5140,"identifier":4888,"id":5142},{"text":5141},"Die Verrechnungssteuer ist eine \u003Cstrong>Objektsteuer\u003C/strong>, d. h. sie wird ohne Rücksicht auf die wirtschaftliche Leistungsfähigkeit des Empfängers der steuerbaren Leistung erhoben.","doc-1j4a33eml27",{"properties":5144,"identifier":4888,"id":5146},{"text":5145},"Der \u003Cstrong>Steuersatz\u003C/strong> beträgt","doc-1j4a33eml28",{"properties":5148,"identifier":5157,"id":5158},{"title":219,"listTypeNegative":356,"listTypeLoose":356,"listType":4920,"listItems":5149},[5150,5153,5155],{"text":5151,"type":5152,"link":4912,"icon":4912},"\u003Cstrong>35 %\u003C/strong> auf Kapitalerträgen und Lottogewinnen,","text",{"text":5154,"type":5152,"link":4912,"icon":4912},"\u003Cstrong>15 %\u003C/strong> auf Leibrenten und Pensionen und",{"text":5156,"type":5152,"link":4912,"icon":4912},"\u003Cstrong>8 %\u003C/strong> auf sonstigen Versicherungsleistungen.","list","doc-1j4a33eml29",{"properties":5160,"identifier":4888,"id":5162},{"text":5161},"\u003Cstrong>Steuerpflichtig\u003C/strong> sind die inländischen Schuldner der steuerbaren Leistung. Sie haben auf der steuerbaren Leistung die Steuer zu entrichten und diese durch entsprechende Kürzung der Leistung auf deren Empfänger zu überwälzen.","doc-1j4a33eml33",{"properties":5164,"identifier":4888,"id":5166},{"text":5165},"Der Steuerschuldner hat sich unaufgefordert bei der Eidgenössischen Steuerverwaltung anzumelden, die vorgeschriebenen Abrechnungen und Belege einzureichen und gleichzeitig die Abgabe zu entrichten (Prinzip der Selbstveranlagung).\u003Cbr />\n Auf Steuerbeträgen, die nach ihrem Fälligkeitstermin ausstehen, ist ohne Mahnung ein Verzugszins geschuldet.","doc-1j4a33eml34",{"properties":5168,"identifier":4888,"id":5170},{"text":5169},"Der in der Schweiz domizilierte Empfänger der steuerbaren Leistung, der die Steuererklärung korrekt ausfüllt, hat unter bestimmten Voraussetzungen einen Anspruch auf \u003Cstrong>Rückerstattung der Verrechnungssteuer\u003C/strong>.","doc-1j4a33eml35",{"properties":5172,"identifier":4888,"id":5174},{"text":5173},"Die \u003Cstrong>Rückerstattung\u003C/strong> wird insbesondere \u003Cstrong>gewährt\u003C/strong>:","doc-1j4a33eml36",{"properties":5176,"identifier":5157,"id":5180},{"title":219,"listTypeNegative":356,"listTypeLoose":356,"listType":4920,"listItems":5177},[5178],{"text":5179,"type":5152,"link":4912,"icon":4912},"den \u003Cstrong>natürlichen Personen mit Wohnsitz in der Schweiz\u003C/strong>, sofern sie in der für die Staats- und Gemeindesteuern massgeblichen Steuererklärung die Vermögenswerte und die darauf erzielten Vermögenserträge ordnungsgemäss deklariert haben. Die Rückerstattung der Verrechnungssteuer an die natürlichen Personen erfolgt durch die Kantone, wobei der zurückzuerstattende Betrag in der Regel mit den kantonalen Steuern verrechnet wird.","doc-1j4a33eml37",{"properties":5182,"identifier":5157,"id":5186},{"title":219,"listTypeNegative":356,"listTypeLoose":356,"listType":4920,"listItems":5183},[5184],{"text":5185,"type":5152,"link":4912,"icon":4912},"den\u003Cstrong> juristischen Personen mit Sitz in der Schweiz\u003C/strong>, sofern sie die mit der Verrechnungssteuer belasteten Einkünfte ordnungsgemäss als Ertrag verbucht haben. Den juristischen Personen wird die Verrechnungssteuer direkt durch die Eidgenössische Steuerverwaltung zurückerstattet.","doc-1j4a33eml39",{"properties":5188,"identifier":4888,"id":5190},{"text":5189},"Der Steuerpflichtige hat innert drei Jahren nach Ablauf des Kalenderjahres, in dem die steuerbare Leistung fällig geworden ist, einen Antrag auf Rückerstattung der Verrechnungssteuer zu stellen.","doc-1j4a33eml41",{"properties":5192,"identifier":4888,"id":5194},{"text":5193},"Sind die vorgenannten Bedingungen nicht erfüllt, so entstand entweder kein Rückerstattungsanspruch, oder aber ein bestehender Anspruch wurde verwirkt. Die Rückerstattung ist ferner in allen Fällen unzulässig, in denen sie zu einer Steuerumgehung führen würde.","doc-1j4a33eml42",{"properties":5196,"identifier":4888,"id":5198},{"text":5197},"Dies ist vom Gesetzgeber gewollt, bezweckt er doch mit der Verrechnungssteuer die \u003Cstrong>Bekämpfung der Steuerhinterziehung\u003C/strong> durch Schlechterstellung des Defraudanten gegenüber dem ehrlichen Steuerpflichtigen, so dass die Defraudanten auf diesem Weg zumindest eine minimale Steuerbelastung erdulden müssen.","doc-1j4a33eml43",{"properties":5200,"identifier":4888,"id":5202},{"text":5201},"Der Steuerpflichtige, der seinen Rückerstattungsanspruch nicht ausübt oder diesen in Verletzung der ihm obliegenden steuerlichen Pflichten verwirkt, ist nicht von der Pflicht entbunden, die auf dem betroffenen Vermögen und Vermögensertrag geschuldeten direkten Steuern zu entrichten.","doc-1j4a33eml44",{"properties":5204,"identifier":4888,"id":5206},{"text":5205},"\u003Cstrong>Für im Ausland wohnhafte Leistungsempfänger\u003C/strong> stellt die Verrechnungssteuer grundsätzlich eine endgültige Belastung dar. Personen, deren Wohnsitzstaat mit der Schweiz ein \u003Cstrong>Doppelbesteuerungsabkommen\u003C/strong> abgeschlossen hat, können jedoch je nach Ausgestaltung dieses Abkommens Anspruch auf die ganze oder teilweise Rückerstattung der Verrechnungssteuer erheben, sofern sie die im betroffenen Abkommen aufgestellten Voraussetzungen erfüllen.","doc-1j4a33eml45",{"properties":5208,"identifier":5212,"id":5213},{"heading":5209,"label":5210,"class":219,"anchorNav":5211},"h3","Rulings / Steuervorbescheide","Rulings-/-Steuervorbescheide","heading-h3","doc-1j4a33eml46",{"properties":5215,"identifier":5104,"id":5216,"nestedContent":5217},{"accordionSettings":5103},"doc-1j4a33eml47",[5218,5236],{"properties":5219,"identifier":5111,"id":5222,"nestedContent":5223},{"accordionItems":5220},{"title":5221},"Welche formellen und materiellen Voraussetzungen gelten für die Einreichung einer Rulinganfrage?","doc-1j4a33eml48",[5224,5228,5232],{"properties":5225,"identifier":4888,"id":5227},{"text":5226},"Rulinganfragen reichen Sie möglichst elektronisch an die E-Mail-Adresse \u003Ca href=\"mailto:ruling.dvs@estv.admin.ch\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"ruling.dvs@estv.admin.ch\">ruling.dvs@estv.admin.ch\u003C/a> ein.\u003Cbr />\n Alternativ steht die Einreichung per Post  an die untenstehende Adresse zur Verfügung. Wird die Rulinganfrage elektronisch eingereicht, ist die Einreichung einer physischen Anfrage nicht nötig.\u003Cbr />","doc-1j4a33eml49",{"properties":5229,"identifier":4888,"id":5231},{"text":5230},"Eidgenössische Steuerverwaltung\u003Cbr />\n Hauptabteilung Direkte Bundessteuer, Verrechnungssteuer, Stempelabgaben\u003Cbr />\n Ruling DVS\u003Cbr />\n Eigerstrasse 65\u003Cbr />\n 3003 Bern","doc-1j4a33eml50",{"properties":5233,"identifier":4888,"id":5235},{"text":5234},"Die formellen und materiellen Voraussetzungen einer Rulinganfrage sind der Mitteilung 011 vom 29. April 2019 zu entnehmen.","doc-1j4a33eml51",{"properties":5237,"identifier":5111,"id":5240,"nestedContent":5241},{"accordionItems":5238},{"title":5239},"Kann ich den Namen der Mitarbeiterin bzw. des Mitarbeiters, die bzw. der mit der Bearbeitung meiner Rulinganfrage betraut ist, sowie die voraussichtliche Bearbeitungsdauer dieser Anfrage in Erfahrung bringen?","doc-1j4a33eml52",[5242,5246,5250,5254],{"properties":5243,"identifier":4888,"id":5245},{"text":5244},"Sobald Ihre Rulinganfrage bei uns registriert ist, erhalten Sie eine entsprechende elektronische Bestätigung.","doc-1j4a33eml53",{"properties":5247,"identifier":4888,"id":5249},{"text":5248},"Die zuständige Mitarbeiterin bzw. der zuständige Mitarbeiter wird Sie kontaktieren, falls weitere Informationen benötigt werden oder Unklarheiten bestehen. Bis zu diesem Zeitpunkt ist eine Nachfrage Ihrerseits nicht nötig.","doc-1j4a33eml54",{"properties":5251,"identifier":4888,"id":5253},{"text":5252},"Sollten zwischenzeitlich weitere Dokumente eingereicht werden, können diese wie das ursprüngliche Ruling auf die E-Mail-Sammeladresse verschickt werden. Die interne Weiterleitung erfolgt umgehend.","doc-1j4a33eml55",{"properties":5255,"identifier":4888,"id":5257},{"text":5256},"Die Bearbeitungszeit variiert je nach Komplexität der Anfrage und unserer aktuellen Arbeitsauslastung.","doc-1j4a33eml56",{"properties":5259,"identifier":5212,"id":5262},{"heading":5209,"label":5260,"class":219,"anchorNav":5261},"Weitere Informationen","Weitere-Informationen","doc-1j4a33eml57",{"properties":5264,"identifier":5104,"id":5265,"nestedContent":5266},{"accordionSettings":5103},"doc-1j4a33eml58",[5267,5277,5287,5297,5307,5341,5355,5369,5379,5389,5399],{"properties":5268,"identifier":5111,"id":5271,"nestedContent":5272},{"accordionItems":5269},{"title":5270},"Was wird bei Prüfungen direkt bei der Gesellschaft geprüft? Erhält die Gesellschaft nach der Prüfung einen Bericht bzw. eine Bestätigung, wenn keine steuerbaren Leistungen festgestellt wurden?","doc-1j4a33eml59",[5273],{"properties":5274,"identifier":4888,"id":5276},{"text":5275},"Die Abteilung Externe Prüfung der Hauptabteilung Direkte Bundessteuer, Verrechnungssteuer und Stempelabgaben prüft in erster Linie, ob allfällige geldwerte Leistungen vorliegen. Die Gesellschaft erhält nach Abschluss der Revision normalerweise keinen Bericht.","doc-1j4a33eml60",{"properties":5278,"identifier":5111,"id":5281,"nestedContent":5282},{"accordionItems":5279},{"title":5280},"Nach welcher Methode bewertet die ESTV den Wert eines Unternehmens?","doc-1j4a33eml61",[5283],{"properties":5284,"identifier":4888,"id":5286},{"text":5285},"Die ESTV bewertet Unternehmen für Belange der Verrechnungssteuer und Stempelabgaben in der Regel nach der Praktikermethode (Substanzwert und Ertragswert geteilt durch 2). Die Bewertungsmethode muss sachgerecht sein. Die Praktikermethode zur Ermittlung des Verkehrswertes kann bei KMU-Verhältnissen zu einem angemessenen Ergebnis führen. Ansonsten sind zur Ermittlung eines fremdüblichen Verkaufspreises vorzugsweise zukunftsorientierte Methoden (z.B. DCF) anzuwenden; vergangenheitsorientierte Methoden wie die Praktikermethode sind dazu nicht/nur bedingt geeignet (vgl. BGer vom 18.9.2013 / \u003Ca href=\"https://www.bger.ch/ext/eurospider/live/de/php/aza/http/index.php?highlight_docid=aza%3A%2F%2F18-09-2013-2C_309-2013&amp;lang=de&amp;type=show_document&amp;zoom=YES&amp;\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"2C_310/2013\">2C_310/2013\u003C/a>).","doc-1j4a33eml62",{"properties":5288,"identifier":5111,"id":5291,"nestedContent":5292},{"accordionItems":5289},{"title":5290},"Wann wird eine Dividende fällig?","doc-1j4a33eml63",[5293],{"properties":5294,"identifier":4888,"id":5296},{"text":5295},"Die Fälligkeit der Dividende wird an der Generalversammlung bestimmt. Falls kein Datum für die Dividendenfälligkeit beschlossen wird, entspricht die Fälligkeit dem Datum der Generalversammlung (vgl. \u003Ca href=\"https://www.fedlex.admin.ch/eli/cc/1966/1585_1641_1624/de#art_21\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Art. 21 Abs. 3 VStV\">Art. 21 Abs. 3 VStV\u003C/a>).","doc-1j4a33eml64",{"properties":5298,"identifier":5111,"id":5301,"nestedContent":5302},{"accordionItems":5299},{"title":5300},"Was ist bei einer nicht-proportionalen Ausschüttung (asymmetrische Dividende) zu tun?","doc-1j4a33eml65",[5303],{"properties":5304,"identifier":4888,"id":5306},{"text":5305},"Falls die Ausschüttung nicht für alle Beteiligten im selben Verhältnis zum nominellen Gesellschaftskapital erfolgt, muss dies auf dem Formular deklariert werden  und auf der zweiten Seite die Begünstigten mit Name, genauer Adresse und dem Anteil an der Ausschüttung aufgeführt werden.\u003Cbr />","doc-1j4a33eml66",{"properties":5308,"identifier":5111,"id":5311,"nestedContent":5312},{"accordionItems":5309},{"title":5310},"Die Liquidation meiner Gesellschaft ist abgeschlossen. Wann wird die Gesellschaft gelöscht?","doc-1j4a33eml67",[5313,5317,5321,5333,5337],{"properties":5314,"identifier":4888,"id":5316},{"text":5315},"Nach Prüfung der Löschung durch die beiden Hauptabteilungen MWST und DVS wird die Zustimmung zur Löschung seitens ESTV direkt an das Handelsregisteramt weitergeleitet.","doc-1j4a33eml68",{"properties":5318,"identifier":4888,"id":5320},{"text":5319},"Damit die ESTV Ihre Zustimmung zur Löschung Ihrer Gesellschaft an das zuständige Handelsregisteramt weiterleiten kann, werden seitens DVS folgende Unterlagen zur Prüfung benötigt:","doc-1j4a33eml69",{"properties":5322,"identifier":5157,"id":5332},{"title":219,"listTypeNegative":356,"listTypeLoose":356,"listType":4920,"listItems":5323},[5324,5326,5328,5330],{"text":5325,"type":5152,"link":4912,"icon":4912},"Jahresrechnung der letzten fünf Geschäftsjahre inklusive Liquidationsschlussbilanz",{"text":5327,"type":5152,"link":4912,"icon":4912},"Deklaration eines allfälligen Liquidationsüberschusses mit dem Formular 102",{"text":5329,"type":5152,"link":4912,"icon":4912},"Unterlagen zu Beteiligungs-, Wertschriften, Liegenschafts- oder sonstigen bedeutenden Verkäufen oder Privatentnahmen von Aktiven",{"text":5331,"type":5152,"link":4912,"icon":4912},"Kontaktdaten (Telefonnummer und E-Mailadresse) für Rückfragen\u003Cbr>","doc-1j4a33eml70",{"properties":5334,"identifier":4888,"id":5336},{"text":5335},"Bitte reichen Sie diese Unterlagen per Post an folgende Adresse ein:","doc-1j4a33eml75",{"properties":5338,"identifier":4888,"id":5340},{"text":5339},"Eidgenössische Steuerverwaltung ESTV\u003Cbr />\n Abteilung Erhebung DVS\u003Cbr />\n Eigerstrasse 65\u003Cbr />\n 3003 Bern","doc-1j4a33eml76",{"properties":5342,"identifier":5111,"id":5345,"nestedContent":5346},{"accordionItems":5343},{"title":5344},"Zu welchem Zinssatz sind Betriebskredite von Beteiligten von über 1 Million CHF zu verzinsen?","doc-1j4a33eml77",[5347,5351],{"properties":5348,"identifier":4888,"id":5350},{"text":5349},"Für die Beurteilung einer angemessenen Verzinsung von Vorschüssen oder Darlehen von Beteiligten oder nahestehenden Dritten stellt die ESTV auf die jährlich neu publizierten Höchstzinssätze gemäss ihrem \u003Ca href=\"/de/rundschreiben-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Rundschreiben\">Rundschreiben\u003C/a> ab.","doc-1j4a33eml78",{"properties":5352,"identifier":4888,"id":5354},{"text":5353},"Bei Betriebskrediten kann dabei auch bei grösseren Kreditsummen die erste Million CHF zum höheren Zinssatz verzinst werden. Für den Restbetrag (&gt;1 Million CHF) kommt der tiefere Maximalzinssatz zur Anwendung.","doc-1j4a33eml79",{"properties":5356,"identifier":5111,"id":5359,"nestedContent":5360},{"accordionItems":5357},{"title":5358},"Welche Kriterien sind massgebend, damit die Zinssätze eines Cashpooling zulässig sind?","doc-1j4a33eml80",[5361,5365],{"properties":5362,"identifier":4888,"id":5364},{"text":5363},"Die im Rahmen eines Cashpoolings gewährten konzerninternen Darlehen beziehungsweise die für solche Darlehen gezahlten Zinsen werden in der Regel von der ESTV akzeptiert, sofern die steuerpflichtige Person nachweisen kann, dass es sich nicht um langfristige Darlehen handelt. Die Verwendung des Cashpoolings zur Finanzierung bestimmter Geschäfte ist somit grundsätzlich nicht zulässig, insbesondere nicht für den Erwerb von Beteiligungen, Anlagevermögen und Dividendenauszahlungen. In der Praxis kommen bestimmte Kennzahlen zur Anwendung, um gestützt darauf zu beurteilen, ob eine Transaktion in einem Cashpooling gerechtfertigt ist. Gestützt auf diese Kennzahlen und weitere Merkmale wie beispielsweise den Finanzierungszweck (Bsp.: Dividendenzahlung) muss die steuerpflichtige Person nachweisen, dass es sich tatsächlich um eine Transaktion handelt, die im Rahmen eines Cashpooling gemäss dem Grundsatz des Fremd- oder Drittvergleichs (auch «dealing at arm’s length» genannt) gerechtfertigt ist. Ist dies nicht der Fall, wird die Transaktion als langfristiges Darlehen qualifiziert. Diesfalls gelangen die Zinssätze aus den Rundschreiben der ESTV zur Anwendung.","doc-1j4a33eml81",{"properties":5366,"identifier":4888,"id":5368},{"text":5367},"Die Verzinsung der Cashpool-Saldi muss einem Drittvergleich standhalten. Die Synergieeffekte aus dem Cashpooling müssen – nach Verrechnung der für das Cashpooling anfallenden Kosten – grundsätzlich allen Teilnehmern zugutekommen. Bei der Festlegung der Vergütung ist dabei den übernommenen Funktionen und Risiken der Teilnehmer und des Cashpool-Leaders Rechnung zu tragen.","doc-1j4a33eml82",{"properties":5370,"identifier":5111,"id":5373,"nestedContent":5374},{"accordionItems":5371},{"title":5372},"Ab wann (Abgrenzung) wird ein konzerninterner Geschäftsschuldner mit einem Darlehen gleichgesetzt?","doc-1j4a33eml83",[5375],{"properties":5376,"identifier":4888,"id":5378},{"text":5377},"Die Lieferung einer Handelsware wird in der Regel je nach Wirtschaftszweig zum Beispiel innerhalb einer Frist von 30, 60 oder 90 Tagen bezahlt. Liegt eine weitaus längere Zahlungsfrist als üblich vor, geht die ESTV beim fraglichen Betrag von einem Darlehen aus, das nach den Ansätzen der Rundschreiben der ESTV verzinst werden muss.","doc-1j4a33eml84",{"properties":5380,"identifier":5111,"id":5383,"nestedContent":5384},{"accordionItems":5381},{"title":5382},"Verdecktes Eigenkapital, welcher Zinssatz gilt für denjenigen Teil des Darlehens, der verzinst werden kann?","doc-1j4a33eml85",[5385],{"properties":5386,"identifier":4888,"id":5388},{"text":5387},"In den jährlich publizierten Rundschreiben der ESTV werden die für Vorschüsse und Darlehen steuerlich zulässigen Zinssätze definiert, welche in diesem Sinn sogenannte «Safe-Haven-Regeln» darstellen. Wendet die steuerpflichtige Person diese Zinssätze an, muss sie grundsätzlich nicht nachweisen, dass sie den Grundsatz des Fremd- oder Drittvergleichs anwendet.","doc-1j4a33eml86",{"properties":5390,"identifier":5111,"id":5393,"nestedContent":5394},{"accordionItems":5391},{"title":5392},"Kapitaleinlageprinzip, welche Möglichkeiten gibt es, im Rahmen von Umstrukturierungen Reserven aus Kapitaleinlagen zu bilden (KER)?","doc-1j4a33eml87",[5395],{"properties":5396,"identifier":4888,"id":5398},{"text":5397},"Siehe dazu Kapitel 6, Umstrukturierungen allgemein, des Kreisschreibens Nr. 29c Kapitaleinlageprinzip vom 23. Dezember 2022 der ESTV.","doc-1j4a33eml88",{"properties":5400,"identifier":5111,"id":5403,"nestedContent":5404},{"accordionItems":5401},{"title":5402},"Wo finde ich weiterführende Informationen zur Verrechnungssteuer?","doc-1j4a33eml89",[5405,5409],{"properties":5406,"identifier":4888,"id":5408},{"text":5407},"Im Rahmen ihrer Tätigkeit erarbeitet und publiziert die Hauptabteilung DVS der ESTV Kreisschreiben, Rundschreiben, Merkblätter und Wegleitungen. Diese führen die einschlägigen Rechtsgrundlagen des Bundesgesetzes über die Verrechnungssteuer sowie der Ausführungsverordnungen näher aus und dienen der Festlegung einer einheitlichen Praxis.","doc-1j4a33eml90",{"properties":5410,"identifier":4888,"id":5412},{"text":5411},"Zu den \u003Ca href=\"/de/kreisschreiben-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Kreisschreiben der Verrechnungssteuer\">Kreisschreiben der Verrechnungssteuer\u003C/a>.","doc-1j4a33eml91",{"properties":5414,"identifier":5212,"id":5416},{"heading":5209,"label":5415,"class":219,"anchorNav":5415},"Auskunft","doc-1j4a33eml94",{"properties":5418,"identifier":5104,"id":5419,"nestedContent":5420},{"accordionSettings":5103},"doc-1j4a33eml95",[5421],{"properties":5422,"identifier":5111,"id":5425,"nestedContent":5426},{"accordionItems":5423},{"title":5424},"Ich ersuche um eine Rechtsauskunft im Bereich Verrechnungssteuer. Wer erteilt Auskunft?","doc-1j4a33eml96",[5427,5431],{"properties":5428,"identifier":4888,"id":5430},{"text":5429},"Die Eidgenössische Steuerverwaltung, Hauptabteilung Direkte Bundessteuer, Verrechnungssteuer, Stempelabgaben (Hauptabteilung DVS), ist unter anderem verantwortlich für die Erhebung und die Rückerstattung (Rückerstattung: an juristische Personen mit Sitz in der Schweiz und an im Ausland ansässige rückerstattungsberechtigte juristische und natürliche Personen) der Verrechnungssteuer. Im Bereich der Rückerstattung der Verrechnungssteuer an natürliche Personen mit Wohnsitz in der Schweiz beaufsichtigt die Eidgenössische Steuerverwaltung die dafür zuständigen kantonalen Steuerbehörden. Für die Rechtsanwendung im konkreten Fall im Bereich der natürlichen Personen ersuchen wir Sie, sich an die für Sie zuständige kantonale Steuerverwaltung zu wenden.\u003Cbr />","doc-1j4a33eml97",{"properties":5432,"identifier":4888,"id":5434},{"text":5433},"Bei Rechtsfragen bitten wir Sie, sich via Kontaktformular «\u003Ca href=\"/de/nachricht-an-die-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Verrechnungssteuer\">Verrechnungssteuer\u003C/a>» an die Hauptabteilung DVS zu wenden. Für die Rechtsanwendung in einem konkreten, vor der ESTV einzuleitenden oder bereits hängigen Fall sind die entsprechenden Formvorschriften und Fristen zu beachten.","doc-1j4a33eml98",{"properties":5436,"identifier":4899,"id":5438,"nestedContent":5439},{"sectionStyles":5437},{"section-variation":4998,"section-color":4999},"doc-1j7j73gjq0",[5440],{"properties":5441,"identifier":4905,"id":5443,"nestedContent":5444},{"variation":4998,"anchorNavItems":5442},[],"doc-container-grid-1793260879228-192",[5445,5448,5452,5456,5470],{"properties":5446,"identifier":5089,"id":5447},{"heading":5086,"label":5447,"class":219,"anchorNav":5447},"Kontakt",{"properties":5449,"identifier":4888,"id":5451},{"text":5450},"Bei Fragen kontaktieren Sie uns bitte über das \u003Ca href=\"/de/nachricht-an-die-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Kontaktformular\">Kontaktformular\u003C/a>.","doc-1jk2gunar2",{"properties":5453,"identifier":4888,"id":5455},{"text":5454},"\u003Cstrong>Spezifische Anfragen\u003C/strong>","doc-1jk2gunar3",{"properties":5457,"identifier":5157,"id":5469},{"title":219,"listTypeNegative":356,"listTypeLoose":356,"listType":4920,"listItems":5458},[5459,5461,5463,5465,5467],{"text":5460,"type":5152,"link":4912,"icon":4912},"\u003Ca href=\"/de/kontakt-erhebung\" target=\"_self\" class=\"link\" aria-label=\"Fragen zur Abrechnung\">Fragen zur Abrechnung\u003C/a>",{"text":5462,"type":5152,"link":4912,"icon":4912},"\u003Ca href=\"/de/kontakt-rueckerstattung-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Fragen zur Rückerstattung der Verrechnungssteuer\">Fragen zur Rückerstattung der Verrechnungssteuer\u003C/a>",{"text":5464,"type":5152,"link":4912,"icon":4912},"\u003Ca href=\"/de/kontakt-abteilung-inkasso-partnerdaten\" target=\"_self\" class=\"link\" aria-label=\"Fragen zur Zahlung\">Fragen zur Zahlung\u003C/a>",{"text":5466,"type":5152,"link":4912,"icon":4912},"\u003Ca href=\"/de/kontakt-recht-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Rechtliche Anfragen\">Rechtliche Anfragen\u003C/a>",{"text":5468,"type":5152,"link":4912,"icon":4912},"\u003Ca href=\"/de/kontakt-externe-pruefung-verrechnungssteuer\" target=\"_self\" class=\"link\" aria-label=\"Fragen an die Abteilung Externe Prüfung\">Fragen an die Abteilung Externe Prüfung\u003C/a>","doc-1jk2gunar4",{"properties":5471,"identifier":4888,"id":5473},{"text":5472},"Eidgenössische Steuerverwaltung ESTV\u003Cbr />\n Hauptabteilung DVS\u003Cbr />\n Eigerstrasse 65\u003Cbr />\n 3003 Bern","doc-1jk2gunar11",[5475],{"name":5476,"language":7,"documentId":5477,"documentType":343,"contentType":5478,"metadata":5479},"footer-data-record",3622,"footer-data",{"about":5480,"informed":5483,"furtherinformation":5499,"jsonLDEntities":5500,"translationPages":5501,"contactDataInformation":5502},{"aboutHeadline":5481,"description":5482,"copyright":219},"Über die ESTV","Die ESTV beschafft den Grossteil der Bundeseinnahmen und leistet einen wichtigen Beitrag zur Finanzierung der öffentlichen Aufgaben.",{"socialLinks":5484,"socialHeadline":5497,"newslettertext":4720,"newsletterlink":5498,"newsletternewtab":19,"target":937},[5485,5489,5493],{"text":5486,"link":5487,"icon":5488,"target":937},"Lernende der ESTV","https://instagram.com/estv_lernende?igshid=OGQ5ZDc2ODk2ZA==","Instagram",{"text":5490,"link":5491,"icon":5492,"target":937},"Kommunikation ESTV","https://www.youtube.com/@kommunikationestv8091","Youtube",{"text":5494,"link":5495,"icon":5496,"target":937},"LinkedIn ESTV","https://www.linkedin.com/company/estv-afc/","LinkedIn","Informiert bleiben","https://www.abo.news.admin.ch/",{"furtherHeadline":5260},[],[],{},{"id":5504,"handle":5505,"title":5505,"current":356,"linkTarget":931,"type":219,"children":5506,"documentId":219},3624,"footer-navigation-de",[5507,5513,5518,5521],{"id":5508,"handle":219,"title":5509,"current":356,"link":5510,"linkTarget":931,"type":948,"children":5511,"documentId":5512},"nkI56I_JN4Fp0S6_QswBZ","Impressum","/de/impressum-estv",[],"1728",{"id":5514,"handle":219,"title":5515,"current":356,"link":5516,"linkTarget":937,"type":938,"children":5517,"documentId":219},"8v9RzVK3J5HNZlMA-0wOr","Rechtliche Grundlage","https://www.admin.ch/gov/de/start/rechtliches.html",[],{"id":5519,"handle":219,"title":4819,"current":356,"link":4820,"linkTarget":931,"type":948,"children":5520,"documentId":4822},"-qvNo1hRh7dRWq9X2AhcB",[],{"id":5522,"handle":219,"title":5523,"current":356,"link":5524,"linkTarget":931,"type":948,"children":5525,"documentId":5526},"oA1wMm6SvtI6S3WltUe_W","Erklärung zur Barrierefreiheit","/de/barrierefreiheit-in-der-bundesverwaltung",[],"1730",{"id":5528,"handle":5529,"title":5529,"current":356,"linkTarget":931,"type":219,"children":5530,"documentId":219},3621,"footer-menu-de",[5531,5534,5537,5542,5546],{"id":5532,"handle":219,"title":4750,"current":356,"link":4751,"linkTarget":931,"type":948,"children":5533,"documentId":4756},"OpzGg3MjsYfdue89JMMzg",[],{"id":5535,"handle":219,"title":4663,"current":356,"link":4664,"linkTarget":931,"type":948,"children":5536,"documentId":4669},"qSn-mJ8oCVvm4wdonHAhp",[],{"id":5538,"handle":219,"title":5539,"current":356,"link":5540,"linkTarget":937,"type":938,"children":5541,"documentId":219},"dyL_4lG88W9HL_Rf0olWU","Steuerrechner","https://swisstaxcalculator.estv.admin.ch/#/home",[],{"id":5543,"handle":219,"title":5544,"current":356,"link":4808,"linkTarget":931,"type":948,"children":5545,"documentId":4810},"mPuJwJM8TTTZLh5kauVV7","e-Rechnung",[],{"id":5547,"handle":219,"title":4825,"current":356,"link":4826,"linkTarget":931,"type":948,"children":5548,"documentId":4828},"AxBpqVek2kTx_RlyIMTND",[],["Reactive",5550],{},["Set",5552],"$3oRWNoOsuN",["ShallowReactive",5554],{"$fHKlZIzz-n59oKhO-_u3WU1e5ZoS-GPX_S-nwT3vQCsM":-1,"$fwufl64AudrT5sk9lvps602O4DXrlcF37gGcqLnmIWRY":-1,"$fE6MuyjyqwKZ8l7gi4QzydWDIBUBfE2M52VsGYDNcBUY":-1,"$fZRX33HAd7pXbHGzuoH4C3-3l8XKOvVSoiUexNyyASFs":-1,"$f--5uTHsFal0_9mjnAAucM7siZIZPggFbJzRmT_XuboQ":-1,"index/data-records/site-identity/de-all.json":-1,"$fay5t9R3c56GB2KJDY_ag0NSVIbo8JCJclOFgt8rKG-s":-1,"index/cookiepopup/de-all.json":5555,"main-menus/main-de.json":-1,"meta-navigation-menus/meta-navigation-de.json":-1,"topbar-navigation-menus/topbar-navigation-de.json":5562,"de/verrechnungssteuer.json":-1,"footer-data-de":-1,"index/data-records/footer-data/de-all.json":-1,"footer-nav-menu-de":-1,"footer-navigation-menus/footer-navigation-de.json":-1,"footer-menu-de":-1,"footer-menus/footer-menu-de.json":-1},["NuxtError",5556],{"message":5557,"statusCode":5558,"statusMessage":5559,"data":5560},"[GET] \"/api/collector/index/cookiepopup/de-all.json\": 404 Server Error",404,"Server Error",{"error":19,"url":5561,"statusCode":5558,"statusMessage":5559,"message":219},"http://localhost/api/collector/index/cookiepopup/de-all.json",["NuxtError",5563],{"message":5564,"statusCode":5558,"statusMessage":5559,"data":5565},"[GET] \"/api/collector/topbar-navigation-menus/topbar-navigation-de.json\": 404 Server Error",{"error":19,"url":5566,"statusCode":5558,"statusMessage":5559,"message":219},"http://localhost/api/collector/topbar-navigation-menus/topbar-navigation-de.json",["Reactive",5568],{"siteIdentity":5569,"header":5570,"menu":5585,"cookiepopup":7004},{"siteIdentity":340},{"headerDepartmentData":5571,"headerGovernmentData":5573,"headerOfficeData":5575,"pageTranslations":5577,"accessibilityLinks":5579,"pageContentType":5582,"accessibilityType":5583},["Ref",5572],["Reactive",298],["Ref",5574],["Reactive",329],["Ref",5576],["Reactive",377],["Ref",5578],["Reactive",4850],["Ref",5580],["Reactive",5581],{"easyLanguageTranslation":4912,"signLanguageTranslation":4912},["Ref",4838],["EmptyRef",5584],"null",{"main":5586,"breadcrumbs":5588,"currentNodes":6997,"metaNavigation":6998,"topBarNavigation":7000,"listOfHomepageIds":7002},["Ref",5587],["Reactive",940],["Ref",5589],["Reactive",5590],[5591,6103,6165,6237,6255,6343,6675],{"id":945,"handle":219,"title":946,"current":356,"link":947,"linkTarget":931,"type":948,"children":5592,"documentId":953,"siblings":-1},[5593,5595,5623,5987,5989,5991,6001,6003,6023,6045,6061,6089,6101],{"id":951,"handle":219,"title":37,"current":356,"link":947,"linkTarget":931,"type":948,"children":5594,"documentId":953},[],{"id":955,"handle":219,"title":956,"current":356,"link":957,"linkTarget":931,"type":948,"children":5596,"documentId":962},[5597,5599,5601,5603,5605,5607,5609,5619,5621],{"id":960,"handle":219,"title":37,"current":356,"link":957,"linkTarget":931,"type":948,"children":5598,"documentId":962},[],{"id":964,"handle":219,"title":965,"current":356,"link":966,"linkTarget":931,"type":948,"children":5600,"documentId":968},[],{"id":970,"handle":219,"title":971,"current":356,"link":972,"linkTarget":931,"type":948,"children":5602,"documentId":974},[],{"id":976,"handle":219,"title":977,"current":356,"link":978,"linkTarget":931,"type":948,"children":5604,"documentId":980},[],{"id":982,"handle":219,"title":983,"current":356,"link":984,"linkTarget":931,"type":948,"children":5606,"documentId":986},[],{"id":988,"handle":219,"title":989,"current":356,"link":990,"linkTarget":931,"type":948,"children":5608,"documentId":992},[],{"id":994,"handle":219,"title":995,"