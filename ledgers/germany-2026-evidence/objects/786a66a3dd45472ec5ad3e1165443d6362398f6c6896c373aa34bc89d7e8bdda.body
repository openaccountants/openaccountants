,null,{\"className\":\"sr-only\",\"children\":\"Öffnet in neuem Tab\"}],[\"$\",\"span\",null,{\"className\":\"ba-icon ba-icon-download pe-2 fs-5\",\"children\":\" \"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Entscheidungsschema zur Betriebsnummern-Vergabe\"}],[\"$\",\"div\",null,{\"className\":\"d-flex flex-column\",\"children\":[false,[\"$\",\"span\",null,{\"className\":\"ba-microcopy\",\"children\":\"pdf | 186.10 KB | nicht barrierefrei\"}]]}]]}]]}]}]]}]}]]}]}]}]]}]]}]\n3b:[\"$\",\"$L38\",\"_S_6_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"container-fluid\",\"children\":[[\"$\",\"header\",null,{\"children\":[\"$\",\"h2\",null,{\"className\":\"ba-spacing-top-h2\",\"id\":\"antragstellung\",\"children\":\"Antragstellung\"}]}],[\"$\",\"article\",null,{\"className\":\"row ba-richtext-content ba-copytext \",\"children\":[[\"$\",\"div\",null,{\"className\":\"ba-content-main\",\"children\":[null,[\"$\",\"article\",null,{\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"p\",\"0\",{\"children\":[\"Der Betriebsnummern-Service der Bundesagentur für Arbeit vergibt die Betriebsnummern und erfasst die erforderlichen Betriebsdaten. Sie sind gesetzlich verpflichtet, die Betriebsnummer \",[\"$\",\"strong\",\"1\",{\"children\":\"elektronisch\"}],\" zu beantragen. Nutzen Sie unseren \",[\"$\",\"a\",\"3\",{\"href\":\"https://web.arbeitsagentur.de/bno-prod/ui/#/start\",\"target\":\"_blank\",\"title\":\"Online-Antrag\",\"data-analytics-track\":\"true\",\"data-analytics-action\":\"klick\",\"data-analytics-value\":\" \",\"data-analytics-name\":\"https://web.arbeitsagentur.de/bno-prod/ui/#/start\",\"data-analytics-category\":\"link\",\"children\":\"Online-Antrag\"}],\". Ihr Vorteil: In der Regel entfällt die Bearbeitungszeit.\"]}],[\"$\",\"p\",\"1\",{\"children\":\"Die Vergabebestätigung versendet der Betriebsnummern-Service aus Datenschutzgründen nur per Post.\"}],[\"$\",\"p\",\"2\",{\"children\":[[\"$\",\"strong\",\"0\",{\"children\":\"Bitte beachten Sie:\"}],\" Seit dem 01.01.2024 benötigen Sie zur Beantragung einer Betriebsnummer die Unternehmensnummer des Unternehmens, dem der neue Beschäftigungsbetrieb angehört. Sie wird vom zuständigen Unfallversicherungsträger vergeben. Für weitere Fragen zur Vergabe oder Nutzung der Unternehmensnummer folgen Sie bitte dem Link: \",[\"$\",\"a\",\"2\",{\"href\":\"https://www.dguv.de/de/versicherung/unternehmensnummer/index.jsp\",\"target\":\"_blank\",\"data-analytics-track\":\"true\",\"data-analytics-action\":\"klick\",\"data-analytics-value\":\" \",\"data-analytics-name\":\"https://www.dguv.de/de/versicherung/unternehmensnummer/index.jsp\",\"data-analytics-category\":\"link\",\"children\":\"Unternehmensnummer (dguv.de)\"}],\".\"]}]]}]}]]}],[\"$\",\"div\",null,{\"className\":\"ba-content-marginal\",\"children\":[]}]]}]]}]}]\n3c:[\"$\",\"$L38\",\"_S_7_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"container-fluid\",\"children\":[[\"$\",\"header\",null,{\"children\":[\"$\",\"h2\",null,{\"className\":\"ba-spacing-top-h2\",\"id\":\"aenderungsmitteilung\",\"children\":\"Änderungsmitteilung\"}]}],[\"$\",\"article\",null,{\"className\":\"row ba-richtext-content ba-copytext \",\"children\":[[\"$\",\"div\",null,{\"className\":\"ba-content-main\",\"children\":[null,[\"$\",\"article\",null,{\"children\":[\"$\",\"section\",null,{\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"Wenn es Veränderungen bei den Betriebsdaten gibt oder Sie die Betriebstätigkeit dauerhaft beenden, müssen Sie dies dem Betriebsnummern-Service unverzüglich mitteilen. Eine falsche Anschrift kann etwa zu fehlerhaften Daten in der Beschäftigungsstatistik führen. Hinzu kommt, dass sich fehlerhafte betriebliche Angaben negativ auf die Umsatzsteuerverteilung auswirken können.\"}],[\"$\",\"p\",\"1\",{\"children\":[\"Die Änderungen können Sie mithilfe des Datensatzes Betriebsdatenpflege (DSBD) übermitteln. Hinweise dazu erhalten Sie im Handbuch zu elektronischen Änderungsmitteilungen\",[\"$\",\"strong\",\"1\",{\"children\":\".\"}]]}],[\"$\",\"p\",\"2\",{\"className\":\"ba-accent ba-accent-hint\",\"children\":[[\"$\",\"span\",\"0\",{\"className\":\"sr-only\",\"children\":\"Tipp:\"}],[\"$\",\"strong\",\"1\",{\"children\":\"Gut zu wissen:\"}],\" Sie sind gesetzlich dazu verpflichtet, Änderungen sofort mitzuteilen. Kommen Sie dieser Pflicht nicht nach, kann dies mit einer Geldbuße geahndet werden.\"]}]]}]}]]}],[\"$\",\"div\",null,{\"className\":\"ba-content-marginal\",\"children\":[[\"$\",\"$1\",\"_S_h_,_S_h_\",{\"children\":[[\"$\",\"aside\",\"_S_i_\",{\"className\":\"ba-copytext\",\"aria-label\":\"Dokumente zu diesem Thema\",\"aria-labelledby\":\"aside-_S_i_\",\"children\":[\"$\",\"$L38\",null,{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":true},\"children\":[\"$\",\"div\",null,{\"className\":\"\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"aside-_S_i_\",\"children\":\"Dokumente zu diesem Thema\"}],[\"$\",\"article\",null,{\"className\":\"ba-result-list \",\"children\":[\"$\",\"ol\",null,{\"className\":\"ba-result-list-results ba-layout-tile\",\"children\":[[\"$\",\"li\",\"7e3015ac-6855-4a32-b5c0-a5b5b45c2754\",{\"className\":\"p-0 m-0\",\"children\":[\"$\",\"a\",null,{\"data-analytics-value\":\" \",\"data-analytics-action\":\"klick\",\"data-analytics-track\":\"true\",\"data-analytics-category\":\"link\",\"data-analytics-name\":\"https://www.arbeitsagentur.de/datei/dok_ba034860.pdf\",\"href\":\"https://www.arbeitsagentur.de/datei/dok_ba034860.pdf\",\"className\":\"d-flex m-0 p-2 lh-sm\",\"target\":\"_blank\",\"rel\":\"noopener\",\"lang\":\"de\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\"Öffnet in neuem Tab\"}],[\"$\",\"span\",null,{\"className\":\"ba-icon ba-icon-download pe-2 fs-5\",\"children\":\" \"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Betriebliche Angaben Elektronische Änderungsmeldung\"}],[\"$\",\"div\",null,{\"className\":\"d-flex flex-column\",\"children\":[false,[\"$\",\"span\",null,{\"className\":\"ba-microcopy\",\"children\":\"pdf | 649.11 KB | nicht barrierefrei\"}]]}]]}]]}]}]]}]}]]}]}]}]]}]]}]]}]]}]}]\n3d:[\"$\",\"$L38\",\"_S_8_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"container-fluid\",\"children\":[[\"$\",\"header\",null,{\"children\":[\"$\",\"h2\",null,{\"className\":\"ba-spacing-top-h2\",\"id\":\"statistische-bedeutung-der-betriebsnummer\",\"children\":\"Statistische Bedeutung der Betriebsnummer\"}]}],[\"$\",\"article\",null,{\"className\":\"row ba-richtext-content ba-copytext \",\"children\":[[\"$\",\"div\",null,{\"className\":\"ba-content-main\",\"children\":[null,[\"$\",\"article\",null,{\"children\":[\"$\",\"p\",null,{\"children\":\"Mit der Betriebsnummer werden die Beschäftigten eines Betriebes sowohl einer Region als auch einer Wirtschaftsklasse zugeordnet. Die Betriebsnummer spielt darum in der Beschäftigungsstatistik der Bundesagentur für Arbeit eine wichtige Rolle. In die Beschäftigungsstatistik fließen außerdem Angaben zu der Tätigkeit mit ein. Diese Angaben werden im Rahmen des Meldeverfahrens zur Sozialversicherung im sogenannten Tätigkeitsschlüssel erhoben. Die Statistik ist für Wirtschaft und Politik eine zuverlässige Informationsquelle zur Entwicklung der Beschäftigung.\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"ba-content-marginal\",\"children\":[]}]]}]]}]}]\n3e:[\"$\",\"$L38\",\"_S_9_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"container-fluid\",\"children\":[[\"$\",\"header\",null,{\"children\":[\"$\",\"h2\",null,{\"className\":\"ba-spacing-top-h2\",\"id\":\"wirtschaftszweig\",\"children\":\"Wirtschaftszweig\"}]}],[\"$\",\"article\",null,{\"className\":\"row ba-richtext-content ba-copytext \",\"children\":[[\"$\",\"div\",null,{\"className\":\"ba-content-main\",\"children\":[null,[[\"$\",\"article\",\"0\",{\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"Die Beschäftigungsstatistik der Bundesagentur für Arbeit ist auch nach Wirtschaftszweigen gegliedert. Daher wird beim Erfassen von Betrieben die jeweilige Branche bestimmt.\"}],[\"$\",\"p\",\"1\",{\"children\":\"Dies geschieht auf der Grundlage der aktuellen Klassifikation der Wirtschaftszweige (WZ 2025) des Statistischen Bundesamtes. Die wirtschaftsfachliche Zuordnung eines Betriebs richtet sich nach\"}],[\"$\",\"ul\",\"2\",{\"className\":\"ba-list ba-list-positive\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"span\",\"0\",{\"className\":\"sr-only\",\"children\":\"positiv:\"}],\"dem Betriebszweck oder\"]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"span\",\"0\",{\"className\":\"sr-only\",\"children\":\"positiv:\"}],\"der wirtschaftlichen Tätigkeit des überwiegenden Teils der Beschäftigten.\"]}]]}],[\"$\",\"p\",\"3\",{\"children\":\"Andere Kriterien, wie zum Beispiel Umsatzzahlen, werden nicht berücksichtigt.\"}],[\"$\",\"p\",\"4\",{\"children\":[\"Ausführlichere Informationen zu der Klassifikation der Wirtschaftszweige erhalten Sie über das \",[\"$\",\"a\",\"1\",{\"href\":\"https://statistik.arbeitsagentur.de/DE/Navigation/Grundlagen/Klassifikationen/Klassifikation-der-Wirtschaftszweige/Klassifikation-der-Wirtschaftszweige-Nav.html\",\"target\":\"_blank\",\"title\":\"Statistikangebot der Bundesagentur für Arbeit\",\"data-analytics-track\":\"true\",\"data-analytics-action\":\"klick\",\"data-analytics-value\":\" \",\"data-analytics-name\":\"https://statistik.arbeitsagentur.de/DE/Navigation/Grundlagen/Klassifikationen/Klassifikation-der-Wirtschaftszweige/Klassifikation-der-Wirtschaftszweige-Nav.html\",\"data-analytics-category\":\"link\",\"children\":\"Statistikangebot der Bundesagentur für Arbeit\"}],\" oder auf der Seite des \",[\"$\",\"a\",\"3\",{\"className\":\"ba-link-icon ba-icon-linkout\",\"href\":\"https://www.destatis.de/DE/Methoden/Klassifikationen/Gueter-Wirtschaftsklassifikationen/klassifikation-wz-2025.html\",\"target\":\"_blank\",\"title\":\"Statistischen Bundesamts\",\"data-analytics-track\":\"true\",\"data-analytics-action\":\"klick\",\"data-analytics-value\":\" \",\"data-analytics-name\":\"https://www.destatis.de/DE/Methoden/Klassifikationen/Gueter-Wirtschaftsklassifikationen/klassifikation-wz-2025.html\",\"data-analytics-category\":\"link\",\"children\":\"Statistischen Bundesamts\"}],\".\"]}]]}],[\"$\",\"section\",\"1\",{\"children\":\" \"}]]]}],[\"$\",\"div\",null,{\"className\":\"ba-content-marginal\",\"children\":[]}]]}]]}]}]\n45:Teeb,\u003cdiv class=\"container-fluid ba-spacing-bottom-h2 ba-spacing-top-h2\" id=\"fb-t-container\" style=\"display:none;\"\u003e\r\n    \u003carticle class=\"row ba-richtext-content ba-copytext \"\u003e\r\n        \u003cdiv class=\"ba-content-main\" style=\"background-color: rgba(2,14,37,.04); padding: 24px;\"\u003e\r\n            \u003ch2 id=\"FBTextHeadline\" data-ivz-nodisplay\u003eIst der Inhalt der Seite hilfreich für Sie?\u003c/h2\u003e\r\n            \u003cp id=\"FBTextDescription\"\u003eKonnten wir Ihnen mit der Seite weiterhelfen? Lassen Sie es uns wissen!\u003c/p\u003e\r\n            \u003cdiv id=\"feeback-controls\"\u003e\r\n                \u003cbutton id=\"FBbuttonPositivDescription\"\r\n                    class=\"ba-btn ba-btn-tertiary ba-btn-icon ba-icon-favorite-full feedback-button-positive\"\r\n                    type=\"button\"\u003eHilfreich\u003c/button\u003e\r\n                \u003cbutton id=\"FBButtonNegativDescription\"\r\n                    class=\"ba-btn ba-btn-tertiary ba-btn-icon ba-icon-favorite feedback-button-negative\"\r\n                    type=\"button\"\u003eNicht hilfreich\u003c/button\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/article\u003e\r\n\u003c/div\u003e\r\n\u003cscript\u003e\r\n    const FBtextValues = {\r\n        de: { FBTextHeadline: 'Ist der Inhalt der Seite hilfreich für Sie?', FBTextDescription: 'Konnten wir Ihnen mit der Seite weiterhelfen? Lassen Sie es uns wissen!', FBbuttonPositivDescription: 'Hilfreich', FBButtonNegativDescription: 'Nicht hilfreich', },\r\n        en: { FBTextHeadline: 'Is the content of this page helpful to you?', FBTextDescription: 'Were we able to help you with this page? Please let us know!', FBbuttonPositivDescription: 'Helpful', FBButtonNegativDescription: 'Not helpful' },\r\n        es: { FBTextHeadline: '¿Te ha resultado útil el contenido de esta página?', FBTextDescription: '¿Te hemos ayudado con esta página? Háganoslo saber.', FBbuttonPositivDescription: 'Útil', FBButtonNegativDescription: 'No es útil' }\r\n    };\r\n    const FBtextValuesConfirmation = {\r\n        de: { confirmationDescription: 'Vielen Dank für Ihr Feedback!' },\r\n        en: { confirmationDescription: 'Thank you for your feedback!' },\r\n        es: { confirmationDescription: 'Gracias por sus comentarios.' }\r\n    };\r\n    const langCode = document.documentElement.lang;\r\n    (() =\u003e {\r\n        checkForConsent();\r\n        if (typeof cookieStore !== 'undefined') {\r\n            cookieStore.addEventListener(\"change\", (event) =\u003e { checkForConsent() });\r\n        }\r\n        let langCode = document.documentElement.lang;\r\n        translateUI();\r\n        document.getElementById(\"FBbuttonPositivDescription\").addEventListener(\"click\", positiveFeedback);\r\n        document.getElementById(\"FBButtonNegativDescription\").addEventListener(\"click\", negativeFeedback);\r\n\r\n        function positiveFeedback() {\r\n            let currentPage = document.location.href;\r\n            _paq.push(['trackEvent', 'Feedback_Int Ja/Nein', 'Hilfreich', currentPage]);\r\n            FeedbackDone();\r\n        }\r\n        function negativeFeedback() {\r\n            let currentPage = document.location.href;\r\n            _paq.push(['trackEvent', 'Feedback_Int Ja/Nein', 'Nicht Hilfreich', currentPage]);\r\n            FeedbackDone()\r\n        }\r\n\r\n        function FeedbackDone() {\r\n            document.getElementById(\"feeback-controls\").innerHTML = `\u003cspan style='min-height:35px'\u003e${FBtextValuesConfirmation[langCode].confirmationDescription}\u003c/span\u003e`;\r\n        }\r\n        function checkForConsent() {\r\n            if (document.cookie.match(\"cookie_consent=accepted\")) {\r\n                document.getElementById(\"fb-t-container\").style.display = \"block\";\r\n            }\r\n        }\r\n        function translateUI() {\r\n            Object.keys(FBtextValues[langCode]).forEach((key) =\u003e {\r\n                const value = FBtextValues[langCode][key];\r\n                document.getElementById(key).innerText = [value];\r\n            });\r\n        }\r\n\r\n    })();\r\n\u003c/script\u003e3f:[\"$\",\"$L38\",\"_S_a_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"$L44\",null,{\"content\":\"$45\",\"row_type\":\"custom_element\",\"id\":\"_S_a_\",\"hasMarginal\":\"$undefined\",\"lang\":\"de\",\"headlineOffset\":\"$undefined\"}]}]\n40:[\"$\",\"$L38\",\"_S_b_\",{\"marginalContextValue\":{\"hasMarginal\":false,\"isMarginal\":false},\"children\":[\"$\",\"div\",null,{\"className\":\"container-fluid\",\"children\":[[\"$\",\"$L46\",null,{\"row_headline\":\"Antworten auf häufig gestellte Fragen:\",\"row_type\":\"tiles\",\"tiles\":\"$2a:0:props:rows:7:tiles\",\"id\":\"_S_b_\",\"hasMarginal\":\"$undefined\",\"lang\":\"de\",\"headlineOffset\":\"$undefined\"}],[\"$\",\"section\",null,{\"className\":\"ba-tilerow\",\"children\":[[\"$\",\"div\",\"_S_j_\",{\"className\":\"col-lg-4 col-md-6 col-xs-12\",\"children\":[\"$\",\"section\",null,{\"className\":\"ba-tile ba-link-tile\",\"children\":[null,false,[\"$\",\"h3\",null,{\"className\":\"ba-heading\",\"id\":\"_S_j_\",\"children\":[