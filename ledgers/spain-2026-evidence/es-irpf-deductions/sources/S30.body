                  <input type="radio" name="p" onclick="this.form.submit()" id="lab8620071231" value="20071231"/>
                  <label for="lab8620071231" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 31/12/2007, en vigor a partir del 01/01/2008.</label>
