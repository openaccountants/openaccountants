    <div id="contenedor">
      <div id="contenido" class="poolBdatos">
<h2 class="fuera">Documento BOE-A-2026-2888</h2>
<div class="enlacesDoc" id="barraSep">
  <h3 class="documento-tit">Ley del Principado de Asturias 5/2025, de 31 de diciembre, de Presupuestos Generales para 2026.</h3>
  <div class="metadatosDoc">
    <div class="metadatos">
      <dl>
        <dt>Publicado en:</dt>
        <dd>«<abbr title="Boletín Oficial del Estado">BOE</abbr>» <abbr title="número">núm.</abbr> 35, de 9 de febrero de 2026, páginas 20126 a 20180 (55 <abbr title="páginas">págs.</abbr>)</dd>
        <dt>Sección:</dt>
        <dd>I. Disposiciones generales</dd>
