'script','["function initComboTradV2(id){try{var botonCombo = document.getElementById(id + \'-btn\');if (botonCombo){\\tbotonCombo.click();}var elto = document.getElementById(id + \'-real\');var eltoPP = document.getElementById(id + \'-pp\');if (elto){   if (elto.getAttribute(\'inicializado\') != \'true\'){       elto.setAttribute(\'inicializado\',\'true\');       if (eltoPP){             zAu.send(new zk.Event(zk.$(id),\'onComboAAInit\',{\'datos\': elto.outerHTML , \'combo\' : eltoPP.outerHTML}));       }else{             zAu.send(new zk.Event(zk.$(id),\'onComboAAInit\',{\'datos\': elto.outerHTML}));       }   }}var listaCombo = document.getElementById(id + \'-pp\');if (listaCombo){\\tlistaCombo.style.display = \'none\';}} catch (e) {\\tconsole.log(\\"initComboTradV2: \\",e);}} jq(\\"html\\").attr(\\"lang\\",\\"es\\"); jq.fn.setAdmiteConjuntoCaracteresExtendido(true); llamadaservirITB(); "]',
