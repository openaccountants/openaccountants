		//Esto quita de los checkbox de zk un label vacío. Importante no usar checkbox con un label aparte, usar siempre el atributo label del checkbox Ej : <checkbox id="otrosfines" mold="switch" value="@{motor(value='FINESSOCIALES')}" label="SI"/>
		(function() {
		    // Variable para evitar ejecuciones duplicadas
		    let processing = false;
		    		    
		    // Observador para cambios en el DOM
		    const observer = new MutationObserver(function(mutations) {
		    	try{
			        let shouldProcess = false;
			        
			        mutations.forEach(function(mutation) {
			            if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
			                // Verificar si hay nuevos nodos que contengan checkboxes
			                mutation.addedNodes.forEach(function(node) {
			                    if (node.nodeType === 1) { // Element node
			                        // Verificar si el nodo es un checkbox o contiene checkboxes
			                        if (node.classList && node.classList.contains('z-checkbox')) {
			                            shouldProcess = true;
			                        } else {
			                            // Verificar descendientes
			                            const childCheckboxes = node.querySelectorAll('.z-checkbox');
			                            if (childCheckboxes.length > 0) {
			                                shouldProcess = true;
			                            }
			                        }
			                    }
			                });
			            }
			        });			        			        
		    	 } catch (error) {
			        console.error('Error al procesar observer:', error);
			     }
		    });
		    
		    // Comenzar a observar
		    observer.observe(document.body, {
		        childList: true,
		        subtree: true
		    });
		    //JUAN : lo deshabilito pq tiene efectos secundarios (no se puede hacer click en el check, solo el label) y los check sin label siguen creando una label vacía)
		    //zk.afterLoad('zul.wgt', fixCheckboxZk);
		})();
                 
        function fixCheckboxZk() {
        	console.log('Arreglo accesibilidad checkboxes de zk...');
        	var xCheckbox = {};
            zk.override(zul.wgt.Checkbox.prototype, xCheckbox, {
                redraw: function (out) {
                    var uuid = this.uuid;
                    out.push('<span' + this.domAttrs_({tabindex: 1}) + '>');
                    out.push('<input type="checkbox" id="' + uuid + '-real"' + this.contentAttrs_() + '></input>');
                    out.push('<span id="' + uuid + '-mold" class="' + this.$s('mold') + '" ' + zUtl.encodeXML(this._moldA11yAttrs()) + '></span>');
                    out.push('<label for="' + uuid + '-real" id="' + uuid + '-cnt"' + this.domTextStyleAttr_() + 
                        ' class="' + this.$s('content') + '">');
                    out.push(this.domContent_() + '</label></span>');
                }
            });
        }
        //zk.afterLoad('zul.wgt', fixCheckboxZk);
        
    

