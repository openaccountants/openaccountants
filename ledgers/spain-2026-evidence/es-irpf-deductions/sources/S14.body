	var mapToolTips = new Map();
	
	function addTooltip(clave,cual,valor) {
		mapToolTips.set(clave+cual,valor);
	}
	
	function removeTooltip(clave) {
		for (i = 1;i < 10;i++){
			mapToolTips.delete(clave+i);
		}		
	}
	         
	function showTooltip(event){
		var clave = event.target.uuid;
		if (clave == undefined){
			clave = event.target.id;
		}
		var numAvisos = 0;		
		var mostrar = false;
		for (i = 1;i < 10;i++){
			if (mapToolTips.has(clave+i)){
				jq("#tooltip0" + i).html(mapToolTips.get(clave+i));
				mostrar = true;
				numAvisos = numAvisos + 1;
			}else{
				jq("#tooltip0" + i).html("");
			}
		}
		
		if (mostrar){
			var id = "#" + clave;
			var t = parseInt(jq(id).offset().top);
			var l = parseInt(jq(id).offset().left);
			
			var body = document.body;
			var html = document.documentElement;
			var height = Math.max(body.scrollHeight,body.offsetHeight,html.clientHeight,html.scrollHeight,html.offsetHeight);
			
			//Estimar donde poner el tooltip
			//top, si estoy a media pantalla debajo sino arriba
			if (t > height/2){
				//Ponerlo encima
				t = t - parseInt(jq(id).height()*2)*numAvisos;
			}else{
				//Ponerlo debajo
				t = parseInt(t) + parseInt(jq(id).height()*2);				
			}
			
			jq("#modal-content").show();
			jq("#modal-content").css({
				position : "absolute",
				marginLeft : 0,
				marginTop : 0,
				top : t,
				left : l
			}
			);
		}else{
			jq("#modal-content").hide();
		}
	}
	
	function hideTooltip(){
		jq("#modal-content").hide();
	}
	
	
	

		
