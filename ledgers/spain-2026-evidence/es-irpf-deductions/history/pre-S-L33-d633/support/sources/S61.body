              <fieldset class="gris redondeada">
                <legend class="fuera">Seleccionar redacci&oacute;n:</legend>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2920260430" value="20260430" checked="checked"/>
                  <label for="lab2920260430" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n"><strong>&Uacute;ltima actualizaci&oacute;n, publicada el 30/04/2026, en vigor a partir del 01/05/2026.</strong></label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2920231229" value="20231229"/>
                  <label for="lab2920231229" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 29/12/2023, en vigor a partir del 01/01/2024.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2920221229" value="20221229"/>
                  <label for="lab2920221229" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 29/12/2022, en vigor a partir del 01/01/2023.</label>
