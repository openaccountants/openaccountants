                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2120181228" value="20181228"/>
                  <label for="lab2120181228" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 28/12/2018, en vigor a partir del 01/01/2019.</label>
                </p>
                <p>
                  <input type="radio" name="p" onclick="this.form.submit()" id="lab2120171229" value="20171229"/>
                  <label for="lab2120171229" title="Haga clic o utilice flechas del teclado para cambiar de versi&oacute;n">Modificaci&oacute;n publicada el 29/12/2017, en vigor a partir del 01/01/2018.</label>
