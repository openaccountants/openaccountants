	function fetchLastUpdateDate() {
		const textEl = document.getElementById(ns + 'lastUpdateDateText');
		const dateEl = document.getElementById(ns + 'lasUpdateDateFromPortlet');
		//const loaderEl = document.getElementById(ns + 'loaderSpin');

		//loaderEl.classList.add('loader-spin');

		$.ajax({
			url: 'https://www.navarra.es/es/web/normativa-hacienda/norma-detalle?p_p_id=lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_resource_id=%2Fget%2Flast_update_date&p_p_cacheability=cacheLevelPage&_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3_print=true&_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3__com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_Ki7RJeGE4txt_languageId=eu_ES&_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3__com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_Ki7RJeGE4txt_assetEntryId=56741146&_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3__com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_Ki7RJeGE4txt_type=content&_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3__com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_Ki7RJeGE4txt_mvcPath=%2Fview_content.jsp',
			type: 'GET',
			dataType: 'json',
			success: function(data) {
				if (data.success && data.lastUpdateDate) {
					textEl.innerText = data.lastUpdateString;
					dateEl.innerText = data.lastUpdateDate;
					//console.log('Fecha recibida:', data.lastUpdateDate);
				} else {
					textEl.innerText = '\u00da\u006c\u0074\u0069\u006d\u0061\u0020\u0061\u0063\u0074\u0075\u0061\u006c\u0069\u007a\u0061\u0063\u0069\u00f3\u006e\u003a\u0020\u0031\u0035\u0020\u0064\u0065\u0020\u004a\u0075\u006e\u0069\u006f\u002c\u0020\u0032\u0030\u0031\u0039';
				}
			},
			error: function(xhr, status, error) {
				textEl.innerText = '\u00da\u006c\u0074\u0069\u006d\u0061\u0020\u0061\u0063\u0074\u0075\u0061\u006c\u0069\u007a\u0061\u0063\u0069\u00f3\u006e\u003a\u0020\u0031\u0035\u0020\u0064\u0065\u0020\u004a\u0075\u006e\u0069\u006f\u002c\u0020\u0032\u0030\u0031\u0039';
			},
			complete: function() {
				//loaderEl.classList.remove('loader-spin');
				//loaderEl.classList.add('loader-last-update');
			}
		});
	}

	$(document).ready(function () {
		const isExcludeUrl = false;
		const isTramiteUrl = false;
		const $lastUpdateStringEL = $('#_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3_lastUpdateDateText');
		const $finalEL = $('#_lastPublicationDatev2_INSTANCE_footerlastPublicationDatev3_final');

		if (isTramiteUrl === true) {
		    $finalEL.text('Tramite URL');
